###> symfony/mailer ###
# On Heroku, set MAILER_DSN=postmark+api://YOUR_TOKEN@default
# and MAILER_FROM / MAILER_FROM_NAME via heroku config:set
MAILER_DSN=null://null
MAILER_FROM=hello@cardiganclimbing.org
MAILER_FROM_NAME="Y Wal - Cardigan Climbing"
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# For local development, override JAWSDB_URL in .env.local (gitignored).
# On Heroku, JawsDB sets JAWSDB_URL automatically as a config var.
JAWSDB_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/cardigan_climbing?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/postmark-mailer ###
# MAILER_DSN=postmark://ID@default
###< symfony/postmark-mailer ###

WEBHOOK_SECRET=change-me

###> stripe/stripe-php ###
# On Heroku, set these via heroku config:set (Stripe Dashboard > Developers > API keys / Webhooks).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Reader ID of the single Stripe S700 terminal (Stripe Dashboard > Terminal > Readers).
STRIPE_TERMINAL_READER_ID=
###< stripe/stripe-php ###

###> rollbar/rollbar ###
# On Heroku, the Rollbar add-on sets ROLLBAR_ACCESS_TOKEN automatically.
# Leave empty locally to disable error reporting.
ROLLBAR_ACCESS_TOKEN=
###< rollbar/rollbar ###
