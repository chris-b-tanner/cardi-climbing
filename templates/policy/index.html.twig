{% extends 'base.html.twig' %}

{% block title %}Policies — Y Wal{% endblock %}
{% block og_title %}Policies — Y Wal{% endblock %}

{% block content %}
<section class="section page-hero">
  <div class="wrap">
    <h1 class="page-hero__h1">Policies</h1>
  </div>
</section>

<section class="section section--off">
  <div class="wrap">
    <div class="involved__ways">
      <a class="way policy__link" href="{{ path('app_policy_privacy') }}">
        <h3>Privacy &amp; GDPR Policy</h3>
        <p>What personal information we collect, how we use it, cookies, and your data protection rights.</p>
      </a>
      <a class="way policy__link" href="{{ path('app_policy_safeguarding') }}">
        <h3>Safeguarding Policy</h3>
        <p>How we keep children and adults at risk safe, and who to contact if you have a concern.</p>
      </a>
      <a class="way policy__link" href="{{ path('app_policy_social_media') }}">
        <h3>Social Media Policy</h3>
        <p>How Y Wal, our staff and volunteers use social media, including photos and posting on our behalf.</p>
      </a>
      <a class="way policy__link" href="{{ path('app_policy_complaints') }}">
        <h3>Complaints and Whistleblowing Policy</h3>
        <p>How to raise a complaint or report a concern about wrongdoing, and how we'll handle it.</p>
      </a>
      <a class="way policy__link" href="{{ path('app_policy_environmental') }}">
        <h3>Environmental Policy</h3>
        <p>How we're working to reduce Y Wal's environmental impact.</p>
      </a>
      <a class="way policy__link" href="{{ path('app_policy_bilingual') }}">
        <h3>Bilingual Service and Communications Policy</h3>
        <p>How we provide our services and communications in Welsh and English.</p>
      </a>
      <a class="way policy__link" href="{{ path('app_policy_governance') }}">
        <h3>Governance Statement</h3>
        <p>How Y Wal is run, who's responsible for decisions, and how we stay accountable.</p>
      </a>
      <a class="way policy__link" href="{{ path('app_policy_volunteer') }}">
        <h3>Volunteer Engagement Guidelines</h3>
        <p>How we recruit, support and work with the volunteers who help run Y Wal.</p>
      </a>
    </div>
  </div>
</section>
{% endblock %}
