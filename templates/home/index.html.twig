{% extends 'base.html.twig' %}

{% block content %}
{% set subSuccess = app.flashes('subscribe_success') %}
{% set subError   = app.flashes('subscribe_error') %}

{# ── Hero ──────────────────────────────────────────────── #}
<section class="hero" id="home">
  <div class="wrap">
    <p class="hero__label">{{ 'hero_label'|trans }}</p>
    <h1>{{ 'hero_h1'|trans|raw }}</h1>
    <p class="hero__sub">{{ 'hero_sub'|trans }}</p>
    <div class="hero__actions">
      <a href="#involved" class="btn btn--teal">{{ 'hero_cta_primary'|trans }}</a>
      <a href="#mission"  class="btn btn--outline">{{ 'hero_cta_secondary'|trans }}</a>
    </div>
    <div class="hero__signup">
      <p class="hero__signup-label">Sign up for emails</p>
      {% if subSuccess %}
        <p class="subscribe-form__msg subscribe-form__msg--success">{{ subSuccess|first }}</p>
      {% elseif subError %}
        <p class="subscribe-form__msg subscribe-form__msg--error">{{ subError|first }}</p>
      {% else %}
        <form method="post" action="{{ path('app_subscribe') }}" class="subscribe-form" novalidate>
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('subscribe') }}">
          <div class="subscribe-form__fields">
            <input type="text"  name="firstName" class="subscribe-form__input" placeholder="First name">
            <input type="text"  name="lastName"  class="subscribe-form__input" placeholder="Last name">
            <input type="email" name="email"     class="subscribe-form__input" placeholder="Email address" required>
          </div>
          <button type="submit" class="btn btn--teal">Stay in the loop</button>
        </form>
      {% endif %}
    </div>
  </div>
</section>

<div class="img-cgi img-cgi--full">
  <img
    src="/images/Y-Wal-outside.jpg"
    alt="{{ 'img_alt_exterior'|trans }}"
    class="hero-photo"
  >
</div>

{# ── Stats ─────────────────────────────────────────────── #}
<div class="stats">
  <div class="wrap">
    <div class="stats__grid">
      <div class="stats__item"><strong>1st</strong><span>{{ 'stat_1_label'|trans }}</span></div>
      <div class="stats__item"><strong>50+</strong><span>{{ 'stat_2_label'|trans }}</span></div>
      <div class="stats__item"><strong>10,000+</strong><span>{{ 'stat_3_label'|trans }}</span></div>
      <div class="stats__item"><strong>3</strong><span>{{ 'stat_4_label'|trans }}</span></div>
    </div>
  </div>
</div>

{# ── Mission ───────────────────────────────────────────── #}
<section class="section" id="mission">
  <div class="wrap">
    <div class="mission__grid">
      <div class="mission__text">
        <h2>{{ 'mission_h2'|trans }}</h2>
        <p>{{ 'mission_p1'|trans }}</p>
        <p>{{ 'mission_p2'|trans }}</p>
        <p>{{ 'mission_p3'|trans }}</p>
        <div class="mission__pillars">
          <div class="pillar">
            <h3>{{ 'pillar_1_title'|trans }}</h3>
            <p>{{ 'pillar_1_body'|trans }}</p>
          </div>
          <div class="pillar">
            <h3>{{ 'pillar_2_title'|trans }}</h3>
            <p>{{ 'pillar_2_body'|trans }}</p>
          </div>
          <div class="pillar">
            <h3>{{ 'pillar_3_title'|trans }}</h3>
            <p>{{ 'pillar_3_body'|trans }}</p>
          </div>
          <div class="pillar">
            <h3>{{ 'pillar_4_title'|trans }}</h3>
            <p>{{ 'pillar_4_body'|trans }}</p>
          </div>
        </div>
        <a href="#plan" class="btn btn--teal" style="margin-top:1.5rem;">{{ 'mission_cta'|trans }}</a>
      </div>
      <div class="img-cgi">
        <img
          src="/images/Y-Wal-bouldering.jpg"
          alt="{{ 'img_alt_bouldering'|trans }}"
          class="mission__photo"
        >
      </div>
    </div>
  </div>
</section>

{# ── Plan ──────────────────────────────────────────────── #}
<section class="section section--off" id="plan">
  <div class="wrap">
    <div class="plan__intro">
      <h2>{{ 'plan_h2'|trans|raw }}</h2>
      <p>{{ 'plan_intro'|trans }}</p>
    </div>
    <div class="plan__steps">
      <div class="step">
        <p class="step__num">{{ 'phase_label'|trans }} 01</p>
        <h3>{{ 'phase_1_title'|trans }}</h3>
        <p>{{ 'phase_1_body'|trans|raw }}</p>
      </div>
      <div class="step">
        <p class="step__num">{{ 'phase_label'|trans }} 02</p>
        <h3>{{ 'phase_2_title'|trans }}</h3>
        <p>{{ 'phase_2_body'|trans|raw }}</p>
      </div>
      <div class="step">
        <p class="step__num">{{ 'phase_label'|trans }} 03</p>
        <h3>{{ 'phase_3_title'|trans }}</h3>
        <p>{{ 'phase_3_body'|trans }}</p>
      </div>
      <div class="step">
        <p class="step__num">{{ 'phase_label'|trans }} 04</p>
        <h3>{{ 'phase_4_title'|trans }}</h3>
        <p>{{ 'phase_4_body'|trans }}</p>
      </div>
    </div>
    <div class="plan__features-wrap">
      <div class="img-cgi img-cgi--stretch">
        <img
          src="/images/Y-Wal-ropes.jpg"
          alt="{{ 'img_alt_centre'|trans }}"
          class="plan__features-photo"
        >
      </div>
      <div class="plan__features">
        <h3>{{ 'features_title'|trans }}</h3>
        <ul class="feature-list">
          <li>{{ 'feature_1'|trans }}</li>
          <li>{{ 'feature_2'|trans }}</li>
          <li>{{ 'feature_3'|trans }}</li>
          <li>{{ 'feature_4'|trans }}</li>
          <li>{{ 'feature_5'|trans }}</li>
          <li>{{ 'feature_6'|trans }}</li>
          <li>{{ 'feature_7'|trans }}</li>
          <li>{{ 'feature_8'|trans }}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

{# ── Adventure Hub ─────────────────────────────────────── #}
<section class="section section--off" id="adventures">
  <div class="wrap">
    <h2>{{ 'adv_h2'|trans }}</h2>
    <p class="adv__intro">{{ 'adv_intro'|trans }}</p>

    <h3>{{ 'adv_guided_title'|trans }}</h3>
    <div class="adv__grid">
      <div class="adv__card">
        <h3>{{ 'adv_1_title'|trans }}</h3>
        <p>{{ 'adv_1_body'|trans }}</p>
      </div>
      <div class="adv__card">
        <h3>{{ 'adv_2_title'|trans }}</h3>
        <p>{{ 'adv_2_body'|trans }}</p>
      </div>
      <div class="adv__card">
        <h3>{{ 'adv_3_title'|trans }}</h3>
        <p>{{ 'adv_3_body'|trans }}</p>
      </div>
    </div>

    <div class="adv__partners">
      <h3>{{ 'adv_partners_title'|trans }}</h3>
      <p class="adv__partners-intro">{{ 'adv_partners_intro'|trans }}</p>
      <ul class="adv__partner-list">
        <li>
          <a href="https://adventurebeyond.co.uk/" target="_blank" rel="noopener" class="adv__partner-link">
            <img src="/images/partners/adventure_beyond.png" alt="" class="adv__partner-logo">
            <span>Adventure Beyond</span>
          </a>
        </li>
        <li>
          <a href="https://heritagecanoes.squarespace.com/" target="_blank" rel="noopener" class="adv__partner-link">
            <img src="/images/partners/fforest.png" alt="" class="adv__partner-logo">
            <span>Heritage Canoes</span>
          </a>
        </li>
        <li>
          <a href="https://www.anturio.wales/" target="_blank" rel="noopener" class="adv__partner-link">
            <img src="/images/partners/anturio.png" alt="" class="adv__partner-logo">
            <span>Anturio</span>
          </a>
        </li>
        <li>
          <a href="https://www.baytoremember.co.uk/" target="_blank" rel="noopener" class="adv__partner-link">
            <img src="/images/partners/btr.png" alt="" class="adv__partner-logo">
            <span>Bay to Remember</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="adv__cta-block">
      <p>{{ 'adv_cta'|trans }}</p>
      <a href="mailto:cardiganclimbing@gmail.com" class="btn btn--teal">{{ 'adv_cta_btn'|trans }}</a>
    </div>
  </div>
</section>

{# ── Get Involved ──────────────────────────────────────── #}
<section class="section" id="involved">
  <div class="wrap">
    <h2>{{ 'involved_h2'|trans }}</h2>
    <div class="involved__ways">
      <div class="way">
        <h3>{{ 'way_1_title'|trans }}</h3>
        <p>{{ 'way_1_body'|trans }}</p>
        <a href="{{ path('app_roles') }}" class="btn btn--teal btn--sm" style="margin-top:0.75rem;">{{ 'news_read_more'|trans }}</a>
      </div>
      <div class="way">
        <h3>{{ 'way_2_title'|trans }}</h3>
        <p>{{ 'way_2_body'|trans }}</p>
      </div>
      <div class="way">
        <h3>{{ 'way_3_title'|trans }}</h3>
        <p>{{ 'way_3_body'|trans }}</p>
      </div>
    </div>
  </div>
</section>

{# ── Partners ──────────────────────────────────────────── #}
<section class="section partners" id="partners">
  <div class="wrap">
    <h2 class="partners__heading">{{ 'partners_h2'|trans }}</h2>
    <div class="partners__logos">
      <a href="https://www.cardibuildingsupplies.com/" target="_blank" rel="noopener" class="partners__logo">
        <img src="/images/partners/cardi.png" alt="Cardi Building Supplies">
      </a>
      <a href="https://adventurebeyond.co.uk/" target="_blank" rel="noopener" class="partners__logo">
        <img src="/images/partners/adventure_beyond.png" alt="Adventure Beyond">
      </a>
      <a href="https://www.anturio.wales/" target="_blank" rel="noopener" class="partners__logo">
        <img src="/images/partners/anturio.png" alt="Anturio">
      </a>
      <a href="https://heritagecanoes.squarespace.com/" target="_blank" rel="noopener" class="partners__logo">
        <img src="/images/partners/fforest.png" alt="fforest">
      </a>
      <a href="https://www.baytoremember.co.uk/" target="_blank" rel="noopener" class="partners__logo">
        <img src="/images/partners/btr.png" alt="Bay to Remember">
      </a>
    </div>
  </div>
</section>

{# ── Signup ────────────────────────────────────────────── #}
<div class="signup">
  <div class="wrap">
    <div class="signup__copy">
      <h2>{{ 'signup_h2'|trans }}</h2>
      <p>{{ 'signup_body'|trans }}</p>
    </div>
    <div class="signup__form">
      {% if subSuccess %}
        <p class="subscribe-form__msg subscribe-form__msg--success">{{ subSuccess|first }}</p>
      {% elseif subError %}
        <p class="subscribe-form__msg subscribe-form__msg--error">{{ subError|first }}</p>
      {% else %}
        <p style="font-family:var(--f-head);font-size:1.4rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:var(--white);margin-bottom:1.25rem;">Sign up for emails</p>
        <form method="post" action="{{ path('app_subscribe') }}" class="subscribe-form" novalidate>
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('subscribe') }}">
          <div class="subscribe-form__fields">
            <input type="text"  name="firstName" class="subscribe-form__input" placeholder="First name">
            <input type="text"  name="lastName"  class="subscribe-form__input" placeholder="Last name">
            <input type="email" name="email"     class="subscribe-form__input" placeholder="Email address" required>
          </div>
          <button type="submit" class="btn btn--teal">Stay in the loop</button>
        </form>
      {% endif %}
    </div>
  </div>
</div>

{% endblock %}
