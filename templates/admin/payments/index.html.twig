{% extends 'admin/base.html.twig' %}
{% block title %}Payments{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Payments</h1>
  <a href="#" id="export-link" class="btn btn--ghost btn--sm">Export CSV</a>
</div>

<div class="filter-form">
  <input type="search" id="search-q" placeholder="Search name, email or transaction ID…"
         value="{{ currentQuery }}" aria-label="Search payments" autocomplete="off">
  <input type="date" id="search-from" value="{{ currentFrom }}" aria-label="From date">
  <input type="date" id="search-to" value="{{ currentTo }}" aria-label="To date">
</div>

<div id="results">
  {% include 'admin/payments/_list.html.twig' %}
</div>
{% endblock %}

{% block scripts %}
<script>
  const searchInput = document.getElementById('search-q');
  const fromInput   = document.getElementById('search-from');
  const toInput     = document.getElementById('search-to');
  const results     = document.getElementById('results');
  const exportLink  = document.getElementById('export-link');
  const endpoint    = '{{ path('app_admin_payments') }}';
  const exportUrl   = '{{ path('app_admin_payments_export') }}';
  let debounce;

  function currentParams() {
    const params = new URLSearchParams();
    if (searchInput.value) params.set('q', searchInput.value);
    if (fromInput.value)   params.set('from', fromInput.value);
    if (toInput.value)     params.set('to', toInput.value);
    return params;
  }

  function updateExportLink() {
    const qs = currentParams().toString();
    exportLink.href = qs ? `${exportUrl}?${qs}` : exportUrl;
  }

  function fetchResults() {
    const qs = currentParams().toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
    updateExportLink();

    fetch(`${endpoint}${qs ? '?' + qs : ''}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
      .then(r => r.text())
      .then(html => { results.innerHTML = html; });
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(fetchResults, 300);
  });
  fromInput.addEventListener('change', fetchResults);
  toInput.addEventListener('change', fetchResults);

  updateExportLink();
</script>
{% endblock %}
