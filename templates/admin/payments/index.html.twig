{% extends 'admin/base.html.twig' %}
{% block title %}Payments{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Payments</h1>
  <a href="#" id="export-link" class="btn btn--ghost btn--sm">Export CSV</a>
</div>

<div class="filter-form">
  <input type="search" id="search-q" placeholder="Search…" style="flex:0 0 11rem;"
         value="{{ currentQuery }}" aria-label="Search payments" autocomplete="off">
  <select id="search-status" aria-label="Filter by status">
    <option value="">All statuses</option>
    <option value="pending"{{ currentStatus == 'pending' ? ' selected' : '' }}>Pending</option>
    <option value="succeeded"{{ currentStatus == 'succeeded' ? ' selected' : '' }}>Succeeded</option>
    <option value="failed"{{ currentStatus == 'failed' ? ' selected' : '' }}>Failed</option>
    <option value="partially_refunded"{{ currentStatus == 'partially_refunded' ? ' selected' : '' }}>Partially refunded</option>
    <option value="refunded"{{ currentStatus == 'refunded' ? ' selected' : '' }}>Refunded</option>
  </select>
  <select id="search-method" aria-label="Filter by method">
    <option value="">All methods</option>
    <option value="online"{{ currentMethod == 'online' ? ' selected' : '' }}>Online</option>
    <option value="terminal"{{ currentMethod == 'terminal' ? ' selected' : '' }}>Terminal</option>
    <option value="cash"{{ currentMethod == 'cash' ? ' selected' : '' }}>Cash</option>
  </select>
  <input type="date" id="search-from" value="{{ currentFrom }}" aria-label="From date">
  <input type="date" id="search-to" value="{{ currentTo }}" aria-label="To date">
</div>

<div id="results">
  {% include 'admin/payments/_list.html.twig' %}
</div>
{% endblock %}

{% block scripts %}
<script>
  const searchInput = document.getElementById('search-q');
  const statusInput = document.getElementById('search-status');
  const methodInput = document.getElementById('search-method');
  const fromInput   = document.getElementById('search-from');
  const toInput     = document.getElementById('search-to');
  const results     = document.getElementById('results');
  const exportLink  = document.getElementById('export-link');
  const endpoint    = '{{ path('app_admin_payments') }}';
  const exportUrl   = '{{ path('app_admin_payments_export') }}';
  let debounce;

  function currentParams() {
    const params = new URLSearchParams();
    if (searchInput.value) params.set('q', searchInput.value);
    if (statusInput.value) params.set('status', statusInput.value);
    if (methodInput.value) params.set('method', methodInput.value);
    if (fromInput.value)   params.set('from', fromInput.value);
    if (toInput.value)     params.set('to', toInput.value);
    return params;
  }

  function updateExportLink() {
    const qs = currentParams().toString();
    exportLink.href = qs ? `${exportUrl}?${qs}` : exportUrl;
  }

  function fetchResults() {
    const qs = currentParams().toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
    updateExportLink();

    fetch(`${endpoint}${qs ? '?' + qs : ''}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
      .then(r => r.text())
      .then(html => { results.innerHTML = html; });
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(fetchResults, 300);
  });
  statusInput.addEventListener('change', fetchResults);
  methodInput.addEventListener('change', fetchResults);
  fromInput.addEventListener('change', fetchResults);
  toInput.addEventListener('change', fetchResults);

  updateExportLink();
</script>
{% endblock %}
