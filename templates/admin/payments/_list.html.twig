<div class="result-count">{{ payments|length }} {{ payments|length == 1 ? 'payment' : 'payments' }}</div>

{% if payments is empty %}
  <div class="empty">
    <strong>No payments found</strong>
    Try adjusting your search or date range.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Member</th>
          <th>Type</th>
          <th>Method</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Transaction ID</th>
        </tr>
      </thead>
      <tbody>
        {% for payment in payments %}
          {% set displayName = (payment.user.firstName ~ ' ' ~ payment.user.lastName)|trim %}
          {% set pillClass = payment.status == 'succeeded' ? ' status-pill--published' : (payment.status == 'failed' ? ' status-pill--cancelled' : (payment.status in ['refunded', 'partially_refunded'] ? ' status-pill--pending' : '')) %}
          <tr>
            <td class="admin-table__muted">{{ payment.createdAt|date('d M Y, H:i') }}</td>
            <td>
              <a href="{{ path('app_admin_user_show', {id: payment.user.id}) }}" class="admin-table__link">
                {{ displayName ?: payment.user.email }}
              </a>
            </td>
            <td class="admin-table__muted">{{ payment.isDonation ? 'Donation' : 'Booking' }}</td>
            <td class="admin-table__muted">{{ payment.method|capitalize }}</td>
            <td class="admin-table__muted">£{{ payment.amount }}</td>
            <td><span class="status-pill{{ pillClass }}">{{ payment.statusLabel }}</span></td>
            <td class="admin-table__muted" style="font-size:0.78rem;">{{ payment.stripePaymentIntentId ?: '—' }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
