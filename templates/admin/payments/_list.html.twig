<div class="result-count">{{ payments|length }} {{ payments|length == 1 ? 'payment' : 'payments' }}</div>

{% if payments is empty %}
  <div class="empty">
    <strong>No payments found</strong>
    Try adjusting your search or date range.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Member</th>
          <th>Type</th>
          <th>Method</th>
          <th style="text-align:right;">Amount</th>
          <th>Status</th>
          <th>Transaction ID</th>
          {% if is_granted('ROLE_ADMIN') %}<th></th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for payment in payments %}
          {% set displayName = payment.user.displayName %}
          {% set pillClass = payment.status == 'succeeded' ? ' status-pill--published' : (payment.status == 'failed' ? ' status-pill--cancelled' : (payment.status in ['refunded', 'partially_refunded'] ? ' status-pill--pending' : '')) %}
          <tr>
            <td class="admin-table__muted">{{ payment.createdAt|date('d M Y, H:i') }}</td>
            <td>
              <a href="{{ path('app_admin_user_show', {id: payment.user.id}) }}" class="admin-table__link">
                {{ displayName ?: payment.user.email }}
              </a>
            </td>
            <td class="admin-table__muted">
              {% if payment.order %}
                <a href="{{ path('app_admin_sale_show', {id: payment.order.id}) }}" class="admin-table__link">Sale #{{ payment.order.id }}</a>
              {% elseif payment.attendee %}
                Booking
              {% else %}
                Donation
              {% endif %}
            </td>
            <td class="admin-table__muted">{{ payment.method|capitalize }}</td>
            <td class="admin-table__muted" style="text-align:right;">£{{ payment.amount }}</td>
            <td><span class="status-pill{{ pillClass }}">{{ payment.statusLabel }}</span></td>
            <td class="admin-table__muted" style="font-size:0.78rem;">{{ payment.stripePaymentIntentId ?: '—' }}</td>
            {% if is_granted('ROLE_ADMIN') %}
              <td>
                {% if payment.status != 'succeeded' %}
                  <form method="post" action="{{ path('app_admin_payment_delete', {id: payment.id}) }}"
                        onsubmit="return confirm('Delete this payment record? This can\'t be undone.');">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_payment_delete_' ~ payment.id) }}">
                    <button type="submit" class="btn btn--ghost btn--sm" title="Delete payment" aria-label="Delete payment" style="color:var(--red);border-color:var(--red);padding:0.35rem 0.5rem;line-height:1;">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                {% endif %}
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" style="text-align:right;font-weight:600;border-top:2px solid var(--border);border-bottom:none;">Total</td>
          <td style="text-align:right;font-weight:600;border-top:2px solid var(--border);border-bottom:none;">£{{ total }}</td>
          <td colspan="{{ is_granted('ROLE_ADMIN') ? 3 : 2 }}" style="border-top:2px solid var(--border);border-bottom:none;"></td>
        </tr>
      </tfoot>
    </table>
  </div>
{% endif %}
