{% extends 'admin/base.html.twig' %}
{% block title %}News{% endblock %}

{% block content %}
<div class="page-header">
  <h1>News</h1>
  <a href="{{ path('app_admin_news_new') }}" class="btn btn--teal btn--sm">+ New post</a>
</div>

{% if posts is empty %}
  <div class="empty">
    <strong>No news posts yet</strong>
    Create your first community update.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Published</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for post in posts %}
          <tr>
            <td>
              <a href="{{ path('app_admin_news_edit', {id: post.id}) }}" class="admin-table__link">{{ post.title }}</a>
            </td>
            <td class="admin-table__muted">{{ post.isPublished ? post.publishedAt|date('d M Y') : '—' }}</td>
            <td>
              <span class="status-pill{{ post.isPublished ? ' status-pill--published' : '' }}">
                {{ post.isPublished ? 'Published' : 'Draft' }}
              </span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
