{% extends 'admin/base.html.twig' %}
{% block title %}Edit news post{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Edit news post</h1>
  <div class="btn-row">
    {% if post.isPublished %}
      <a href="{{ path('app_news_show', {slug: post.slug}) }}" target="_blank" class="btn btn--ghost btn--sm">View live ↗</a>
    {% endif %}
    <a href="{{ path('app_admin_news') }}" class="btn btn--ghost btn--sm">← Cancel</a>
  </div>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_news_edit', {id: post.id}) }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_news_edit_' ~ post.id) }}">

  <div class="card">
    <div class="form-group">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" class="form-control"
             value="{{ post.title }}" autocomplete="off" required>
    </div>
    <div class="form-group">
      <label for="slug">URL slug</label>
      <input type="text" id="slug" name="slug" class="form-control"
             value="{{ post.slug }}" autocomplete="off">
    </div>
    <div class="form-group" style="margin-bottom:0;">
      <label for="body">Body</label>
      <textarea id="body" name="body" class="form-control" rows="16"
                required style="resize:vertical;font-family:inherit;line-height:1.7;">{{ post.body }}</textarea>
    </div>
  </div>

  <div class="card">
    <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.9rem;">
      <input type="checkbox" name="published" value="1" style="width:1.1rem;height:1.1rem;accent-color:var(--teal);"
             {% if post.isPublished %}checked{% endif %}>
      Published
    </label>
    <p style="font-size:0.78rem;color:var(--muted);margin-top:0.4rem;">
      Uncheck to unpublish and hide this post from the public news page.
    </p>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Save changes</button>
    <a href="{{ path('app_admin_news') }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>

<form method="post" action="{{ path('app_admin_news_delete', {id: post.id}) }}"
      onsubmit="return confirm('Delete this news post? This cannot be undone.');" style="margin-top:1rem;">
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_news_' ~ post.id) }}">
  <button type="submit" class="btn btn--danger btn--sm">Delete post</button>
</form>
{% endblock %}
