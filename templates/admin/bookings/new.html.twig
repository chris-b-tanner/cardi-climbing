{% extends 'admin/base.html.twig' %}
{% set memberName = selectedMember.displayName %}
{% block title %}Check in : {{ memberName }}{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Check in / new booking : {{ memberName }}</h1>
  <a href="{{ path('app_admin_user_show', {id: selectedMember.id}) }}" class="btn btn--ghost btn--sm">← Cancel</a>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

{% set activeMembership = selectedMember.effectiveMembership and selectedMember.effectiveMembership.currentlyActive ? selectedMember.effectiveMembership : null %}
{% if activeMembership %}
  <div class="flash flash--info">
    {{ memberName }} has an active <strong>{{ activeMembership.membershipType.name }}</strong> membership — check-ins onto restricted events are covered, no credit needed.
  </div>
{% elseif selectedMember.creditBalance > 0 %}
  <div class="flash flash--info">
    {{ memberName }} has no active membership — checking them into a restricted event will use 1 of their {{ selectedMember.creditBalance }} remaining credit{{ selectedMember.creditBalance == 1 ? '' : 's' }}.
  </div>
{% else %}
  <div class="flash flash--info">
    {{ memberName }} has no active membership and no drop-in credits — they can only be checked into events with no certification restriction, or sold a ticket or credit first.
  </div>
{% endif %}

<form method="post" action="{{ path('app_admin_booking_new') }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_new') }}">
  <input type="hidden" id="eventId" name="eventId" value="{{ selectedEventId ?: '' }}">
  <input type="hidden" id="occurrenceDate" name="occurrenceDate" value="{{ app.request.request.get('occurrenceDate') ?: '' }}">
  <input type="hidden" name="userId" value="{{ selectedMember.id }}">

  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem;">
      <div class="card__label" style="margin-bottom:0;">
        {{ weekStart|date('d M') }}&ndash;{{ weekEnd|date('d M Y') }}
      </div>
      <div class="btn-row">
        <a href="{{ path('app_admin_booking_new', {userId: selectedMember.id, date: prevWeek}) }}" class="btn btn--ghost btn--sm">&lsaquo; Previous week</a>
        <a href="{{ path('app_admin_booking_new', {userId: selectedMember.id, date: nextWeek}) }}" class="btn btn--ghost btn--sm">Next week &rsaquo;</a>
      </div>
    </div>
    <div class="checkin-week-grid">
      {% for day in days %}
        {% set isToday = day.date|date('Y-m-d') == today|date('Y-m-d') %}
        <div class="checkin-day{{ isToday ? ' checkin-day--today' : '' }}">
          <div class="checkin-day__header">
            {{ day.date|date('D') }}<br><strong>{{ day.date|date('j M') }}</strong>
          </div>
          {% if day.events is empty %}
            <p class="checkin-empty">No events</p>
          {% else %}
            {% for occ in day.events %}
              <button type="button" class="checkin-event{{ (occ.isFull or occ.bookedByUser or occ.accessMessage) ? ' is-disabled' : '' }}{{ occ.isRestricted ? ' checkin-event--restricted' : '' }}"
                      data-event-id="{{ occ.event.id }}"
                      data-occurrence-date="{{ occ.date|date('Y-m-d') }}"
                      data-checkin-window="{{ occ.isCheckInWindow ? '1' : '0' }}"
                      {% if occ.isFull or occ.bookedByUser or occ.isRestricted or occ.accessMessage %}disabled{% endif %}>
                <div class="checkin-event__time">{{ occ.event.timeFrom }}&ndash;{{ occ.event.timeTo }}</div>
                <div class="checkin-event__title">{{ occ.event.title }}</div>
                {% if occ.bookedByUser %}
                  <div class="checkin-event__meta">Already booked</div>
                {% elseif occ.isRestricted %}
                  {% for certification in occ.event.restrictions %}
                    <div class="checkin-event__cert"><i class="bi bi-shield-check"></i> {{ certification.name }}</div>
                  {% endfor %}
                {% elseif occ.accessMessage %}
                  <div class="checkin-event__meta">{{ occ.accessMessage }}</div>
                {% elseif occ.isFull %}
                  <div class="checkin-event__meta">Full</div>
                {% elseif occ.spotsLeft is not null %}
                  <div class="checkin-event__meta">{{ occ.spotsLeft }} left</div>
                {% endif %}
              </button>
            {% endfor %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="card">
    <div class="form-group" style="margin-bottom:0;">
      <label for="status">Status</label>
      <select id="status" name="status" class="form-control">
        <option value="confirmed">Confirmed</option>
        <option value="pending">Pending</option>
      </select>
    </div>
  </div>

  <div class="card">
    <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.9rem;">
      <input type="checkbox" name="sendEmail" value="1" checked
             style="width:1.1rem;height:1.1rem;accent-color:var(--teal);">
      Send booking confirmation email
    </label>
  </div>

  <div class="form-actions">
    <button type="submit" id="checkinSubmit" class="btn btn--teal" disabled>Select an event</button>
    <a href="{{ path('app_admin_user_show', {id: selectedMember.id}) }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>
{% endblock %}

{% block scripts %}
<style>
  .checkin-week-grid {
    display: grid; grid-template-columns: repeat(7, minmax(130px, 1fr));
    gap: 0.6rem; overflow-x: auto;
  }
  .checkin-day {
    border: 1px solid var(--border); border-radius: var(--radius);
    padding: 0.6rem; background: var(--white); min-width: 0;
  }
  .checkin-day--today { border-color: var(--teal); }
  .checkin-day__header {
    text-align: center; font-size: 0.72rem; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.6rem;
  }
  .checkin-day__header strong { font-size: 0.95rem; color: var(--black); text-transform: none; letter-spacing: 0; }
  .checkin-event {
    display: block; width: 100%; text-align: left; font-family: inherit;
    background: var(--white); border: 1px solid var(--border); border-radius: 6px;
    padding: 0.5rem 0.6rem; margin-bottom: 0.4rem; cursor: pointer;
    transition: border-color 0.12s, background 0.12s;
  }
  .checkin-event:hover:not(:disabled) { border-color: var(--teal); background: #f0fdfa; }
  .checkin-event.is-selected { border-color: var(--teal); background: #f0fdfa; box-shadow: 0 0 0 1px var(--teal); }
  .checkin-event:disabled, .checkin-event.is-disabled { opacity: 0.4; cursor: default; }
  .checkin-event--restricted { background: #fefce8; border-color: #fde047; }
  .checkin-event--restricted:disabled, .checkin-event--restricted.is-disabled { opacity: 1; }
  .checkin-event--restricted .checkin-event__meta { color: #854d0e; font-weight: 600; }
  .checkin-event__time { font-size: 0.7rem; color: var(--muted); }
  .checkin-event__title { font-size: 0.82rem; font-weight: 600; color: var(--black); }
  .checkin-event__meta { font-size: 0.7rem; color: var(--muted); margin-top: 0.1rem; }
  .checkin-event__cert { font-size: 0.7rem; color: #854d0e; font-weight: 600; margin-top: 0.15rem; display: flex; align-items: center; gap: 0.3rem; }
  .checkin-empty { font-size: 0.75rem; color: var(--muted); text-align: center; padding: 0.5rem 0; }

  @media (max-width: 860px) {
    .checkin-week-grid { grid-template-columns: repeat(7, minmax(150px, 1fr)); }
  }
</style>
<script>
  const eventIdInput        = document.getElementById('eventId');
  const occurrenceDateInput = document.getElementById('occurrenceDate');
  const eventButtons        = document.querySelectorAll('.checkin-event');
  const checkinSubmit       = document.getElementById('checkinSubmit');

  function updateSubmitLabel(btn) {
    checkinSubmit.disabled = false;
    checkinSubmit.textContent = btn.dataset.checkinWindow === '1' ? 'Check in now' : 'Book future event';
  }

  eventButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      eventButtons.forEach(b => b.classList.toggle('is-selected', b === btn));
      eventIdInput.value = btn.dataset.eventId;
      occurrenceDateInput.value = btn.dataset.occurrenceDate;
      updateSubmitLabel(btn);
    });
  });

  // Re-highlight the previous selection after a validation error sends us back to this page.
  if (eventIdInput.value && occurrenceDateInput.value) {
    const selector = `.checkin-event[data-event-id="${eventIdInput.value}"][data-occurrence-date="${occurrenceDateInput.value}"]`;
    const preselected = document.querySelector(selector);
    if (preselected) {
      preselected.classList.add('is-selected');
      updateSubmitLabel(preselected);
    }
  }
</script>
{% endblock %}
