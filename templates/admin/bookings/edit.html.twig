{% extends 'admin/base.html.twig' %}
{% block title %}Edit booking{% endblock %}

{% set displayName = attendee.user.displayName %}
{% set backLabel = returnTo starts with '/admin/events/' ? '← Back to event' : '← Back to member' %}

{% block content %}
<div class="page-header">
  <h1>Edit booking</h1>
  <a href="{{ returnTo }}" class="btn btn--ghost btn--sm">{{ backLabel }}</a>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_booking_edit', {id: attendee.id}) }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_edit_' ~ attendee.id) }}">
  <input type="hidden" name="returnTo" value="{{ returnTo }}">

  <div class="card">
    <div class="detail-grid">
      <div>
        <div class="card__label">Member</div>
        <div class="card__value">{{ displayName ?: attendee.user.email }}</div>
      </div>
      <div>
        <div class="card__label">Event</div>
        <div class="card__value">{{ attendee.event.title }}</div>
      </div>
      <div>
        <div class="card__label">Date</div>
        <div class="card__value">{{ (attendee.occurrenceDate ?? attendee.event.date)|date('d M Y') }}</div>
      </div>
      <div>
        <div class="card__label">Booked</div>
        <div class="card__value">{{ attendee.createdAt|date('d M Y, H:i') }}</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="detail-grid">
      <div class="form-group" style="margin-bottom:0;">
        <label for="status">Status</label>
        <select id="status" name="status" class="form-control">
          <option value="confirmed" {{ attendee.status == 'confirmed' ? 'selected' : '' }}>Confirmed</option>
          <option value="pending" {{ attendee.status == 'pending' ? 'selected' : '' }}>Pending</option>
          <option value="waiting" {{ attendee.status == 'waiting' ? 'selected' : '' }}>Waiting</option>
          <option value="cancelled" {{ attendee.status == 'cancelled' ? 'selected' : '' }}>Cancelled</option>
        </select>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Save changes</button>
    <a href="{{ returnTo }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>

{% if attendee.event.isSelfAccess %}
  <div class="card" style="margin-top:1.5rem;">
    <div class="card__label" style="margin-bottom:0.75rem;">Door access</div>
    <div class="detail-grid">
      <div>
        <div class="card__label">PIN</div>
        <div class="card__value" id="door-access-pin" style="font-family:monospace;font-size:1.1rem;">{{ attendee.pin ?: '—' }}</div>
      </div>
      <div>
        <div class="card__label">PIN status</div>
        <div class="card__value" id="door-access-pin-status">{{ attendee.pinStatus ? attendee.pinStatus|capitalize : '—' }}</div>
      </div>
      {% if validFrom and validUntil %}
        <div>
          <div class="card__label">Valid</div>
          <div class="card__value">{{ validFrom|date('d M Y, H:i') }} – {{ validUntil|date('H:i') }}</div>
        </div>
      {% endif %}
      <div>
        <div class="card__label">Checked in</div>
        <div class="card__value" id="door-access-checked-in">
          {% if attendee.checkedInAt %}
            {{ attendee.checkedInAt|date('d M Y, H:i') }}
            {% if attendee.checkedInMethod == 'manual' and attendee.checkedInBy %}
              &middot; by {{ attendee.checkedInBy.displayName }}
            {% elseif attendee.checkedInMethod == 'door_pin' %}
              &middot; via door PIN
            {% endif %}
          {% else %}
            Not yet
          {% endif %}
        </div>
      </div>
    </div>

    <div id="door-access-error" class="flash flash--error" style="display:none;margin-top:1rem;"></div>

    <div class="btn-row" style="margin-top:1rem;">
      {% if not attendee.checkedIn %}
        <button type="button" id="door-access-checkin" class="btn btn--teal btn--sm"
                data-url="{{ path('app_api_attendee_check_in', {id: attendee.id}) }}"
                data-csrf="{{ csrf_token('attendee_check_in_' ~ attendee.id) }}">Check in now</button>
      {% endif %}
      {% if attendee.pin %}
        <button type="button" id="door-access-regenerate" class="btn btn--ghost btn--sm"
                data-url="{{ path('app_api_attendee_regenerate_pin', {id: attendee.id}) }}"
                data-csrf="{{ csrf_token('attendee_regenerate_pin_' ~ attendee.id) }}">Regenerate PIN</button>
      {% endif %}
    </div>
  </div>
{% endif %}

<div class="card" style="margin-top:1.5rem;">
  <div class="card__label" style="margin-bottom:0.6rem;">Notes</div>
  {% include 'admin/_notes_panel.html.twig' with {notes: notes, noteableType: 'attendee', noteableId: attendee.id} %}
</div>

<div class="card" style="margin-top:1.5rem;">
  <div class="card__label" style="margin-bottom:0.6rem;">Danger zone</div>
  {% if attendee.paidAmount != '0.00' %}
    <p style="font-size:0.85rem;color:var(--muted);">
      This booking has £{{ attendee.paidAmount }} recorded as paid, so it can't be deleted. Set the paid amount to £0 above and save first.
    </p>
  {% else %}
    <form method="post" action="{{ path('app_admin_booking_delete', {id: attendee.id}) }}"
          onsubmit="return confirm('Permanently delete this booking? This cannot be undone.');">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_booking_' ~ attendee.id) }}">
      <input type="hidden" name="returnTo" value="{{ returnTo }}">
      <button type="submit" class="btn btn--danger btn--sm">Delete booking</button>
    </form>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
{% if attendee.event.isSelfAccess %}
<script>
  function doorAccessCall(button) {
    const errorBox = document.getElementById('door-access-error');
    errorBox.style.display = 'none';
    button.disabled = true;

    fetch(button.dataset.url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _csrf_token: button.dataset.csrf }),
    })
      .then(r => r.json().then(data => ({ ok: r.ok, data })))
      .then(({ ok, data }) => {
        if (!ok) {
          errorBox.textContent = data.error || 'Something went wrong.';
          errorBox.style.display = 'block';
          button.disabled = false;
          return;
        }
        window.location.reload();
      })
      .catch(() => {
        errorBox.textContent = 'Something went wrong.';
        errorBox.style.display = 'block';
        button.disabled = false;
      });
  }

  const doorAccessCheckin    = document.getElementById('door-access-checkin');
  const doorAccessRegenerate = document.getElementById('door-access-regenerate');

  if (doorAccessCheckin)    doorAccessCheckin.addEventListener('click', () => doorAccessCall(doorAccessCheckin));
  if (doorAccessRegenerate) doorAccessRegenerate.addEventListener('click', () => doorAccessCall(doorAccessRegenerate));
</script>
{% endif %}
{% endblock %}
