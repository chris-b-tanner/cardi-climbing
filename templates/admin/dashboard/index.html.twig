{% extends 'admin/base.html.twig' %}
{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Dashboard</h1>
</div>

<div class="card">
  <div class="card__label" style="margin-bottom:0.25rem;">Opted-in members</div>
  <div style="display:flex;align-items:baseline;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.75rem;">
    <span style="font-size:2rem;font-weight:700;color:var(--black);">{{ totalOptedIn }}</span>
    {% set change = totalOptedIn - startCount %}
    {% if change != 0 %}
      <span style="font-size:0.9rem;color:{{ change > 0 ? '#16a34a' : 'var(--red)' }};font-weight:600;">
        {{ change > 0 ? '+' ~ change : change }} since 20 Aug
      </span>
    {% else %}
      <span style="font-size:0.9rem;color:var(--muted);">No change since 20 Aug</span>
    {% endif %}
    <span style="font-size:0.85rem;color:var(--muted);">out of {{ totalMembers }} total members</span>
  </div>

  <div style="display:flex;gap:1.25rem;margin-bottom:0.75rem;flex-wrap:wrap;">
    {% for series in chart.series %}
      <span style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;color:var(--muted);">
        <span style="width:10px;height:10px;border-radius:50%;background:{{ series.color }};display:inline-block;"></span>
        {{ series.label }}
      </span>
    {% endfor %}
    <span style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;color:var(--muted);">
      <span style="width:10px;height:10px;border-radius:50%;background:{{ chart.target.color }};display:inline-block;"></span>
      {{ chart.target.label }}
    </span>
  </div>

  <div class="table-scroll">
    <svg viewBox="0 0 {{ chart.width }} {{ chart.height }}" width="100%" style="display:block;">
      {% for y in chart.yAxis %}
        <line x1="0" y1="{{ y.y }}" x2="{{ chart.width }}" y2="{{ y.y }}" stroke="var(--border)" stroke-width="1" stroke-dasharray="3,3"></line>
        <text x="0" y="{{ y.y - 4 }}" font-size="10" fill="var(--muted)">{{ y.label }}</text>
      {% endfor %}

      <polyline points="{{ chart.target.polyline }}" fill="none" stroke="{{ chart.target.color }}" stroke-width="2" stroke-dasharray="5,4"></polyline>
      {% for point in chart.target.points %}
        <circle cx="{{ point.x }}" cy="{{ point.y }}" r="2.5" fill="{{ chart.target.color }}">
          <title>{{ point.date|date('d M Y') }}: {{ point.count }} target</title>
        </circle>
      {% endfor %}

      {% for series in chart.series %}
        <polyline points="{{ series.polyline }}" fill="none" stroke="{{ series.color }}" stroke-width="2"></polyline>
      {% endfor %}

      {% for series in chart.series %}
        {% for point in series.points %}
          <circle cx="{{ point.x }}" cy="{{ point.y }}" r="2.5" fill="{{ series.color }}">
            <title>{{ point.date|date('d M Y') }}: {{ point.count }} {{ series.label }}</title>
          </circle>
        {% endfor %}
      {% endfor %}

      {% for tick in chart.xAxis %}
        <text x="{{ tick.x }}" y="{{ chart.height }}" font-size="10" fill="var(--muted)" text-anchor="middle">{{ tick.label }}</text>
      {% endfor %}
    </svg>
  </div>
</div>
{% endblock %}
