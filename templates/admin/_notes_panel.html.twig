{#
  Shared notes panel — included on the Member, Attendee (booking), Event, Product, and Order admin
  pages. Expects `notes` (Note[], pinned first), `noteableType`, and `noteableId`.
#}
{% if notes is empty %}
  <p style="color:var(--muted);font-size:0.875rem;margin-bottom:1rem;">No notes yet.</p>
{% else %}
  <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1.25rem;">
    {% for note in notes %}
      {% if note.pinned %}
        <div style="background:#fefce8;border:1px solid #fde047;border-radius:var(--radius);padding:0.65rem 0.85rem;">
      {% elseif note.completed %}
        <div style="border-left:3px solid #16a34a;padding:0.5rem 0.75rem;">
      {% else %}
        <div style="border-left:3px solid var(--border);padding:0.5rem 0.75rem;">
      {% endif %}
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.5rem;">
          <p style="font-size:0.9375rem;white-space:pre-wrap;margin-bottom:0.3rem;">{{ note.content }}</p>
          {% if note.pinned %}
            <span class="status-pill status-pill--pinned" style="flex-shrink:0;">Pinned</span>
          {% elseif note.completed %}
            <span class="status-pill status-pill--published" style="flex-shrink:0;">Completed</span>
          {% endif %}
        </div>
        <p style="font-size:0.75rem;color:var(--muted);">
          {{ note.createdAt|date('j M Y, H:i') }}
          {% if note.addedBy %}
            · {{ note.addedBy.displayName }}
          {% else %}
            · System
          {% endif %}
          {% if note.pinned and note.pinnedBy %}
            · Pinned by {{ note.pinnedBy.displayName }}
          {% endif %}
          {% if note.assignedTo %}
            · Assigned to {{ note.assignedTo.displayName }}
          {% endif %}
          {% if note.completed %}
            · Completed {{ note.completedAt|date('j M Y') }}{% if note.completedBy %} by {{ note.completedBy.displayName }}{% endif %}
          {% endif %}
          {% if note.email %}
            · <a href="{{ path('app_admin_email_compose_edit', {id: note.email.id}) }}" style="color:var(--teal-dk);">View email</a>
          {% else %}
            · <form method="post" action="{{ path('app_admin_note_pin', {id: note.id}) }}" style="display:inline;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_pin_' ~ note.id) }}">
                <button type="submit" style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--teal-dk);text-decoration:underline;cursor:pointer;">{{ note.pinned ? 'Unpin' : 'Pin' }}</button>
              </form>
          {% endif %}
          {% if note.pinned %}
            · <form method="post" action="{{ path('app_admin_note_complete', {id: note.id}) }}" style="display:inline;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_complete_' ~ note.id) }}">
                <button type="submit" style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:#16a34a;text-decoration:underline;cursor:pointer;">Complete</button>
              </form>
          {% endif %}
          {% if note.addedBy and note.addedBy == app.user and not note.email %}
            · <form method="post" action="{{ path('app_admin_note_delete', {id: note.id}) }}"
                    style="display:inline;"
                    onsubmit="return window.prompt('Type DELETE to remove this note:') === 'DELETE';">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_delete_' ~ note.id) }}">
                <button type="submit" style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--red);text-decoration:underline;cursor:pointer;">Delete</button>
              </form>
          {% endif %}
          {% if note.pinned %}
            · <button type="button" class="note-assign-trigger"
                      data-note-id="{{ note.id }}"
                      data-csrf="{{ csrf_token('note_assign_' ~ note.id) }}"
                      style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--teal-dk);text-decoration:underline;cursor:pointer;">Assign</button>
          {% endif %}
        </p>
      </div>
    {% endfor %}
  </div>
{% endif %}

<form method="post" action="{{ path('app_admin_note_add', {noteableType: noteableType, noteableId: noteableId}) }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_add_' ~ noteableType ~ '_' ~ noteableId) }}">
  <div class="form-group" style="margin-bottom:0.5rem;">
    <textarea name="content" class="form-control" rows="3"
              placeholder="Add a note…" style="resize:vertical;"></textarea>
  </div>
  <div style="display:flex;align-items:center;gap:0.75rem;">
    <button type="submit" class="btn btn--teal btn--sm">Add note</button>
    <label style="flex-direction:row;align-items:center;gap:0.4rem;display:flex;text-transform:none;font-size:0.8rem;color:var(--black);cursor:pointer;">
      <input type="checkbox" name="pinned" value="1" style="width:1rem;height:1rem;accent-color:var(--teal);">
      Pinned
    </label>
  </div>
</form>

<div id="note-assign-modal" class="pos-modal" style="display:none;">
  <div id="note-assign-modal-backdrop" class="pos-modal__backdrop"></div>
  <div class="pos-modal__box">
    <div class="pos-modal__header">
      <strong>Assign note</strong>
      <button type="button" id="note-assign-modal-close" class="btn btn--ghost btn--sm">✕</button>
    </div>
    <form id="note-assign-form" method="post">
      <input type="hidden" name="_csrf_token" id="note-assign-csrf">
      <input type="hidden" name="userId" id="note-assign-user-id">
    </form>
    <div style="display:flex;gap:0.5rem;margin-bottom:0.75rem;">
      <button type="button" id="note-assign-to-me" class="btn btn--teal btn--sm">Assign to me</button>
      <button type="button" id="note-assign-unassign" class="btn btn--ghost btn--sm">Unassign</button>
    </div>
    <div class="tag-picker__list" id="note-assign-staff-list" style="max-height:260px;"></div>
  </div>
</div>

<script>
  (function () {
    const modal        = document.getElementById('note-assign-modal');
    const backdrop      = document.getElementById('note-assign-modal-backdrop');
    const closeBtn       = document.getElementById('note-assign-modal-close');
    const form          = document.getElementById('note-assign-form');
    const csrfInput      = document.getElementById('note-assign-csrf');
    const userIdInput    = document.getElementById('note-assign-user-id');
    const toMeBtn        = document.getElementById('note-assign-to-me');
    const unassignBtn    = document.getElementById('note-assign-unassign');
    const staffList      = document.getElementById('note-assign-staff-list');
    const currentUserId  = {{ app.user.id }};
    const noteAssignUrlPattern = '{{ path('app_admin_note_assign', {id: 0}) }}';
    const staffListUrl   = '{{ path('app_admin_note_staff_list') }}';
    let staffCache = null;

    function openModal(noteId, csrf) {
      form.action = noteAssignUrlPattern.replace('0', noteId);
      csrfInput.value = csrf;
      modal.style.display = 'flex';
      renderStaffList();
    }

    function closeModal() {
      modal.style.display = 'none';
    }

    function submitAssign(userId) {
      userIdInput.value = userId;
      form.submit();
    }

    function renderStaffList() {
      staffList.innerHTML = '<p style="padding:0.5rem;color:var(--muted);font-size:0.85rem;">Loading…</p>';

      const load = staffCache
        ? Promise.resolve(staffCache)
        : fetch(staffListUrl).then(r => r.json()).then(data => { staffCache = data; return data; });

      load.then(staff => {
        staffList.innerHTML = '';
        staff.forEach(person => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'tag-picker__item';
          btn.textContent = person.name;
          btn.addEventListener('click', () => submitAssign(person.id));
          staffList.appendChild(btn);
        });
      });
    }

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.note-assign-trigger');
      if (trigger) openModal(trigger.dataset.noteId, trigger.dataset.csrf);
    });

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    toMeBtn.addEventListener('click', () => submitAssign(currentUserId));
    unassignBtn.addEventListener('click', () => submitAssign(''));
  })();
</script>
