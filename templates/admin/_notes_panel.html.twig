{#
  Shared notes panel — included on the Member, Attendee (booking), Event, Product, and Order admin
  pages. Expects `notes` (Note[], pinned first), `noteableType`, and `noteableId`. Optional
  `contactEmail` (member page only) shows an "Email {address}" checkbox on the add-note form —
  ticking it reveals a required Subject field above the note textarea, and sends the note straight
  to that address as a blank templated email alongside saving it, the lightweight continuation of a
  conversation that started via the full compose screen (see AdminNoteController::add() /
  ContactQuickEmailMailer). Optional `lastEmailSubject` (whatever Note::$emailSubject the most
  recent turn in this thread carries, from either side — see
  NoteRepository::findLatestEmailThreadNote()) prefills the Subject field with "Re: {that}" the
  first time the checkbox is ticked, so a follow-up threads under the same subject by default. Any
  note carrying `emailSubject` (either direction — an admin's outbound send or a member's inbound
  reply, see WebhookController::inbound()) shows it with a small envelope icon above the note's own
  content, rather than a text prefix baked into that content. No "insert first name" helper here —
  unlike the compose screen's multi-recipient audience, this is always exactly one contact, already
  named right at the top of the page, so a personalisation placeholder buys nothing. Ticking the
  checkbox also reveals a file picker: picked files are attached to the email and not stored (see
  ContactQuickEmailMailer). Their names are appended to the note's text as "Attachments: …".
  Optional `showForm` (default true) — pass false to list existing notes without the add-note form.
#}
{% if showForm ?? true %}
<form method="post" action="{{ path('app_admin_note_add', {noteableType: noteableType, noteableId: noteableId}) }}" enctype="multipart/form-data" novalidate style="margin-bottom:1.25rem;">
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_add_' ~ noteableType ~ '_' ~ noteableId) }}">
  {% if contactEmail is defined and contactEmail %}
    <div class="form-group note-email-subject" id="note-subject-wrap-{{ noteableType }}-{{ noteableId }}" style="display:none;margin-bottom:0.5rem;">
      <input type="text" name="subject" id="note-subject-{{ noteableType }}-{{ noteableId }}" class="form-control"
             placeholder="Subject line for this email…" data-last-subject="{{ lastEmailSubject|default('') }}">
    </div>
  {% endif %}
  <div class="form-group" style="margin-bottom:0.5rem;">
    <textarea id="note-content-{{ noteableType }}-{{ noteableId }}" name="content" class="form-control" rows="3"
              placeholder="Add a note…" style="resize:vertical;"></textarea>
  </div>
  {% if contactEmail is defined and contactEmail %}
    {% set attachmentExtensions = constant('App\\Service\\Mailer\\ContactQuickEmailMailer::ATTACHMENT_EXTENSIONS') %}
    {% set maxAttachmentBytes = constant('App\\Service\\Mailer\\ContactQuickEmailMailer::MAX_ATTACHMENT_BYTES') %}
    <div class="form-group note-email-attachments" id="note-attachments-wrap-{{ noteableType }}-{{ noteableId }}" style="display:none;margin-bottom:0.5rem;">
      <label for="note-attachments-{{ noteableType }}-{{ noteableId }}" style="text-transform:none;font-size:0.8rem;color:var(--black);">
        <i class="bi bi-paperclip"></i> Attachments <span style="color:var(--muted);font-weight:400;">(optional, up to {{ (maxAttachmentBytes / 1048576)|round }} MB in total, not stored)</span>
      </label>
      <input type="file" name="attachments[]" id="note-attachments-{{ noteableType }}-{{ noteableId }}" multiple
             accept="{{ attachmentExtensions|map(ext => '.' ~ ext)|join(',') }}"
             data-max-bytes="{{ maxAttachmentBytes }}" data-extensions="{{ attachmentExtensions|join(',') }}"
             style="font-size:0.8rem;">
      <ul class="note-attachments-list" style="list-style:none;padding:0;margin:0.4rem 0 0;font-size:0.8rem;"></ul>
      <p class="note-attachments-summary" style="font-size:0.75rem;color:var(--muted);margin:0.3rem 0 0;"></p>
    </div>
  {% endif %}
  <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
    <button type="submit" id="note-submit-{{ noteableType }}-{{ noteableId }}" class="btn btn--teal btn--sm">Add note</button>
    <label style="flex-direction:row;align-items:center;gap:0.4rem;display:flex;text-transform:none;font-size:0.8rem;color:var(--black);cursor:pointer;">
      <input type="checkbox" name="pinned" value="1" style="width:1rem;height:1rem;accent-color:var(--teal);">
      Pinned
    </label>
    {% if contactEmail is defined and contactEmail %}
      <label style="flex-direction:row;align-items:center;gap:0.4rem;display:flex;text-transform:none;font-size:0.8rem;color:var(--black);cursor:pointer;">
        <input type="checkbox" name="emailContact" value="1" id="note-email-toggle-{{ noteableType }}-{{ noteableId }}" style="width:1rem;height:1rem;accent-color:var(--teal);">
        Email {{ contactEmail }}
      </label>
    {% endif %}
  </div>
</form>
{% endif %}

{% if notes is empty %}
  <p style="color:var(--muted);font-size:0.875rem;margin-bottom:1rem;">No notes yet.</p>
{% else %}
  <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1.25rem;">
    {% for note in notes %}
      {% if note.pinned %}
        <div style="background:#fefce8;border:1px solid #fde047;border-radius:var(--radius);padding:0.65rem 0.85rem;">
      {% elseif note.completed %}
        <div style="border-left:3px solid #16a34a;padding:0.5rem 0.75rem;">
      {% else %}
        <div style="border-left:3px solid var(--border);padding:0.5rem 0.75rem;">
      {% endif %}
        {% set contentLines = note.content|split('\n') %}
        {% set isLongNote = contentLines|length > 5 %}
        {% if note.emailSubject %}
          <p style="font-size:0.75rem;color:var(--teal-dk);margin-bottom:0.3rem;display:flex;align-items:center;gap:0.35rem;">
            <i class="bi bi-envelope" title="Sent by email"></i> {{ note.emailSubject }}
          </p>
        {% endif %}
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.5rem;">
          <p style="font-size:0.9375rem;white-space:pre-wrap;margin-bottom:0.3rem;">
            {%- if isLongNote -%}
              {{ contentLines|slice(0, 5)|join('\n') }}<span class="note-more-content" id="note-more-{{ note.id }}" style="display:none;">{{ "\n" ~ contentLines|slice(5)|join('\n') }}</span>
            {%- else -%}
              {{ note.content }}
            {%- endif -%}
          </p>
          {% if note.pinned %}
            <span class="status-pill status-pill--pinned" style="flex-shrink:0;">Pinned</span>
          {% elseif note.completed %}
            <span class="status-pill status-pill--published" style="flex-shrink:0;">Completed</span>
          {% endif %}
        </div>
        {% if isLongNote %}
          <button type="button" class="note-toggle-more" data-target="note-more-{{ note.id }}"
                  style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--teal-dk);text-decoration:underline;cursor:pointer;margin-bottom:0.3rem;">Show more</button>
        {% endif %}
        <p style="font-size:0.75rem;color:var(--muted);">
          {{ note.createdAt|date('j M Y, H:i') }}
          {% if note.addedBy %}
            · {{ note.addedBy.displayName }}
          {% else %}
            · System
          {% endif %}
          {% if note.pinned and note.pinnedBy %}
            · Pinned by {{ note.pinnedBy.displayName }}
          {% endif %}
          {% if note.assignedTo %}
            · Assigned to {{ note.assignedTo.displayName }}
          {% endif %}
          {% if note.completed %}
            · Completed {{ note.completedAt|date('j M Y') }}{% if note.completedBy %} by {{ note.completedBy.displayName }}{% endif %}
          {% endif %}
          {% if note.emailOpenedAt %}
            · <span class="status-pill status-pill--opened" title="Opened {{ note.emailOpenCount }} time{{ note.emailOpenCount == 1 ? '' : 's' }}, per Postmark — Apple Mail can report an open the recipient never made"><i class="bi bi-envelope-open"></i> Opened {{ note.emailOpenedAt|date('j M Y, H:i') }}{% if note.emailOpenCount > 1 %} ({{ note.emailOpenCount }}×){% endif %}</span>
          {% elseif note.emailRef %}
            · <span class="status-pill status-pill--unopened">Not opened yet</span>
          {% endif %}
          {% if note.email %}
            · <a href="{{ path('app_admin_email_compose_edit', {id: note.email.id}) }}" style="color:var(--teal-dk);">View email</a>
          {% else %}
            · <form method="post" action="{{ path('app_admin_note_pin', {id: note.id}) }}" style="display:inline;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_pin_' ~ note.id) }}">
                <button type="submit" style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--teal-dk);text-decoration:underline;cursor:pointer;">{{ note.pinned ? 'Unpin' : 'Pin' }}</button>
              </form>
          {% endif %}
          {% if note.pinned %}
            · <form method="post" action="{{ path('app_admin_note_complete', {id: note.id}) }}" style="display:inline;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_complete_' ~ note.id) }}">
                <button type="submit" style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:#16a34a;text-decoration:underline;cursor:pointer;">Complete</button>
              </form>
          {% endif %}
          {% if note.addedBy and note.addedBy == app.user and not note.email %}
            · <form method="post" action="{{ path('app_admin_note_delete', {id: note.id}) }}"
                    style="display:inline;"
                    onsubmit="return window.prompt('Type DELETE to remove this note:') === 'DELETE';">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_delete_' ~ note.id) }}">
                <button type="submit" style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--red);text-decoration:underline;cursor:pointer;">Delete</button>
              </form>
          {% endif %}
          {% if note.pinned %}
            · <button type="button" class="note-assign-trigger"
                      data-assign-url="{{ path('app_admin_note_assign', {id: note.id}) }}"
                      data-csrf="{{ csrf_token('note_assign_' ~ note.id) }}"
                      style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--teal-dk);text-decoration:underline;cursor:pointer;">Assign</button>
          {% endif %}
        </p>
      </div>
    {% endfor %}
  </div>
{% endif %}

{% include 'admin/_assign_modal.html.twig' with {prefix: 'note-assign'} %}

<script>
  (function () {
    // Shows/requires the Subject field, doubles the note textarea's row count, and relabels the
    // submit button "Send email", only while "Email {address}" is ticked — a plain note never needs either, but a note that's actually
    // going out as an email always needs a subject (enforced again server-side — see
    // AdminNoteController::add()) and tends to run longer than a quick internal note.
    document.querySelectorAll('.note-email-subject').forEach((wrap) => {
      const suffix  = wrap.id.slice('note-subject-wrap-'.length);
      const toggle  = document.getElementById('note-email-toggle-' + suffix);
      const input   = wrap.querySelector('input[name="subject"]');
      const content = document.getElementById('note-content-' + suffix);
      const submit  = document.getElementById('note-submit-' + suffix);
      const attachWrap = document.getElementById('note-attachments-wrap-' + suffix);
      const fileInput  = attachWrap ? attachWrap.querySelector('input[type="file"]') : null;
      const fileSummary = attachWrap ? attachWrap.querySelector('.note-attachments-summary') : null;
      const fileList    = attachWrap ? attachWrap.querySelector('.note-attachments-list') : null;
      if (!toggle || !input || !content || !submit) return;

      // A file input's own selection is replaced, not added to, each time the picker is reopened,
      // so files picked one at a time would leave only the last. Keep every pick here instead, and
      // write the combined list back into the input so it's what the form submits.
      let picked = [];

      function syncInput() {
        const transfer = new DataTransfer();
        picked.forEach((file) => transfer.items.add(file));
        fileInput.files = transfer.files;
      }

      function formatSize(bytes) {
        return bytes < 1048576 ? Math.max(1, Math.round(bytes / 1024)) + ' KB' : (bytes / 1048576).toFixed(1) + ' MB';
      }

      // Checked again server-side (ContactQuickEmailMailer::attachmentError()), but catching it here
      // saves uploading several MB only to have it bounced, or tripping PHP's post_max_size.
      function attachmentProblem() {
        if (!picked.length) return null;
        const allowed = fileInput.dataset.extensions.split(',');
        let total = 0;
        for (const file of picked) {
          const ext = file.name.includes('.') ? file.name.split('.').pop().toLowerCase() : '';
          if (!allowed.includes(ext)) return file.name + ' can\'t be attached — allowed: ' + allowed.join(', ') + '.';
          total += file.size;
        }
        const max = Number(fileInput.dataset.maxBytes);
        if (total > max) return 'Attachments add up to ' + (total / 1048576).toFixed(1) + ' MB — the limit is ' + Math.round(max / 1048576) + ' MB.';
        return null;
      }

      function updateFileSummary() {
        if (!fileSummary) return;

        fileList.replaceChildren(...picked.map((file, index) => {
          const item = document.createElement('li');
          item.style.cssText = 'display:flex;align-items:center;gap:0.4rem;padding:0.15rem 0;';
          const name = document.createElement('span');
          name.textContent = file.name + ' (' + formatSize(file.size) + ')';
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = '×';
          remove.title = 'Remove ' + file.name;
          remove.setAttribute('aria-label', 'Remove ' + file.name);
          remove.style.cssText = 'border:none;background:none;padding:0 0.2rem;font-size:1rem;line-height:1;color:var(--muted);cursor:pointer;';
          remove.addEventListener('click', () => {
            picked.splice(index, 1);
            syncInput();
            updateFileSummary();
          });
          item.append(name, remove);
          return item;
        }));

        const problem = attachmentProblem();
        if (problem) {
          fileSummary.textContent = problem;
          fileSummary.style.color = 'var(--red)';
        } else if (picked.length) {
          const total = picked.reduce((sum, file) => sum + file.size, 0);
          fileSummary.textContent = picked.length + (picked.length === 1 ? ' file, ' : ' files, ') + formatSize(total) + ' in total';
          fileSummary.style.color = 'var(--muted)';
        } else {
          fileSummary.textContent = '';
        }
      }

      if (fileInput) {
        fileInput.addEventListener('change', () => {
          // Add the new picks to what's already chosen, skipping exact repeats of the same file.
          for (const file of fileInput.files) {
            const duplicate = picked.some((f) => f.name === file.name && f.size === file.size && f.lastModified === file.lastModified);
            if (!duplicate) picked.push(file);
          }
          syncInput();
          updateFileSummary();
        });
        toggle.form.addEventListener('submit', (e) => {
          if (!toggle.checked) return;
          const problem = attachmentProblem();
          if (problem) {
            e.preventDefault();
            updateFileSummary();
            fileInput.focus();
          }
        });
      }

      const baseRows  = content.rows;
      const baseLabel = submit.textContent;

      toggle.addEventListener('change', () => {
        wrap.style.display = toggle.checked ? 'block' : 'none';
        input.required = toggle.checked;
        content.rows = toggle.checked ? baseRows * 2 : baseRows;
        submit.textContent = toggle.checked ? 'Send email' : baseLabel;
        if (attachWrap) {
          attachWrap.style.display = toggle.checked ? 'block' : 'none';
          if (!toggle.checked) {
            picked = []; // a plain note never carries attachments
            syncInput();
            updateFileSummary();
          }
        }

        if (toggle.checked) {
          // Defaults to "Re: {whatever the thread's last message used}" — never overwrites
          // something already typed (e.g. toggling the checkbox off and back on).
          if (!input.value.trim() && input.dataset.lastSubject) {
            input.value = 'Re: ' + input.dataset.lastSubject.replace(/^(re:\s*)+/i, '');
          }
          input.focus();
        } else {
          input.value = '';
          content.focus();
        }
      });
    });

    document.addEventListener('click', (e) => {
      const toggle = e.target.closest('.note-toggle-more');
      if (toggle) {
        const target = document.getElementById(toggle.dataset.target);
        if (target) {
          const isHidden = target.style.display === 'none';
          target.style.display = isHidden ? 'inline' : 'none';
          toggle.textContent = isHidden ? 'Show less' : 'Show more';
        }
      }
    });
  })();
</script>
