{% extends 'admin/base.html.twig' %}
{% block title %}New member{% endblock %}

{% block content %}
<div class="page-header">
  <h1>New member</h1>
  <a href="{{ path('app_admin_users') }}" class="btn btn--ghost btn--sm">← Cancel</a>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_user_new') }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_new') }}">

  <div class="card">
    <div class="detail-grid">
      <div class="form-group" style="margin-bottom:0;">
        <label for="firstName">First name</label>
        <input type="text" id="firstName" name="firstName" class="form-control"
               autocomplete="off">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="lastName">Last name</label>
        <input type="text" id="lastName" name="lastName" class="form-control"
               autocomplete="off">
      </div>
    </div>
    <div class="form-group" style="margin-top:1rem;">
      <label for="email">Email <span style="color:var(--red);">*</span></label>
      <input type="email" id="email" name="email" class="form-control"
             autocomplete="off" required>
    </div>
    <div class="form-group">
      <label for="role">Role</label>
      <select id="role" name="role" class="form-control">
        <option value="ROLE_MEMBER">Member</option>
        <option value="ROLE_STAFF">Staff</option>
        <option value="ROLE_ADMIN">Admin</option>
      </select>
    </div>
    <div class="form-group" style="margin-bottom:0;">
      <label for="password">Initial password <span style="color:var(--red);">*</span></label>
      <input type="password" id="password" name="password" class="form-control"
             autocomplete="new-password" required minlength="8">
      <p style="font-size:0.78rem;color:var(--muted);margin-top:0.35rem;">
        Minimum 8 characters. The member can change it via forgot password.
      </p>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Create member</button>
    <a href="{{ path('app_admin_users') }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>
{% endblock %}
