{% extends 'admin/base.html.twig' %}

{% set displayName = (user.firstName ~ ' ' ~ user.lastName)|trim %}
{% block title %}Edit — {{ displayName ?: user.email }}{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Edit member</h1>
  <a href="{{ path('app_admin_user_show', {id: user.id}) }}" class="btn btn--ghost btn--sm">← Cancel</a>
</div>

<form method="post" action="{{ path('app_admin_user_edit', {id: user.id}) }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_edit_' ~ user.id) }}">

  <div class="card">
    <div class="detail-grid">
      <div class="form-group" style="margin-bottom:0;">
        <label for="firstName">First name</label>
        <input type="text" id="firstName" name="firstName" class="form-control"
               value="{{ user.firstName }}" autocomplete="given-name">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="lastName">Last name</label>
        <input type="text" id="lastName" name="lastName" class="form-control"
               value="{{ user.lastName }}" autocomplete="family-name">
      </div>
    </div>
    <div class="form-group" style="margin-top:1rem;">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" class="form-control"
             value="{{ user.email }}" autocomplete="email">
    </div>
    <div class="form-group">
      <label for="email2">Alternate email 2</label>
      <input type="email" id="email2" name="email2" class="form-control"
             value="{{ user.email2 }}" autocomplete="off">
    </div>
    <div class="form-group">
      <label for="email3">Alternate email 3</label>
      <input type="email" id="email3" name="email3" class="form-control"
             value="{{ user.email3 }}" autocomplete="off">
    </div>
    <div class="form-group">
      <label for="phone">Phone</label>
      <input type="tel" id="phone" name="phone" class="form-control"
             value="{{ user.phone }}" autocomplete="tel">
    </div>
    <div class="form-group">
      <label for="dateOfBirth">Date of birth</label>
      <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control"
             value="{{ user.dateOfBirth ? user.dateOfBirth|date('Y-m-d') : '' }}" autocomplete="bday">
    </div>
    <div class="form-group"{% if not is_granted('ROLE_ADMIN') %} style="margin-bottom:0;"{% endif %}>
      <label style="flex-direction:row;align-items:center;gap:0.5rem;display:flex;text-transform:none;font-size:0.875rem;color:var(--black);">
        <input type="checkbox" name="optIn" value="1"{% if user.optIn %} checked{% endif %}
               style="width:1rem;height:1rem;accent-color:var(--teal);">
        Opted in to mailing list
      </label>
    </div>
    {% if is_granted('ROLE_ADMIN') %}
      {% set isSelf = user == app.user %}
      <div class="form-group" style="margin-bottom:0;">
        <label for="role">Role</label>
        <select id="role" name="role" class="form-control"{% if isSelf %} disabled{% endif %}>
          <option value="ROLE_MEMBER"{% if 'ROLE_ADMIN' not in user.roles and 'ROLE_TEAM' not in user.roles %} selected{% endif %}>Member</option>
          <option value="ROLE_TEAM"{% if 'ROLE_TEAM' in user.roles and 'ROLE_ADMIN' not in user.roles %} selected{% endif %}>Team</option>
          <option value="ROLE_ADMIN"{% if 'ROLE_ADMIN' in user.roles %} selected{% endif %}>Admin</option>
        </select>
        {% if isSelf %}
          <input type="hidden" name="role" value="{{ 'ROLE_ADMIN' in user.roles ? 'ROLE_ADMIN' : ('ROLE_TEAM' in user.roles ? 'ROLE_TEAM' : 'ROLE_MEMBER') }}">
          <p style="font-size:0.78rem;color:var(--muted);margin-top:0.35rem;">You can't change your own role.</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="card">
    <div class="card__label" style="margin-bottom:0.75rem;">Address</div>
    <div class="form-group">
      <label for="addressLine1">Line 1</label>
      <input type="text" id="addressLine1" name="addressLine1" class="form-control"
             value="{{ user.addressLine1 }}" autocomplete="address-line1">
    </div>
    <div class="form-group">
      <label for="addressLine2">Line 2</label>
      <input type="text" id="addressLine2" name="addressLine2" class="form-control"
             value="{{ user.addressLine2 }}" autocomplete="address-line2">
    </div>
    <div class="detail-grid">
      <div class="form-group" style="margin-bottom:0;">
        <label for="town">Town / City</label>
        <input type="text" id="town" name="town" class="form-control"
               value="{{ user.town }}" autocomplete="address-level2">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="postcode">Postcode</label>
        <input type="text" id="postcode" name="postcode" class="form-control"
               value="{{ user.postcode }}" autocomplete="postal-code">
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card__label" style="margin-bottom:0.75rem;">Emergency contact</div>
    <div class="detail-grid">
      <div class="form-group" style="margin-bottom:0;">
        <label for="emergencyContactName">Name</label>
        <input type="text" id="emergencyContactName" name="emergencyContactName" class="form-control"
               value="{{ user.emergencyContactName }}" autocomplete="off">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="emergencyContactPhone">Phone</label>
        <input type="tel" id="emergencyContactPhone" name="emergencyContactPhone" class="form-control"
               value="{{ user.emergencyContactPhone }}" autocomplete="off">
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card__label" style="margin-bottom:0.75rem;">Tags</div>
    {% if allTags is empty %}
      <p style="color:var(--muted);font-size:0.875rem;">No tags exist yet — <a href="{{ path('app_admin_settings_tag_new') }}">create one</a> to start categorising members.</p>
    {% else %}
      <div class="tag-grid">
        {% for tag in allTags %}
          <input type="checkbox" id="tag_{{ tag.id }}" name="tags[]"
                 value="{{ tag.id }}" class="tag-check"
                 {% if user.hasTag(tag) %}checked{% endif %}>
          <label for="tag_{{ tag.id }}" class="tag-check-label">{{ tag.name }}</label>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="card">
    <div class="card__label" style="margin-bottom:0.75rem;">Dependents</div>
    {% if user.parent %}
      <p style="color:var(--muted);font-size:0.875rem;">
        {{ displayName ?: user.email }} is a dependent of
        <a href="{{ path('app_admin_user_show', {id: user.parent.id}) }}" style="color:var(--teal-dk);font-weight:600;">{{ (user.parent.firstName ~ ' ' ~ user.parent.lastName)|trim ?: user.parent.email }}</a>,
        so can't have dependents of their own.
      </p>
    {% elseif not user.email %}
      <p style="color:var(--muted);font-size:0.875rem;">
        {{ displayName ?: 'This member' }} has no email address on file, so can't have dependents — add an email first.
      </p>
    {% else %}
      <p style="color:var(--muted);font-size:0.8rem;margin-bottom:0.6rem;">Search for the members who are dependents of {{ displayName ?: user.email }}. A member can only be the dependent of one parent.</p>
      <div id="dependent-chips" style="display:flex;flex-wrap:wrap;gap:0.4rem;{% if user.dependents is not empty %}margin-bottom:0.75rem;{% endif %}">
        {% for dependent in user.dependents %}
          {% set dependentName = (dependent.firstName ~ ' ' ~ dependent.lastName)|trim ?: dependent.email %}
          <span class="tag-badge dependent-chip" data-id="{{ dependent.id }}" style="display:inline-flex;align-items:center;gap:0.35rem;">
            <input type="hidden" name="dependents[]" value="{{ dependent.id }}">
            {{ dependentName }}
            <button type="button" class="dependent-chip__remove" aria-label="Remove {{ dependentName }}"
                    style="border:none;background:none;color:inherit;font-size:1rem;line-height:1;cursor:pointer;padding:0;">&times;</button>
          </span>
        {% endfor %}
      </div>
      <div class="form-group" style="margin-bottom:0;position:relative;">
        <input type="text" id="dependentSearch" class="form-control" placeholder="Search by name or email…" autocomplete="off">
        <div id="dependent-results" class="member-search-results"></div>
      </div>
    {% endif %}
  </div>

  <div class="card">
    <div class="form-group" style="margin-bottom:0;">
      <label for="memo">Memo</label>
      <textarea id="memo" name="memo" class="form-control" rows="5"
                placeholder="Skills, experience, background…" style="resize:vertical;">{{ user.memo }}</textarea>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Save changes</button>
    <a href="{{ path('app_admin_user_show', {id: user.id}) }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>
{% endblock %}

{% block scripts %}
{% if canHaveDependents %}
<script>
  // ── Dependent search ────────────────────────────────────────
  const dependentChips   = document.getElementById('dependent-chips');
  const dependentSearch  = document.getElementById('dependentSearch');
  const dependentResults = document.getElementById('dependent-results');
  const dependentSearchUrl = '{{ path('app_admin_user_dependent_search', {id: user.id}) }}';
  let dependentDebounce;

  function selectedDependentIds() {
    return [...dependentChips.querySelectorAll('.dependent-chip')].map(chip => chip.dataset.id);
  }

  function closeDependentResults() {
    dependentResults.classList.remove('is-open');
    dependentResults.innerHTML = '';
  }

  function addDependentChip(id, label) {
    if (selectedDependentIds().includes(String(id))) return;

    const chip = document.createElement('span');
    chip.className = 'tag-badge dependent-chip';
    chip.dataset.id = id;
    chip.style.cssText = 'display:inline-flex;align-items:center;gap:0.35rem;';
    chip.innerHTML = `
      <input type="hidden" name="dependents[]" value="${id}">
      ${label.replace(/ — .*$/, '')}
      <button type="button" class="dependent-chip__remove" aria-label="Remove"
              style="border:none;background:none;color:inherit;font-size:1rem;line-height:1;cursor:pointer;padding:0;">&times;</button>
    `;
    dependentChips.appendChild(chip);
    dependentChips.style.marginBottom = '0.75rem';
  }

  dependentSearch.addEventListener('input', () => {
    clearTimeout(dependentDebounce);

    const q = dependentSearch.value.trim();
    if (q.length < 2) {
      closeDependentResults();
      return;
    }

    dependentDebounce = setTimeout(() => {
      fetch(`${dependentSearchUrl}?q=${encodeURIComponent(q)}`)
        .then(r => r.json())
        .then(members => {
          const available = members.filter(m => !selectedDependentIds().includes(String(m.id)));
          if (!available.length) {
            dependentResults.innerHTML = '<div class="member-search-empty">No members found</div>';
            dependentResults.classList.add('is-open');
            return;
          }
          dependentResults.innerHTML = available.map(m => `
            <button type="button" class="member-search-item" data-id="${m.id}" data-label="${m.label.replace(/"/g, '&quot;')}">${m.label}</button>
          `).join('');
          dependentResults.classList.add('is-open');
        });
    }, 250);
  });

  dependentResults.addEventListener('click', (e) => {
    const btn = e.target.closest('.member-search-item');
    if (!btn) return;
    addDependentChip(btn.dataset.id, btn.dataset.label);
    dependentSearch.value = '';
    closeDependentResults();
  });

  dependentSearch.addEventListener('blur', () => {
    setTimeout(closeDependentResults, 150);
  });

  dependentChips.addEventListener('click', (e) => {
    const btn = e.target.closest('.dependent-chip__remove');
    if (!btn) return;
    btn.closest('.dependent-chip').remove();
  });
</script>
{% endif %}
{% endblock %}
