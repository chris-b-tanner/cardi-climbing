{% extends 'admin/base.html.twig' %}

{% set displayName = (user.firstName ~ ' ' ~ user.lastName)|trim %}
{% block title %}#{{ user.id }} {{ displayName ?: user.email }}{% endblock %}
{% block og_title %}{{ displayName ?: user.email }} — Y Wal{% endblock %}
{% block og_description %}{{ displayName ?: user.email }}{% if user.email %} · {{ user.email }}{% endif %}{% endblock %}

{% block content %}
<div class="page-header">
  <h1><span class="member-id">#{{ user.id }}</span> {{ displayName ?: user.email }}</h1>
  <div class="btn-row">
    <a href="{{ path('app_admin_users') }}" class="btn btn--ghost btn--sm">← Members</a>
    <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn--teal btn--sm">Edit</a>
    <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"
          style="display:inline;"
          onsubmit="return confirm('Permanently delete {{ (displayName ?: user.email)|e('js') }}? This cannot be undone.');">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
      <button type="submit" class="btn btn--danger btn--sm">Delete</button>
    </form>
  </div>
</div>

{% if duplicates is not empty %}
  {% set dupeQuery = user.firstName ~ ' ' ~ user.lastName %}
  <div class="duplicate-warning">
    <span class="duplicate-warning__icon">⚠</span>
    <span>
      {{ duplicates|length }} other {{ duplicates|length == 1 ? 'member' : 'members' }} found with the name <strong>{{ dupeQuery }}</strong>.
      <a href="{{ path('app_admin_users', {q: dupeQuery}) }}" class="duplicate-warning__link">View all matches</a>
    </span>
  </div>
{% endif %}

<div class="member-columns">
<div class="member-col-left">

<div class="card">
  <div class="detail-grid">
    <div>
      <div class="card__label">First name</div>
      <div class="card__value">{{ user.firstName ?: '—' }}</div>
    </div>
    <div>
      <div class="card__label">Last name</div>
      <div class="card__value">{{ user.lastName ?: '—' }}</div>
    </div>
    <div>
      <div class="card__label">Email</div>
      <div class="card__value">
        <a href="mailto:{{ user.email }}" style="color:var(--teal);">{{ user.email }}</a>
        {% if user.email2 %}
          <br><a href="mailto:{{ user.email2 }}" style="color:var(--teal);font-size:0.85rem;">{{ user.email2 }}</a>
        {% endif %}
        {% if user.email3 %}
          <br><a href="mailto:{{ user.email3 }}" style="color:var(--teal);font-size:0.85rem;">{{ user.email3 }}</a>
        {% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Phone</div>
      <div class="card__value">
        {% if user.phone %}
          <a href="tel:{{ user.phone }}" style="color:var(--teal);">{{ user.phone }}</a>
        {% else %}—{% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Role</div>
      <div class="card__value">
        {% if 'ROLE_ADMIN' in user.roles %}
          <span class="role-pill role-pill--admin">Admin</span>
        {% elseif 'ROLE_STAFF' in user.roles %}
          <span class="role-pill role-pill--staff">Staff</span>
        {% else %}
          <span class="role-pill">Member</span>
        {% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Mailing list</div>
      <div class="card__value">{{ user.optIn ? 'Opted in' : 'Opted out' }}</div>
    </div>
    <div>
      <div class="card__label">Joined</div>
      <div class="card__value">{{ user.createdAt|date('j M Y') }}</div>
    </div>
  </div>
</div>

{% if user.addressLine1 or user.town or user.postcode %}
<div class="card">
  <div class="card__label" style="margin-bottom:0.6rem;">Address</div>
  <div class="card__value" style="line-height:1.8;">
    {% if user.addressLine1 %}<span>{{ user.addressLine1 }}</span><br>{% endif %}
    {% if user.addressLine2 %}<span>{{ user.addressLine2 }}</span><br>{% endif %}
    {% if user.town %}<span>{{ user.town }}</span><br>{% endif %}
    {% if user.postcode %}<span>{{ user.postcode }}</span>{% endif %}
  </div>
</div>
{% endif %}

<div class="card">
  <div class="card__label" style="margin-bottom:0.6rem;">Tags</div>
  {% if user.tags is empty %}
    <span class="tag-badge--none">No tags assigned</span>
  {% else %}
    {% for tag in user.tags %}
      <span class="tag-badge">{{ tag.name }}</span>
    {% endfor %}
  {% endif %}
</div>

{% if user.memo %}
<div class="card">
  <div class="card__label" style="margin-bottom:0.5rem;">Memo</div>
  <div class="card__value" style="white-space:pre-wrap;line-height:1.7;">{{ user.memo }}</div>
</div>
{% endif %}

<div class="card">
  <div class="card__label" style="margin-bottom:0.75rem;">Notes</div>

  {% if user.notes is empty %}
    <p style="color:var(--muted);font-size:0.875rem;margin-bottom:1rem;">No notes yet.</p>
  {% else %}
    <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1.25rem;">
      {% for note in user.notes %}
        <div style="border-left:3px solid var(--border);padding:0.5rem 0.75rem;">
          <p style="font-size:0.9375rem;white-space:pre-wrap;margin-bottom:0.3rem;">{{ note.content }}</p>
          <p style="font-size:0.75rem;color:var(--muted);">
            {{ note.createdAt|date('j M Y, H:i') }}
            {% if note.addedBy %}
              · {{ (note.addedBy.firstName ~ ' ' ~ note.addedBy.lastName)|trim ?: note.addedBy.email }}
            {% else %}
              · System
            {% endif %}
          </p>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <form method="post" action="{{ path('app_admin_user_add_note', {id: user.id}) }}" novalidate>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('note_' ~ user.id) }}">
    <div class="form-group" style="margin-bottom:0.5rem;">
      <textarea name="content" class="form-control" rows="3"
                placeholder="Add a note…" style="resize:vertical;"></textarea>
    </div>
    <button type="submit" class="btn btn--teal btn--sm">Add note</button>
  </form>
</div>

</div>
<div class="member-col-right">

<div class="card">
  <div class="card__label" style="margin-bottom:0.75rem;">Bookings</div>
  {% if bookings is empty %}
    <p style="color:var(--muted);font-size:0.875rem;">No bookings yet.</p>
  {% else %}
    <div style="display:flex;flex-direction:column;gap:0.6rem;">
      {% for booking in bookings %}
        {% set pillClass = booking.status == 'confirmed' ? ' status-pill--published' : (booking.status == 'cancelled' ? ' status-pill--cancelled' : '') %}
        <div style="border-left:3px solid var(--border);padding:0.4rem 0.75rem;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
            <a href="{{ path('app_admin_event_edit', {id: booking.event.id}) }}" class="admin-table__link" style="font-size:0.9375rem;">
              {{ booking.event.title }}
            </a>
            <span class="status-pill{{ pillClass }}">{{ booking.status|capitalize }}</span>
          </div>
          <p style="font-size:0.78rem;color:var(--muted);margin-top:0.2rem;">
            {{ (booking.occurrenceDate ?? booking.event.date)|date('d M Y') }}
            · {{ booking.effectivePrice ? '£' ~ booking.effectivePrice : 'Free' }}
            {% if booking.paidAmount != '0.00' %} · Paid £{{ booking.paidAmount }}{% endif %}
          </p>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="card">
  <div class="card__label" style="margin-bottom:0.75rem;">Certifications</div>
  {% if user.certifications is empty %}
    <p style="color:var(--muted);font-size:0.875rem;">No certifications on record.</p>
  {% else %}
    <div style="display:flex;flex-direction:column;gap:0.6rem;">
      {% for record in user.certifications %}
        <div style="border-left:3px solid var(--border);padding:0.4rem 0.75rem;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
            <span style="font-size:0.9375rem;">{{ record.certification.name }}</span>
            <span class="status-pill{{ record.complete ? ' status-pill--published' : '' }}">
              {{ record.complete ? 'Complete' : 'In progress' }}
            </span>
          </div>
          <p style="font-size:0.78rem;color:var(--muted);margin-top:0.2rem;">
            Started {{ record.startedAt|date('d M Y') }}
            {% if record.complete %} · Completed {{ record.completedAt|date('d M Y') }}{% endif %}
          </p>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

</div>
</div>
{% endblock %}
