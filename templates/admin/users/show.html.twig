{% extends 'admin/base.html.twig' %}

{% set displayName = (user.firstName ~ ' ' ~ user.lastName)|trim %}
{% block title %}#{{ user.id }} {{ displayName ?: user.email }}{% endblock %}
{% block og_title %}{{ displayName ?: user.email }} — Y Wal{% endblock %}
{% block og_description %}{{ displayName ?: user.email }}{% if user.email %} · {{ user.email }}{% endif %}{% endblock %}

{% block content %}
{% set activeMembership = user.effectiveMembership and user.effectiveMembership.currentlyActive ? user.effectiveMembership : null %}
<div class="page-header">
  <h1>
    <span class="member-id">#{{ user.id }}</span> {{ displayName ?: user.email }}
    {% if activeMembership %}
      <span class="status-pill status-pill--published" style="margin-left:0.5rem;font-size:0.7rem;vertical-align:middle;">{{ activeMembership.membershipType.name }}</span>
    {% elseif user.creditBalance > 0 %}
      <span class="status-pill status-pill--pending" style="margin-left:0.5rem;font-size:0.7rem;vertical-align:middle;">{{ user.creditBalance }} credit{{ user.creditBalance == 1 ? '' : 's' }}</span>
    {% else %}
{#      <form method="post" action="{{ path('app_admin_sale_new', {userId: user.id}) }}" style="display:inline-block;margin-left:0.5rem;vertical-align:middle;">#}
{#        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_sale_new_' ~ user.id) }}">#}
{#        <button type="submit" class="btn btn--teal btn--sm">+ Add membership</button>#}
{#      </form>#}
    {% endif %}
  </h1>
  <div class="btn-row">
    <a href="{{ path('app_admin_users') }}" class="btn btn--ghost btn--sm">← Members</a>
    <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn--teal btn--sm">Edit</a>
    {% if is_granted('ROLE_ADMIN') and not user.deletedAt %}
      {% if user.hasDependents %}
        <span class="btn btn--ghost btn--sm" style="opacity:0.5;cursor:not-allowed;" title="Remove this member's dependents before deleting or archiving them.">Delete</span>
      {% elseif bookings is not empty or user.payments is not empty %}
        <form method="post" action="{{ path('app_admin_user_archive', {id: user.id}) }}"
              style="display:inline;"
              onsubmit="return (function(f){
                var reason = window.prompt('Why are you archiving {{ (displayName ?: user.email)|e('js') }}? This removes their personal details but keeps their booking/payment history.');
                if (!reason || !reason.trim()) return false;
                f.reason.value = reason;
                return true;
              })(this);">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('archive_user_' ~ user.id) }}">
          <input type="hidden" name="reason">
          <button type="submit" class="btn btn--danger btn--sm">Archive</button>
        </form>
      {% else %}
        <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"
              style="display:inline;"
              onsubmit="return confirm('Permanently delete {{ (displayName ?: user.email)|e('js') }}? This cannot be undone.');">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
          <button type="submit" class="btn btn--danger btn--sm">Delete</button>
        </form>
      {% endif %}
    {% endif %}
  </div>
</div>

{% if user.deletedAt %}
  <div class="duplicate-warning">
    <span class="duplicate-warning__icon"><i class="bi bi-archive-fill"></i></span>
    <span>
      This member was archived on {{ user.deletedAt|date('j M Y, H:i') }}{% if user.deletedBy %} by {{ (user.deletedBy.firstName ~ ' ' ~ user.deletedBy.lastName)|trim ?: user.deletedBy.email }}{% endif %}.
      Their personal details have been removed; their booking and payment history is kept below.
    </span>
  </div>
{% endif %}

{% if duplicates is not empty %}
  {% set dupeQuery = user.firstName ~ ' ' ~ user.lastName %}
  <div class="duplicate-warning">
    <span class="duplicate-warning__icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
    <span>
      {{ duplicates|length }} other {{ duplicates|length == 1 ? 'member' : 'members' }} found with the name <strong>{{ dupeQuery }}</strong>.
      <a href="{{ path('app_admin_users', {q: dupeQuery}) }}" class="duplicate-warning__link">View all matches</a>
    </span>
  </div>
{% endif %}

<div class="member-columns member-columns--thirds">
<div class="member-col-left">

<div class="card">
  <div class="detail-grid">
    <div>
      <div class="card__label">First name</div>
      <div class="card__value">{{ user.firstName ?: '—' }}</div>
    </div>
    <div>
      <div class="card__label">Last name</div>
      <div class="card__value">{{ user.lastName ?: '—' }}</div>
    </div>
    <div>
      <div class="card__label">Company</div>
      <div class="card__value">{{ user.company ?: '—' }}</div>
    </div>
    <div>
      <div class="card__label">Email</div>
      <div class="card__value">
        {% if user.email %}
          <a href="mailto:{{ user.email }}" style="color:var(--teal);">{{ user.email }}</a>
        {% elseif not user.email2 and not user.email3 %}
          —
        {% endif %}
        {% if user.email2 %}
          <br><a href="mailto:{{ user.email2 }}" style="color:var(--teal);font-size:0.85rem;">{{ user.email2 }}</a>
        {% endif %}
        {% if user.email3 %}
          <br><a href="mailto:{{ user.email3 }}" style="color:var(--teal);font-size:0.85rem;">{{ user.email3 }}</a>
        {% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Phone</div>
      <div class="card__value">
        {% if user.phone %}
          <a href="tel:{{ user.phone }}" style="color:var(--teal);">{{ user.phone }}</a>
        {% else %}—{% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Role</div>
      <div class="card__value">
        {% if 'ROLE_ADMIN' in user.roles %}
          <span class="role-pill role-pill--admin">Admin</span>
        {% elseif 'ROLE_TEAM' in user.roles %}
          <span class="role-pill role-pill--team">Team</span>
        {% else %}
          <span class="role-pill">Member</span>
        {% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Mailing list</div>
      <div class="card__value">{{ user.optIn ? 'Opted in' : 'Opted out' }}</div>
    </div>
    <div>
      <div class="card__label">Joined</div>
      <div class="card__value">{{ user.createdAt|date('j M Y') }}</div>
    </div>
    <div>
      <div class="card__label">Date of birth</div>
      <div class="card__value">{{ user.dateOfBirth ? user.dateOfBirth|date('j M Y') : '—' }}</div>
    </div>
  </div>
</div>

{% if user.addressLine1 or user.town or user.postcode %}
<div class="card">
  <div class="card__label" style="margin-bottom:0.6rem;">Address</div>
  <div class="card__value" style="line-height:1.8;">
    {% if user.addressLine1 %}<span>{{ user.addressLine1 }}</span><br>{% endif %}
    {% if user.addressLine2 %}<span>{{ user.addressLine2 }}</span><br>{% endif %}
    {% if user.town %}<span>{{ user.town }}</span><br>{% endif %}
    {% if user.postcode %}<span>{{ user.postcode }}</span>{% endif %}
  </div>
</div>
{% endif %}

{% if user.emergencyContactName or user.emergencyContactPhone %}
<div class="card">
  <div class="card__label" style="margin-bottom:0.6rem;">Emergency contact</div>
  <div class="card__value" style="line-height:1.8;">
    {% if user.emergencyContactName %}<span>{{ user.emergencyContactName }}</span><br>{% endif %}
    {% if user.emergencyContactPhone %}<a href="tel:{{ user.emergencyContactPhone }}" style="color:var(--teal);">{{ user.emergencyContactPhone }}</a>{% endif %}
  </div>
</div>
{% endif %}

{% if user.family is not empty %}
<div class="card" id="family">
  <div class="card__label" style="margin-bottom:0.6rem;">Family</div>
  <div class="card__value">
    {% for member in user.family %}
      {% set memberName = (member.firstName ~ ' ' ~ member.lastName)|trim ?: member.email %}
      {% set isParent = member == user.familyParent %}
      {% if member == user %}
        <span{% if isParent %} style="font-weight:700;"{% endif %}>{{ memberName }}</span>
      {% else %}
        <a href="{{ path('app_admin_user_show', {id: member.id}) }}" style="color:var(--teal);{% if isParent %} font-weight:700;{% endif %}">{{ memberName }}</a>
      {% endif %}
      {% if member == user and not isParent %}
        <form method="post" action="{{ path('app_admin_user_make_parent', {id: member.id}) }}"
              style="display:inline;"
              onsubmit="return confirm('Make {{ memberName|e('js') }} the parent of this family?');">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('make_parent_' ~ member.id) }}">
          <button type="submit" style="border:none;background:none;padding:0;font:inherit;font-size:0.75rem;color:var(--teal-dk);text-decoration:underline;cursor:pointer;">(make parent)</button>
        </form>
      {% endif %}
      {%- if not loop.last %}, {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

<div class="card">
  <div class="card__label" style="margin-bottom:0.6rem;">Tags</div>
  {% if user.tags is empty %}
    <span class="tag-badge--none">No tags assigned</span>
  {% else %}
    {% for tag in user.tags %}
      <span class="tag-badge">{{ tag.name }}</span>
    {% endfor %}
  {% endif %}
</div>

{% if user.memo %}
<div class="card">
  <div class="card__label" style="margin-bottom:0.5rem;">Memo</div>
  <div class="card__value" style="white-space:pre-wrap;line-height:1.7;">{{ user.memo }}</div>
</div>
{% endif %}

</div>
<div class="member-col-right">

{% set payments = user.payments|filter(p => p.status != 'pending') %}
{% set hasBookings = bookings is not empty %}
{% set hasPayments = payments is not empty %}
{% set hasSales = user.salesOrders is not empty %}
{% set hasCredits = user.creditLedgerEntries is not empty %}
{% set hasNotes = notes is not empty %}

{% set ownMembership = user.currentMembership %}
<div class="member-columns member-columns--halves" style="margin-bottom:1rem;">
  <div class="card" style="margin-bottom:0;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.6rem;">
      <div class="card__label" style="margin-bottom:0;">
        Certifications
      </div>

    </div>
    {% if user.certifications is empty %}
      <p style="color:var(--muted);font-size:0.875rem;">No certifications on record.</p>
    {% else %}
      <div style="display:flex;flex-direction:column;gap:0.6rem;">
        {% for record in user.certifications %}
          {% set pillClass = record.status == 'completed' ? ' status-pill--published' : (record.status == 'cancelled' ? ' status-pill--cancelled' : (record.status == 'pending_approval' ? ' status-pill--pending' : '')) %}
          <div style="border-left:3px solid var(--border);padding:0.4rem 0.75rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
              <span style="font-size:0.9375rem;">{{ record.certification.name }}</span>
              <span class="status-pill{{ pillClass }}">{{ record.statusLabel }}</span>
            </div>
            <p style="font-size:0.78rem;color:var(--muted);margin-top:0.2rem;">
              {% if record.status == 'completed' %}
                Approved {{ record.approvedAt|date('d M Y') }}
              {% else %}
                Started {{ record.startedAt|date('d M Y') }}
                {% if record.submitted %} · Submitted {{ record.completedAt|date('d M Y') }}{% endif %}
              {% endif %}
              {% if is_granted('ROLE_ADMIN') %}
                · <a href="{{ path('app_admin_user_certification_edit', {id: user.id, recordId: record.id}) }}" style="color:var(--teal-dk);font-weight:600;">Edit</a>
              {% endif %}
            </p>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}
      <br>
      <a href="{{ path('app_admin_user_certification_pick', {id: user.id}) }}" class="btn btn--teal btn--sm">+ Add certification</a>
    {% endif %}
  </div>

  <div class="card" style="margin-bottom:0;">
    <div class="card__label" style="margin-bottom:0.6rem;">Membership</div>
    {% if ownMembership %}
      {% set pillClass = ownMembership.status == 'active' ? ' status-pill--published' : ' status-pill--pending' %}
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.6rem;">
        <span style="font-size:0.9375rem;">{{ ownMembership.membershipType.name }}</span>
        <span class="status-pill{{ pillClass }}">{{ ownMembership.statusLabel }}</span>
      </div>
      <div class="detail-grid">
        <div>
          <div class="card__label">Created</div>
          <div class="card__value">{{ ownMembership.createdAt|date('d M Y') }}</div>
        </div>
        <div>
          <div class="card__label">Expires</div>
          <div class="card__value">{{ ownMembership.expiresAt ? ownMembership.expiresAt|date('d M Y') : 'Never' }}</div>
        </div>
      </div>
      <p style="font-size:0.8rem;color:var(--muted);margin-top:0.6rem;">
        £{{ ownMembership.price }}{% if ownMembership.paidAmount != '0.00' %} · Paid £{{ ownMembership.paidAmount }}{% endif %}
        {%- if ownMembership.autoRenew %} · Auto-renews{% endif %}
      </p>
      {% if is_granted('ROLE_ADMIN') %}
        <form method="post" action="{{ path('app_admin_user_membership_cancel', {id: user.id}) }}" style="margin-top:0.75rem;"
              onsubmit="return confirm('Cancel this membership?');">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('cancel_membership_' ~ ownMembership.id) }}">
          <button type="submit" class="btn btn--danger btn--sm">Cancel membership</button>
        </form>
      {% endif %}
    {% else %}
      {% if user.parent and user.parent.currentMembership %}
        {% set inherited = user.parent.currentMembership %}
        {% set parentName = (user.parent.firstName ~ ' ' ~ user.parent.lastName)|trim ?: user.parent.email %}
        <p style="font-size:0.875rem;margin-bottom:0.75rem;">
          Inherits <strong>{{ inherited.membershipType.name }}</strong> from
          <a href="{{ path('app_admin_user_show', {id: user.parent.id}) }}" style="color:var(--teal);">{{ parentName }}</a>
          <span class="status-pill{{ inherited.status == 'active' ? ' status-pill--published' : ' status-pill--pending' }}">{{ inherited.statusLabel }}</span>
        </p>
      {% else %}
        <p style="color:var(--muted);font-size:0.875rem;margin-bottom:0.75rem;">No membership on record.</p>
      {% endif %}
      <form method="post" action="{{ path('app_admin_sale_new', {userId: user.id}) }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_sale_new_' ~ user.id) }}">
        <button type="submit" class="btn btn--teal btn--sm">+ Add membership</button>
      </form>
    {% endif %}
  </div>
</div>

<div class="card">
  <div class="pos-tabs" id="member-tabs">
    <button type="button" class="pos-tab" data-tab="bookings" data-has-content="{{ hasBookings ? '1' : '0' }}">Bookings</button>
    <button type="button" class="pos-tab" data-tab="sales" data-has-content="{{ hasSales ? '1' : '0' }}">Sales</button>
    <button type="button" class="pos-tab" data-tab="payments" data-has-content="{{ hasPayments ? '1' : '0' }}">Payments</button>
    <button type="button" class="pos-tab" data-tab="credits" data-has-content="{{ hasCredits ? '1' : '0' }}">Credit transactions</button>
    <button type="button" class="pos-tab" data-tab="notes" data-has-content="{{ hasNotes ? '1' : '0' }}" data-has-pinned="{{ notes|filter(n => n.pinned) is not empty ? '1' : '0' }}">Notes</button>
  </div>

  <div class="tab-panel" data-tab-panel="bookings">
    <div style="display:flex;align-items:center;justify-content:flex-end;margin-bottom:0.75rem;">
      <a href="{{ path('app_admin_booking_new', {userId: user.id}) }}" class="btn btn--teal btn--sm">+ Check in</a>
    </div>
    {% if bookings is empty %}
      <p style="color:var(--muted);font-size:0.875rem;">No bookings yet.</p>
    {% else %}
      <div class="table-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Event</th>
              <th>Date</th>
              <th>Price</th>
              <th>Paid</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for booking in bookings %}
              {% set pillClass = booking.status == 'confirmed' ? ' status-pill--published' : (booking.status == 'cancelled' ? ' status-pill--cancelled' : '') %}
              <tr>
                <td>
                  <a href="{{ path('app_admin_event_show', booking.event.isRecurring ? {id: booking.event.id, date: (booking.occurrenceDate ?? booking.event.date)|date('Y-m-d')} : {id: booking.event.id}) }}" class="admin-table__link">
                    {{ booking.event.title }}
                  </a>
                </td>
                <td class="admin-table__muted">{{ (booking.occurrenceDate ?? booking.event.date)|date('d M Y') }}</td>
                <td class="admin-table__muted">{{ booking.effectivePrice ? '£' ~ booking.effectivePrice : 'Free' }}</td>
                <td class="admin-table__muted">{{ booking.paidAmount != '0.00' ? '£' ~ booking.paidAmount : '—' }}</td>
                <td><span class="status-pill{{ pillClass }}">{{ booking.status|capitalize }}</span></td>
                <td><a href="{{ path('app_admin_booking_edit', {id: booking.id}) }}" class="admin-table__link">Edit</a></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  <div class="tab-panel" data-tab-panel="sales" style="display:none;">
    {% if user.salesOrders is empty %}
      <p style="color:var(--muted);font-size:0.875rem;">No sales yet.</p>
    {% else %}
      <div class="table-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Status</th>
              <th style="text-align:right;">Total</th>
              <th>Created</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for order in user.salesOrders %}
              {% set pillClass = order.status == 'complete' ? 'status-pill--published' : (order.status == 'cancelled' ? 'status-pill--cancelled' : 'status-pill--pending') %}
              <tr>
                <td class="admin-table__muted">#{{ order.id }}</td>
                <td><span class="status-pill {{ pillClass }}">{{ order.statusLabel }}</span></td>
                <td class="admin-table__muted" style="text-align:right;">£{{ order.total }}</td>
                <td class="admin-table__muted">{{ order.createdAt|date('d M Y H:i') }}</td>
                <td>
                  <a href="{{ path('app_admin_sale_show', {id: order.id}) }}" class="admin-table__link">
                    {{ order.status == 'draft' ? 'Continue' : 'View' }}
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  <div class="tab-panel" data-tab-panel="payments" style="display:none;">
    {% if payments is empty %}
      <p style="color:var(--muted);font-size:0.875rem;">No payments yet.</p>
    {% else %}
      <div class="table-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Method</th>
              <th>Amount</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for payment in payments %}
              {% set pillClass = payment.status == 'succeeded' ? ' status-pill--published' : (payment.status in ['failed'] ? ' status-pill--cancelled' : (payment.status in ['refunded', 'partially_refunded'] ? ' status-pill--pending' : '')) %}
              <tr>
                <td class="admin-table__muted">{{ payment.createdAt|date('d M Y, H:i') }}</td>
                <td class="admin-table__muted">
                  {% if payment.order %}
                    <a href="{{ path('app_admin_sale_show', {id: payment.order.id}) }}" class="admin-table__link">Sale #{{ payment.order.id }}</a>
                  {% elseif payment.attendee %}
                    Booking
                  {% else %}
                    Donation
                  {% endif %}
                </td>
                <td class="admin-table__muted">{{ payment.method|capitalize }}</td>
                <td class="admin-table__muted">
                  £{{ payment.amount }}
                  {% if payment.refunds is not empty %}
                    {% for refund in payment.refunds %}
                      <br><span style="font-size:0.78rem;">↳ Refund £{{ refund.amount }} ({{ refund.statusLabel }}){% if refund.reason %} — {{ refund.reason }}{% endif %}</span>
                    {% endfor %}
                  {% endif %}
                </td>
                <td><span class="status-pill{{ pillClass }}">{{ payment.statusLabel }}</span></td>
                <td>
                  {% if payment.status in ['succeeded', 'partially_refunded'] %}
                    <a href="#" onclick="document.getElementById('refund-form-{{ payment.id }}').style.display = 'flex'; this.hidden = true; return false;"
                       class="admin-table__link">Refund</a>
                    <form id="refund-form-{{ payment.id }}" method="post" action="{{ path('app_admin_payment_refund', {id: payment.id}) }}"
                          style="display:none;gap:0.4rem;align-items:center;margin-top:0.5rem;"
                          onsubmit="return confirm('Issue this refund?');">
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('refund_payment_' ~ payment.id) }}">
                      <span style="font-size:0.8rem;color:var(--muted);">£</span>
                      <input type="number" name="amount" step="0.01" min="0.01" max="{{ payment.remainingRefundable }}"
                             value="{{ payment.remainingRefundable }}" style="width:5.5rem;" class="form-control">
                      <input type="text" name="reason" placeholder="Reason (optional)" class="form-control" style="flex:1;min-width:80px;">
                      <button type="submit" class="btn btn--ghost btn--sm">Refund</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  <div class="tab-panel" data-tab-panel="credits" style="display:none;">
    {% if user.creditBalance > 0 %}
      <div style="margin-bottom:1rem;">
        <div class="card__label" style="margin-bottom:0.3rem;">Available balance</div>
        <div style="font-size:1.75rem;font-weight:600;color:var(--teal-dk);">{{ user.creditBalance }}</div>
      </div>
    {% endif %}
    {% if hasCredits %}
      <div class="table-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Change</th>
              <th>Reason</th>
              <th>Note</th>
              <th>By</th>
            </tr>
          </thead>
          <tbody>
            {% for entry in user.creditLedgerEntries %}
              <tr>
                <td class="admin-table__muted">{{ entry.createdAt|date('d M Y, H:i') }}</td>
                <td style="{{ entry.creditChange > 0 ? 'color:var(--green);' : 'color:var(--red);' }}font-weight:600;">
                  {{ entry.creditChange > 0 ? '+' : '' }}{{ entry.creditChange }}
                </td>
                <td class="admin-table__muted">{{ entry.reason|capitalize }}</td>
                <td class="admin-table__muted">{{ entry.note ?: '—' }}</td>
                <td class="admin-table__muted">
                  {{ entry.createdBy ? ((entry.createdBy.firstName ~ ' ' ~ entry.createdBy.lastName)|trim ?: entry.createdBy.email) : 'System' }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p style="color:var(--muted);font-size:0.875rem;">No credit transactions yet.</p>
    {% endif %}
  </div>


  <div class="tab-panel" data-tab-panel="notes" style="display:none;">
    {% include 'admin/_notes_panel.html.twig' with {notes: notes, noteableType: 'member', noteableId: user.id} %}
  </div>
</div>

</div>
</div>
{% endblock %}

{% block scripts %}
<script>
  (function () {
    const tabs   = document.querySelectorAll('#member-tabs .pos-tab');
    const panels = document.querySelectorAll('.tab-panel');

    function selectTab(tab) {
      tabs.forEach(t => t.classList.toggle('is-active', t.dataset.tab === tab));
      panels.forEach(p => p.style.display = p.dataset.tabPanel === tab ? '' : 'none');
    }

    tabs.forEach(t => t.addEventListener('click', () => selectTab(t.dataset.tab)));

    // Default to the first tab that actually has something in it — but a tab with a pinned note
    // wins over that, since a pin means something needs attention right now.
    let defaultTab = tabs[0] ? tabs[0].dataset.tab : null;
    for (const tab of tabs) {
      if (tab.dataset.hasContent === '1') {
        defaultTab = tab.dataset.tab;
        break;
      }
    }
    for (const tab of tabs) {
      if (tab.dataset.hasPinned === '1') {
        defaultTab = tab.dataset.tab;
        break;
      }
    }
    if (defaultTab) selectTab(defaultTab);
  })();
</script>
{% endblock %}
