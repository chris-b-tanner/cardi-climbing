{% extends 'admin/base.html.twig' %}
{% block title %}People{% endblock %}

{% block content %}
<div class="page-header">
  <h1>{{ context == 'new_sale' ? 'Choose a person' : 'People' }}</h1>
  {% if context == 'new_sale' %}
    <a href="{{ path('app_admin_sales') }}" class="btn btn--ghost btn--sm">← Cancel</a>
  {% else %}
    <div class="btn-row">
      <a href="{{ path('app_admin_email_compose') }}" class="btn btn--ghost btn--sm">Send bulk email</a>
      <a href="{{ path('app_admin_user_new') }}" class="btn btn--teal btn--sm">+ New person</a>
    </div>
  {% endif %}
</div>

<div class="filter-form">
  <input type="search" id="search-q" placeholder="Search name or email…"
         value="{{ currentQuery }}" aria-label="Search members" autocomplete="off" autofocus>
  <select id="search-tag" aria-label="Filter by tag">
    <option value="">All tags</option>
    {% for tag in tags %}
      <option value="{{ tag.id }}"{% if currentTagId == tag.id %} selected{% endif %}>{{ tag.name }}</option>
    {% endfor %}
  </select>
  {% if context != 'new_sale' %}
    <div style="margin-left:auto;display:flex;gap:0.5rem;">
      <a id="print-link" href="{{ path('app_admin_users_print') }}" target="_blank" rel="noopener" class="btn btn--ghost btn--sm"><i class="bi bi-printer"></i> Print</a>
      <a id="csv-link" href="{{ path('app_admin_users_export') }}" class="btn btn--ghost btn--sm"><i class="bi bi-file-earmark-spreadsheet"></i> Export CSV</a>
    </div>
  {% endif %}
</div>

<div id="tag-description" style="display:none;font-size:0.85rem;color:var(--muted);background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:0.6rem 0.85rem;margin-top:-0.5rem;margin-bottom:1rem;"></div>

{% if context != 'new_sale' %}
<div id="merge-toolbar" style="display:none;" class="merge-toolbar">
  <span id="merge-count" class="merge-count"></span>
  <a id="merge-btn" href="#" class="btn btn--teal btn--sm">Merge selected</a>
  <button type="button" id="merge-clear" class="btn btn--ghost btn--sm">Clear selection</button>
</div>
{% endif %}

<div id="results">
  {% include 'admin/users/_list.html.twig' %}
</div>
{% endblock %}

{% block scripts %}
<style>
  .merge-check {
    width: 1.1rem; height: 1.1rem; accent-color: var(--teal); cursor: pointer;
  }
  .merge-toolbar {
    display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;
    background: #e0f2fe; border: 1px solid #7dd3fc;
    border-radius: var(--radius); padding: 0.6rem 0.9rem;
    margin-bottom: 0.75rem;
  }
  .merge-count { font-size: 0.875rem; font-weight: 500; color: #0369a1; }
</style>
<script>
  const searchInput   = document.getElementById('search-q');
  const tagSelect     = document.getElementById('search-tag');
  const tagDescBox    = document.getElementById('tag-description');
  const tagDescriptions = {{ tagDescriptions|json_encode|raw }};
  const results     = document.getElementById('results');
  const toolbar     = document.getElementById('merge-toolbar');
  const mergeBtn    = document.getElementById('merge-btn');
  const mergeCount  = document.getElementById('merge-count');
  const mergeClear  = document.getElementById('merge-clear');
  const endpoint    = '{{ path('app_admin_users') }}';
  const mergeUrl    = '{{ path('app_admin_user_merge') }}';
  const printLink   = document.getElementById('print-link');

  // `autofocus` alone can leave the cursor at the start when the field is pre-filled
  // (e.g. returning to this page with a query already applied) — put it at the end instead.
  const searchLen = searchInput.value.length;
  searchInput.setSelectionRange(searchLen, searchLen);
  const csvLink     = document.getElementById('csv-link');
  const printBaseUrl = {{ context != 'new_sale' ? path('app_admin_users_print')|json_encode|raw : 'null' }};
  const csvBaseUrl    = {{ context != 'new_sale' ? path('app_admin_users_export')|json_encode|raw : 'null' }};
  let debounce;

  let currentSort = {{ currentSort|json_encode|raw }};
  let currentDir  = {{ currentDir|json_encode|raw }};
  const context   = {{ context|json_encode|raw }};
  const eventId        = {{ eventId|json_encode|raw }};
  const occurrenceDate = {{ occurrenceDate|json_encode|raw }};

  const selected = new Set();

  function syncCheckboxes() {
    results.querySelectorAll('.merge-check').forEach(cb => {
      const id = cb.value;
      cb.checked = selected.has(id);
      cb.closest('tr').classList.toggle('is-selected', selected.has(id));
    });
  }

  function updateToolbar() {
    const count = selected.size;
    toolbar.style.display = count > 0 ? 'flex' : 'none';
    if (count === 2) {
      const ids = [...selected];
      mergeBtn.href = `${mergeUrl}?ids[]=${ids[0]}&ids[]=${ids[1]}`;
      mergeBtn.style.pointerEvents = '';
      mergeBtn.style.opacity = '';
      mergeCount.textContent = '2 members selected';
    } else {
      mergeBtn.href = '#';
      mergeBtn.style.pointerEvents = 'none';
      mergeBtn.style.opacity = '0.45';
      mergeCount.textContent = count === 1
        ? '1 member selected — select one more to merge'
        : `${count} selected — select exactly 2 to merge`;
    }
  }

  function attachCheckboxListeners() {
    results.querySelectorAll('.merge-check').forEach(cb => {
      cb.addEventListener('change', () => {
        if (cb.checked) selected.add(cb.value); else selected.delete(cb.value);
        cb.closest('tr').classList.toggle('is-selected', cb.checked);
        updateToolbar();
      });
    });
  }

  function updateTagDescription() {
    const description = tagDescriptions[tagSelect.value];
    if (tagSelect.value && description) {
      tagDescBox.textContent = description;
      tagDescBox.style.display = '';
    } else {
      tagDescBox.style.display = 'none';
    }
  }

  function fetchResults() {
    const params = new URLSearchParams();
    if (searchInput.value) params.set('q', searchInput.value);
    if (tagSelect.value)   params.set('tag', tagSelect.value);
    if (currentSort !== 'name') params.set('sort', currentSort);
    if (currentDir !== 'asc')   params.set('dir', currentDir);
    if (context) params.set('context', context);
    if (eventId) params.set('eventId', eventId);
    if (occurrenceDate) params.set('occurrenceDate', occurrenceDate);

    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);

    // Print/CSV only ever need q/tag/sort/dir — in the non-new_sale context where they're shown,
    // context/eventId/occurrenceDate are never set on `params` in the first place, so `qs` is
    // already exactly that filter set.
    if (printLink) printLink.href = `${printBaseUrl}${qs ? '?' + qs : ''}`;
    if (csvLink)   csvLink.href   = `${csvBaseUrl}${qs ? '?' + qs : ''}`;

    fetch(`${endpoint}${qs ? '?' + qs : ''}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
      .then(r => r.text())
      .then(html => {
        results.innerHTML = html;
        syncCheckboxes();
        attachCheckboxListeners();
      });
  }

  if (mergeClear) {
    mergeClear.addEventListener('click', () => {
      selected.clear();
      syncCheckboxes();
      updateToolbar();
    });
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(fetchResults, 300);
  });

  tagSelect.addEventListener('change', () => {
    updateTagDescription();
    fetchResults();
  });
  updateTagDescription();

  // Sortable column headers — delegated since the table is replaced on every fetch.
  results.addEventListener('click', (e) => {
    const th = e.target.closest('.admin-table__sortable');
    if (!th) return;

    const col = th.dataset.sort;
    currentDir  = (currentSort === col && currentDir === 'asc') ? 'desc' : 'asc';
    currentSort = col;
    fetchResults();
  });

  // Wire up checkboxes on initial load
  attachCheckboxListeners();
</script>
{% endblock %}
