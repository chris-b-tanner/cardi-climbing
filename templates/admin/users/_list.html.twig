<div class="result-count">{{ users|length }} {{ users|length == 1 ? 'member' : 'members' }}</div>

{% if users is empty %}
  <div class="empty">
    <strong>No members found</strong>
    Try adjusting your search or filter.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          {% if is_granted('ROLE_ADMIN') %}<th class="admin-table__check"><span class="sr-only">Select</span></th>{% endif %}
          <th>ID</th>
          <th>Name</th>
          <th>Email</th>
          <th>Tags</th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
          {% set displayName = (user.firstName ~ ' ' ~ user.lastName)|trim %}
          <tr>
            {% if is_granted('ROLE_ADMIN') %}
              <td class="admin-table__check">
                <label title="Select for merge">
                  <input type="checkbox" class="merge-check" value="{{ user.id }}">
                </label>
              </td>
            {% endif %}
            <td class="admin-table__muted">#{{ user.id }}</td>
            <td>
              <a href="{{ path('app_admin_user_show', {id: user.id}) }}" class="admin-table__link">
                {{ displayName ?: '—' }}
              </a>
              {% if user.parent %}
                <a href="{{ path('app_admin_user_show', {id: user.parent.id}) }}#family" class="family-icon"
                   title="Dependent of {{ (user.parent.firstName ~ ' ' ~ user.parent.lastName)|trim ?: user.parent.email }}"><i class="bi bi-people-fill"></i></a>
              {% elseif user.id in parentIds %}
                <a href="{{ path('app_admin_user_show', {id: user.id}) }}#family" class="family-icon"
                   title="Has dependents"><i class="bi bi-people-fill"></i></a>
              {% endif %}
            </td>
            <td class="admin-table__muted">{{ user.email ?: '—' }}</td>
            <td>
              {% for tag in user.tags %}
                <span class="tag-badge">{{ tag.name }}</span>
              {% else %}
                <span class="admin-table__muted">—</span>
              {% endfor %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
