<div class="result-count">{{ users|length }} {{ users|length == 1 ? 'member' : 'members' }}</div>

{% if users is empty %}
  <div class="empty">
    <strong>No members found</strong>
    Try adjusting your search or filter.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          {% if context != 'new_sale' and is_granted('ROLE_ADMIN') %}<th class="admin-table__check"><span class="sr-only">Select</span></th>{% endif %}
          {% for col, label in {name: 'Name', email: 'Email'} %}
            <th class="admin-table__sortable{{ currentSort == col ? ' is-sorted' : '' }}" data-sort="{{ col }}">
              {{ label }}
              {% if currentSort == col %}
                <span class="admin-table__sort-arrow">{{ currentDir == 'desc' ? '▼' : '▲' }}</span>
              {% endif %}
            </th>
          {% endfor %}
          <th>Tags</th>
          <th class="admin-table__memo-col">Memo</th>
          {% if context == 'new_sale' %}<th></th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
          {% set displayName = user.displayName %}
          <tr>
            {% if context != 'new_sale' and is_granted('ROLE_ADMIN') %}
              <td class="admin-table__check">
                <label title="Select for merge">
                  <input type="checkbox" class="merge-check" value="{{ user.id }}">
                </label>
              </td>
            {% endif %}
            <td>
              {% set avatarUrl = avatar_url(user) %}
              <div style="display:flex;align-items:center;gap:0.5rem;">
                {% if avatarUrl %}
                  <img src="{{ avatarUrl }}" alt="" style="flex-shrink:0;width:1.75rem;height:1.75rem;border-radius:50%;object-fit:cover;">
                {% else %}
                  <span style="flex-shrink:0;width:1.75rem;height:1.75rem;border-radius:50%;background:#eef2f1;color:var(--teal);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;">
                    {{ (displayName ?: user.email)|slice(0, 1)|upper }}
                  </span>
                {% endif %}
                <div>
                  <a href="{{ path('app_admin_user_show', {id: user.id}) }}" class="admin-table__link">
                    {{ displayName ?: '—' }}
                  </a>
                  {% if user.parent %}
                    <a href="{{ path('app_admin_user_show', {id: user.parent.id}) }}#family" class="family-icon"
                       title="Dependent of {{ user.parent.displayName }}"><i class="bi bi-people-fill"></i></a>
                  {% elseif user.id in parentIds %}
                    <a href="{{ path('app_admin_user_show', {id: user.id}) }}#family" class="family-icon"
                       title="Has dependents"><i class="bi bi-people-fill"></i></a>
                  {% endif %}
                  {% if user.company %}
                    <div class="admin-table__muted" style="font-size:0.78rem;">{{ user.company }}</div>
                  {% endif %}
                </div>
              </div>
            </td>
            <td class="admin-table__muted">
              {{ user.email ?: '—' }}
              {% if user.phone %}
                <div style="font-size:0.78rem;">{{ user.phone|uk_phone }}</div>
              {% endif %}
            </td>
            <td>
              {% for tag in user.tags %}
                <span class="tag-badge" style="background:color-mix(in srgb, {{ tag.effectiveColor }} 15%, white); color:{{ tag.effectiveColor }};">{{ tag.name }}</span>
              {% else %}
                <span class="admin-table__muted">—</span>
              {% endfor %}
            </td>
            <td class="admin-table__memo-col admin-table__muted" style="font-size:0.78rem;max-width:240px;">{{ user.memo ?: '—' }}</td>
            {% if context == 'new_sale' %}
              {% set saleNewParams = {userId: user.id} %}
              {% if eventId %}{% set saleNewParams = saleNewParams|merge({eventId: eventId}) %}{% endif %}
              {% if occurrenceDate %}{% set saleNewParams = saleNewParams|merge({occurrenceDate: occurrenceDate}) %}{% endif %}
              <td>
                <form method="post" action="{{ path('app_admin_sale_new', saleNewParams) }}" style="margin:0;">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_sale_new_' ~ user.id) }}">
                  <button type="submit" class="btn btn--teal btn--sm">Choose</button>
                </form>
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
