{#
  Generic "choose a contact" modal — search (defaulting to a member's dependents, if any) or quick-create
  a new person. Include once per page with `{% include 'admin/_contact_picker_modal.html.twig' %}`, then
  call `ContactPicker.open({ title, dependentsOfId, dependentsOfName, onChoose(id, label) })` from that
  page's own script (see admin/events/show.html.twig for an example).
#}
<div id="contact-picker-modal" class="pos-modal" style="display:none;"
     data-search-url="{{ path('app_admin_contact_search') }}"
     data-create-url="{{ path('app_admin_contact_new') }}"
     data-csrf="{{ csrf_token('contact_picker_create') }}">
  <div id="contact-picker-backdrop" class="pos-modal__backdrop"></div>
  <div class="pos-modal__box">
    <div class="pos-modal__header">
      <strong id="contact-picker-title">Choose a contact</strong>
      <button type="button" id="contact-picker-close" class="btn btn--ghost btn--sm">✕</button>
    </div>

    <div id="contact-picker-search-view">
      <input type="text" id="contact-picker-search" class="form-control" placeholder="Search members…"
             autocomplete="off" style="margin-bottom:0.75rem;">
      <div id="contact-picker-results" style="display:flex;flex-direction:column;gap:0.3rem;max-height:260px;overflow-y:auto;"></div>
      <button type="button" id="contact-picker-create-toggle" class="btn btn--ghost btn--sm" style="margin-top:0.75rem;">+ Create new person</button>
    </div>

    <div id="contact-picker-create-view" style="display:none;">
      <div class="form-group">
        <label for="contact-picker-firstName">First name</label>
        <input type="text" id="contact-picker-firstName" class="form-control" autocomplete="off" required>
      </div>
      <div class="form-group">
        <label for="contact-picker-lastName">Last name</label>
        <input type="text" id="contact-picker-lastName" class="form-control" autocomplete="off">
      </div>
      <div class="form-group">
        <label for="contact-picker-email">Email</label>
        <input type="email" id="contact-picker-email" class="form-control" autocomplete="off">
      </div>
      <div class="form-group">
        <label for="contact-picker-dateOfBirth">Date of birth</label>
        <input type="date" id="contact-picker-dateOfBirth" class="form-control" autocomplete="off">
      </div>
      <label id="contact-picker-dependent-label" style="display:none;align-items:center;gap:0.5rem;font-weight:normal;margin-bottom:1rem;">
        <input type="checkbox" id="contact-picker-makeDependent" style="width:auto;">
        <span id="contact-picker-dependent-text"></span>
      </label>
      <p id="contact-picker-error" class="flash flash--error" style="display:none;"></p>
      <div class="btn-row">
        <button type="button" id="contact-picker-create-submit" class="btn btn--teal btn--sm">Create and use</button>
        <button type="button" id="contact-picker-create-cancel" class="btn btn--ghost btn--sm">← Back to search</button>
      </div>
    </div>
  </div>
</div>
