{% extends 'admin/base.html.twig' %}
{% block title %}Certifications{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Certifications</h1>
</div>

<div class="filter-form">
  <input type="search" id="search-q" placeholder="Search member, email, or certification…"
         value="{{ currentQuery }}" aria-label="Search certifications" autocomplete="off">
  <select id="search-status" aria-label="Filter by status">
    <option value="">All statuses</option>
    <option value="in_progress"{% if currentStatus == 'in_progress' %} selected{% endif %}>In progress</option>
    <option value="pending_approval"{% if currentStatus == 'pending_approval' %} selected{% endif %}>Pending approval</option>
    <option value="completed"{% if currentStatus == 'completed' %} selected{% endif %}>Completed</option>
    <option value="cancelled"{% if currentStatus == 'cancelled' %} selected{% endif %}>Cancelled</option>
  </select>
</div>

<div id="results">
  {% include 'admin/certifications/_list.html.twig' %}
</div>
{% endblock %}

{% block scripts %}
<script>
  const searchInput  = document.getElementById('search-q');
  const statusSelect = document.getElementById('search-status');
  const results      = document.getElementById('results');
  const endpoint      = '{{ path('app_admin_certifications') }}';
  let debounce;

  function fetchResults() {
    const params = new URLSearchParams();
    if (searchInput.value)  params.set('q', searchInput.value);
    if (statusSelect.value) params.set('status', statusSelect.value);

    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);

    fetch(`${endpoint}${qs ? '?' + qs : ''}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
      .then(r => r.text())
      .then(html => { results.innerHTML = html; });
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(fetchResults, 300);
  });
  statusSelect.addEventListener('change', fetchResults);
</script>
{% endblock %}
