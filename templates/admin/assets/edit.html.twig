{% extends 'admin/base.html.twig' %}
{% block title %}Edit {{ asset.name }} — Assets{% endblock %}

{% block content %}
<div class="page-header">
  <h1><a href="{{ path('app_admin_assets') }}" class="page-header__crumb">Assets</a> &raquo; <a href="{{ path('app_admin_asset_show', {id: asset.id}) }}" class="page-header__crumb">{{ asset.name }}</a> &raquo; Edit</h1>
  <a href="{{ path('app_admin_asset_show', {id: asset.id}) }}" class="btn btn--ghost btn--sm">← Cancel</a>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_asset_edit', {id: asset.id}) }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_asset_edit_' ~ asset.id) }}">

  {% include 'admin/assets/_form.html.twig' with {isNew: false} %}

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Save changes</button>
    <a href="{{ path('app_admin_asset_show', {id: asset.id}) }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>
{% endblock %}
