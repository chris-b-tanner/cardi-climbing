{% extends 'admin/base.html.twig' %}
{% block title %}Activity{% endblock %}

{% block content %}
<style>
  .activity { --lvl0: #ebedf0; --lvl1: #9be9a8; --lvl2: #40c463; --lvl3: #30a14e; --lvl4: #216e39; }
  .activity-scroll { overflow-x: auto; }
  .activity-grid { border-collapse: separate; border-spacing: 3px; font-size: 0.8rem; }
  .activity-grid th { font-weight: 600; color: var(--muted); white-space: nowrap; }
  .activity-grid thead th { font-size: 0.7rem; text-align: center; line-height: 1.2; padding-bottom: 0.25rem; }
  .activity-grid thead th.is-weekend { opacity: 0.6; }
  .activity-grid thead th.is-today { color: var(--black); }
  .activity-grid tbody th { text-align: left; padding-right: 0.75rem; color: var(--black); font-weight: 500; }
  .activity-grid td.cell {
    width: 2rem; min-width: 2rem; height: 2rem; text-align: center; border-radius: 3px;
    background: var(--lvl0); color: transparent; font-size: 0.7rem; font-weight: 600;
    box-shadow: inset 0 0 0 1px rgba(27,31,35,0.06);
  }
  .activity-grid td.cell:hover { color: var(--black); }
  .activity-grid td.cell.lvl1 { background: var(--lvl1); }
  .activity-grid td.cell.lvl2 { background: var(--lvl2); }
  .activity-grid td.cell.lvl3 { background: var(--lvl3); }
  .activity-grid td.cell.lvl4 { background: var(--lvl4); }
  .activity-grid td.cell.lvl3:hover, .activity-grid td.cell.lvl4:hover { color: #fff; }
  .activity-grid td.total, .activity-grid tfoot td { text-align: center; color: var(--muted); padding: 0 0.5rem; }
  .activity-grid tfoot th, .activity-grid tfoot td { padding-top: 0.35rem; font-size: 0.72rem; }
  .activity-legend { display: flex; align-items: center; gap: 3px; font-size: 0.75rem; color: var(--muted); margin-top: 1rem; }
  .activity-legend span.sw { width: 12px; height: 12px; border-radius: 2px; box-shadow: inset 0 0 0 1px rgba(27,31,35,0.06); }
</style>

<div class="page-header">
  <h1><a href="{{ path('app_admin_users') }}" class="page-header__crumb">People</a> &raquo; Activity</h1>
  <a href="{{ path('app_admin_recent_updates') }}" class="btn btn--ghost btn--sm">Recent updates</a>
</div>

<p class="admin-table__muted" style="font-size:0.85rem;">
  Notes added by each team member per day over the last three weeks. Bulk email notes and system notes aren't counted.
</p>

  <br>

<div class="activity">
  <div class="activity-scroll">
    <table class="activity-grid">
      <thead>
        <tr>
          <th></th>
          {% for key, day in days %}
            {% set weekend = day|date('N') >= 6 %}
            <th class="{{ weekend ? 'is-weekend' : '' }}{{ key == today ? ' is-today' : '' }}" title="{{ day|date('l j F') }}">
              {{ day|date('D')|slice(0, 2) }}<br>{{ day|date('j') }}
            </th>
          {% endfor %}
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          <tr>
            <th scope="row"><a href="{{ path('app_admin_recent_updates', {addedBy: row.user.id}) }}">{{ row.user.displayName }}</a></th>
            {% for key, count in row.cells %}
              {% set level = count == 0 ? 0 : (max > 0 ? ((count / max * 4)|round(0, 'ceil')) : 0) %}
              <td class="cell lvl{{ level }}" title="{{ count }} note{{ count == 1 ? '' : 's' }} by {{ row.user.displayName }} on {{ days[key]|date('D j M') }}">{{ count ?: '' }}</td>
            {% endfor %}
            <td class="total">{{ row.total }}</td>
          </tr>
        {% else %}
          <tr><td colspan="{{ days|length + 2 }}">No team members found.</td></tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" style="text-align:left;">All</th>
          {% for key, total in dayTotals %}<td>{{ total }}</td>{% endfor %}
          <td>{{ dayTotals|reduce((a, b) => a + b, 0) }}</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="activity-legend">
    Less
    {% for l in 0..4 %}<span class="sw" style="background: var(--lvl{{ l }});"></span>{% endfor %}
    More
    {% if max > 0 %}<span style="margin-left:0.5rem;">(busiest day: {{ max }} note{{ max == 1 ? '' : 's' }})</span>{% endif %}
  </div>
</div>
{% endblock %}
