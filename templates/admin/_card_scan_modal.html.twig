{#
  Shared card-station link/verify/lookup modal — see card-setup.md. Opened by any
  `.{{ prefix }}-trigger` button carrying `data-url` (the arm/poll/cancel endpoint for this
  action — same URL, just a different HTTP method each time), `data-mode` ("link", "verify", or
  "lookup"), `data-csrf`, and (for link/verify only — lookup has no target member) `data-user-name`.
  `prefix` namespaces this instance's DOM ids in case more than one copy ever lands on the same
  page.
#}
<div id="{{ prefix }}-modal" class="pos-modal" style="display:none;">
  <div id="{{ prefix }}-modal-backdrop" class="pos-modal__backdrop"></div>
  <div class="pos-modal__box">
    <div class="pos-modal__header">
      <strong id="{{ prefix }}-title">Card station</strong>
      <button type="button" id="{{ prefix }}-modal-close" class="btn btn--ghost btn--sm">✕</button>
    </div>
    <p id="{{ prefix }}-message" style="font-size:0.9375rem;line-height:1.6;margin-bottom:0;"></p>
  </div>
</div>

<script>
  (function () {
    const prefix   = {{ prefix|json_encode|raw }};
    const modal    = document.getElementById(prefix + '-modal');
    const backdrop = document.getElementById(prefix + '-modal-backdrop');
    const closeBtn = document.getElementById(prefix + '-modal-close');
    const title    = document.getElementById(prefix + '-title');
    const message  = document.getElementById(prefix + '-message');

    let currentUrl  = null;
    let currentCsrf = null;
    let pollTimer   = null;

    function stopPolling() {
      if (pollTimer) {
        clearTimeout(pollTimer);
        pollTimer = null;
      }
    }

    function closeModal(cancel) {
      stopPolling();
      modal.style.display = 'none';

      if (cancel && currentUrl) {
        fetch(currentUrl, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ _csrf_token: currentCsrf }),
        }).catch(() => {});
      }

      currentUrl = null;
      currentCsrf = null;
    }

    function render(status, userName) {
      if (status.status === 'pending') {
        message.textContent = userName
          ? 'Waiting for a tap on the card station…'
          : 'Waiting for a tap on the card station… tap any registered card to find its member.';
      } else if (status.status === 'linked') {
        message.textContent = 'Card linked to ' + userName + '.';
      } else if (status.status === 'matched') {
        message.textContent = '✓ This card belongs to ' + userName + '.';
      } else if (status.status === 'mismatch') {
        message.textContent = status.matchedUserName
          ? '✗ This card is registered to ' + status.matchedUserName + ', not ' + userName + '. Nothing changed.'
          : '✗ This card isn\'t registered to anyone. Nothing changed.';
      } else if (status.status === 'conflict') {
        message.textContent = 'That card is already registered to another member. Nothing changed.';
      } else if (status.status === 'found') {
        message.textContent = '✓ Found ' + status.userName + ' — opening their contact page…';
      } else if (status.status === 'not_found') {
        message.textContent = 'That card isn\'t registered to anyone.';
      } else {
        message.textContent = 'Timed out — try again.';
      }
    }

    function poll(url, userName, onLinked, onFound) {
      fetch(url)
        .then(r => r.json())
        .then(status => {
          render(status, userName);

          if (status.status === 'pending') {
            pollTimer = setTimeout(() => poll(url, userName, onLinked, onFound), 1000);
            return;
          }

          stopPolling();
          currentUrl = null;
          currentCsrf = null;

          if (status.status === 'linked' && onLinked) {
            onLinked(status.cardUid);
          } else if (status.status === 'found' && onFound) {
            onFound(status.userId, status.userName);
          }
        })
        .catch(() => {
          message.textContent = 'Lost contact with the server — try again.';
          stopPolling();
        });
    }

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.' + prefix + '-trigger');
      if (!trigger) return;

      const url      = trigger.dataset.url;
      const mode     = trigger.dataset.mode;
      const userName = trigger.dataset.userName || null;
      const csrf     = trigger.dataset.csrf;
      const onLinked = trigger.dataset.onLinked && window[trigger.dataset.onLinked];
      const onFound  = trigger.dataset.onFound && window[trigger.dataset.onFound];

      currentUrl = url;
      currentCsrf = csrf;

      title.textContent = mode === 'verify' ? 'Verify card' : mode === 'lookup' ? 'Find by card' : 'Link card';
      message.textContent = 'Arming the card station…';
      modal.style.display = 'flex';

      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: mode, _csrf_token: csrf }),
      })
        .then(r => r.json().then(data => ({ ok: r.ok, data })))
        .then(({ ok, data }) => {
          if (!ok) {
            message.textContent = data.error || 'Could not start — try again.';
            currentUrl = null;
            currentCsrf = null;
            return;
          }
          poll(url, userName, onLinked, onFound);
        })
        .catch(() => {
          message.textContent = 'Could not reach the server — try again.';
          currentUrl = null;
          currentCsrf = null;
        });
    });

    closeBtn.addEventListener('click', () => closeModal(true));
    backdrop.addEventListener('click', () => closeModal(true));
  })();
</script>
