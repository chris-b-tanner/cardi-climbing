{% extends 'admin/base.html.twig' %}
{% block title %}Edit {{ certification.name }} — Settings{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Edit certification</h1>
  <a href="{{ path('app_admin_settings_certifications') }}" class="btn btn--ghost btn--sm">← Cancel</a>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_settings_certification_edit', {id: certification.id}) }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_certification_edit_' ~ certification.id) }}">

  <div class="card">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" class="form-control"
             value="{{ certification.name }}" autocomplete="off" required>
    </div>
    <div class="form-group" style="margin-bottom:0;">
      <label for="description">Description</label>
      <textarea id="description" name="description" class="form-control" rows="4"
                placeholder="Shown to admins when assigning this certification to a member…"
                style="resize:vertical;font-family:inherit;line-height:1.6;">{{ certification.description }}</textarea>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Save changes</button>
    <a href="{{ path('app_admin_settings_certifications') }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>
{% endblock %}
