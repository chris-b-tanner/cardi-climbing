{% extends 'admin/base.html.twig' %}
{% set pageTitle = email.id ? (email.draft ? 'Edit draft' : 'View email') : 'New draft' %}
{% block title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="page-header">
  <h1>{{ pageTitle }}</h1>
  <a href="{{ path('app_admin_settings_emails') }}" class="btn btn--ghost btn--sm">← Emails</a>
</div>

{% if email.id and email.sent %}
  <div class="card" style="margin-bottom:1.25rem;">
    <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;font-size:0.85rem;">
      <span class="status-pill status-pill--published">Sent</span>
      <span>
        {{ email.sentCount }} member(s) emailed on {{ email.sentAt|date('d M Y H:i') }}{% if email.sentBy %} by {{ email.sentBy.displayName }}{% endif %}
      </span>
    </div>
  </div>
{% endif %}

<div class="bulk-wrap">

  {# ── Left: compose ───────────────────────────────────────── #}
  <div class="bulk-compose">
    <form method="post" id="draft-form">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('email_draft') }}">

      <div class="card">
        <div class="card__label" style="margin-bottom:0.75rem;">Audience</div>
        {% if email.draft %}
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            {% if is_granted('ROLE_ADMIN') %}
              <label class="audience-option">
                <input type="radio" name="audienceType" value="all" id="aud-all"{% if email.audienceType != 'tags' %} checked{% endif %}>
                <span>All opted-in members <span class="audience-count">({{ totalOptedIn }})</span></span>
              </label>
            {% endif %}
            <label class="audience-option">
              <input type="radio" name="audienceType" value="tags" id="aud-tags"{% if email.audienceType == 'tags' or not is_granted('ROLE_ADMIN') %} checked{% endif %}>
              <span>Filter by tag</span>
            </label>
            <div id="tag-panel" style="{{ (email.audienceType == 'tags' or not is_granted('ROLE_ADMIN')) ? '' : 'display:none;' }}padding:0.5rem 0 0 1.6rem;">
              {% if tags is empty %}
                <p style="font-size:0.85rem;color:var(--muted);">No tags are set up yet — <a href="{{ path('app_admin_settings_tag_new') }}">create one</a> to use this audience.</p>
              {% else %}
                <div class="tag-grid" style="margin-bottom:0.5rem;">
                  {% for tag in tags %}
                    <input type="checkbox" id="etag_{{ tag.id }}" name="tagIds[]"
                           value="{{ tag.id }}" class="tag-check draft-tag"
                           {% if tag.id in email.tagIds %}checked{% endif %}>
                    <label for="etag_{{ tag.id }}" class="tag-check-label">{{ tag.name }}</label>
                  {% endfor %}
                </div>
                <div style="font-size:0.8rem;color:var(--muted);">
                  Recipients: <strong id="tag-count">0</strong> opted-in member(s)
                </div>
              {% endif %}
            </div>
          </div>
        {% else %}
          {# Read-only: audienceLabel already fully describes it, including audience types (a
             single member, an event's attendees, a certification's holders) this picker has no
             radio for at all — showing the interactive picker here would just guess wrong. #}
          <p style="font-size:0.9rem;margin:0;">{{ email.audienceLabel }}</p>
        {% endif %}
      </div>

      <div class="card">
        <div class="form-group" style="margin-bottom:1rem;">
          <label style="flex-direction:row;align-items:center;gap:0.5rem;display:flex;text-transform:none;font-size:0.875rem;color:var(--black);">
            <input type="checkbox" name="useBlankLayout" id="useBlankLayout" value="1"
                   style="width:1rem;height:1rem;accent-color:var(--teal);"
                   {% if email.useBlankLayout %}checked{% endif %}
                   {% if not email.draft %}disabled{% endif %}>
            Use blank (personal) layout instead of the Y Wal template
          </label>
        </div>
        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" class="form-control"
                 value="{{ email.subject }}" placeholder="Email subject…" required autocomplete="off"
                 {% if not email.draft %}disabled{% endif %}>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label for="body">Message</label>
          <textarea id="body" name="body" class="form-control" rows="16"
                    placeholder="Write your message here… HTML is allowed." required
                    style="resize:vertical;font-family:inherit;line-height:1.7;"
                    {% if not email.draft %}disabled{% endif %}>{{ email.body }}</textarea>
        </div>
      </div>

      {% if email.draft %}
        <div class="form-actions">
          <button type="submit" class="btn btn--teal">Save draft</button>
        </div>
      {% endif %}
    </form>

    {% if email.draft and email.id %}
      <form method="post" action="{{ path('app_admin_settings_email_send', {id: email.id}) }}" style="margin-top:0.75rem;"
            onsubmit="return confirm('Send &quot;' + {{ email.subject|json_encode|raw }} + '&quot; to ' + {{ email.audienceLabel|json_encode|raw }} + '? This cannot be undone.');">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('send_email_' ~ email.id) }}">
        <button type="submit" class="btn btn--ghost">Send this draft</button>
      </form>
      <p style="font-size:0.78rem;color:var(--muted);margin-top:0.5rem;">Save your changes first — sending uses whatever was last saved, not what's currently typed above.</p>
    {% endif %}
  </div>

  {# ── Right: preview ──────────────────────────────────────── #}
  <div class="bulk-preview">
    <div class="bulk-preview__label">Preview</div>
    <iframe id="preview-frame" class="bulk-preview__frame" srcdoc="<p style='padding:2rem;color:#aaa;font-family:sans-serif;'>Start typing to see a preview…</p>"></iframe>
  </div>

</div>
{% endblock %}

{% block scripts %}
<style>
  .bulk-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 720px) { .bulk-wrap { grid-template-columns: 1fr; } }
  .bulk-compose { min-width: 0; }
  .bulk-preview { position: sticky; top: 4rem; }
  .bulk-preview__label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.5rem; }
  .bulk-preview__frame { width: 100%; height: calc(100vh - 8rem); border: 1px solid var(--border); border-radius: var(--radius); background: #fff; }
  .audience-option { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.9rem; cursor: pointer; }
  .audience-option input[type="radio"] { margin-top: 0.15rem; accent-color: var(--teal); }
  .audience-count { color: var(--muted); }
</style>
<script>
  const subjectEl     = document.getElementById('subject');
  const bodyEl        = document.getElementById('body');
  const blankLayoutEl = document.getElementById('useBlankLayout');
  const frame         = document.getElementById('preview-frame');
  const audAll        = document.getElementById('aud-all');
  const audTags       = document.getElementById('aud-tags');
  const tagPanel      = document.getElementById('tag-panel');
  const tagCount      = document.getElementById('tag-count');
  const draftTags     = document.querySelectorAll('.draft-tag');
  const previewUrl    = '{{ path('app_admin_email_preview') }}';
  const countUrl      = '{{ path('app_admin_email_count') }}';

  let previewDebounce, countDebounce;

  function refreshPreview() {
    const body = new FormData();
    body.append('subject', subjectEl.value || '(No subject)');
    body.append('body',    bodyEl.value    || '');
    body.append('useBlankLayout', blankLayoutEl.checked ? '1' : '0');

    fetch(previewUrl, { method: 'POST', body })
      .then(r => r.text())
      .then(html => { frame.srcdoc = html; });
  }

  function schedulePreview() {
    clearTimeout(previewDebounce);
    previewDebounce = setTimeout(refreshPreview, 350);
  }

  subjectEl.addEventListener('input', schedulePreview);
  bodyEl.addEventListener('input',    schedulePreview);
  blankLayoutEl.addEventListener('change', refreshPreview);

  function getSelectedTagIds() {
    return [...draftTags].filter(c => c.checked).map(c => c.value);
  }

  function refreshCount() {
    if (!tagCount) return;
    const ids = getSelectedTagIds();
    const body = new FormData();
    ids.forEach(id => body.append('tagIds[]', id));

    fetch(countUrl, { method: 'POST', body })
      .then(r => r.text())
      .then(n => { tagCount.textContent = n; });
  }

  if (audAll) {
    audAll.addEventListener('change', () => {
      tagPanel.style.display = 'none';
      draftTags.forEach(c => c.disabled = true);
    });
  }

  if (audTags) {
    audTags.addEventListener('change', () => {
      tagPanel.style.display = 'block';
      draftTags.forEach(c => c.disabled = false);
      refreshCount();
    });
  }

  // Disable tag checkboxes when "all" is the initial selection, so they don't get submitted.
  if (audAll && audAll.checked) {
    draftTags.forEach(c => c.disabled = true);
  }

  draftTags.forEach(c => {
    c.addEventListener('change', () => {
      clearTimeout(countDebounce);
      countDebounce = setTimeout(refreshCount, 200);
    });
  });

  refreshPreview();
  refreshCount();
</script>
{% endblock %}
