{% extends 'admin/base.html.twig' %}
{% block title %}Emails — Settings{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Emails</h1>
  <a href="{{ path('app_admin_email_compose') }}" class="btn btn--teal btn--sm">+ New draft</a>
</div>

{% if emails is empty %}
  <div class="empty">
    <strong>No drafts yet</strong>
    Start a new draft to compose a broadcast email, then send it when you're ready.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Status</th>
          <th>Audience</th>
          <th>Created</th>
          <th>Sent</th>
        </tr>
      </thead>
      <tbody>
        {% for email in emails %}
          <tr>
            <td>
              <a href="{{ path('app_admin_email_compose_edit', {id: email.id}) }}" class="admin-table__link">{{ email.subject }}</a>
              {% if email.template %}
                <span class="status-pill status-pill--waiting" style="margin-left:0.4rem;">Template</span>
              {% endif %}
            </td>
            <td>
              {% if email.sent %}
                <span class="status-pill status-pill--published">Sent</span>
              {% else %}
                <span class="status-pill status-pill--pending">Draft</span>
              {% endif %}
            </td>
            <td class="admin-table__muted">{{ email.audienceLabel }}</td>
            <td class="admin-table__muted">
              {{ email.createdAt|date('d M Y H:i') }}{% if email.createdBy %} — {{ email.createdBy.displayName }}{% endif %}
            </td>
            <td class="admin-table__muted">
              {% if email.sentAt %}
                {{ email.sentAt|date('d M Y H:i') }}{% if email.sentBy %} — {{ email.sentBy.displayName }}{% endif %}
              {% else %}
                —
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
