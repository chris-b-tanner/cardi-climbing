{% extends 'admin/base.html.twig' %}
{% block title %}Edit {{ tag.name }} — Settings{% endblock %}

{% block content %}
<div class="page-header">
  <h1><a href="{{ path('app_admin_settings_tags') }}" class="page-header__crumb">Tags</a> &raquo; {{ tag.name }}</h1>
  <a href="{{ path('app_admin_settings_tags') }}" class="btn btn--ghost btn--sm">← Cancel</a>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_settings_tag_edit', {id: tag.id}) }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_tag_edit_' ~ tag.id) }}">

  <div class="card">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" class="form-control"
             value="{{ tag.name }}" autocomplete="off" required>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" class="form-control" rows="3"
                placeholder="What this tag is for — shown to staff when they filter by it, and to members if it's public."
                style="resize:vertical;">{{ tag.description }}</textarea>
    </div>
    <div class="form-group">
      <label for="color">Colour</label>
      <div style="display:flex;align-items:center;gap:0.6rem;">
        <input type="color" id="color" name="color" value="{{ tag.effectiveColor }}"
               style="width:2.75rem;height:2.25rem;padding:0.15rem;border:1px solid var(--border);border-radius:6px;cursor:pointer;background:none;">
        <input type="text" id="color-hex" class="form-control" style="max-width:9rem;"
               value="{{ tag.effectiveColor }}" pattern="^#[0-9a-fA-F]{6}$" maxlength="7" autocomplete="off">
        <span class="tag-badge" id="color-preview" style="background:color-mix(in srgb, {{ tag.effectiveColor }} 15%, white); color:{{ tag.effectiveColor }};">{{ tag.name }}</span>
      </div>
    </div>
    <div class="form-group" style="margin-bottom:0;">
      <label style="flex-direction:row;align-items:center;gap:0.5rem;display:flex;text-transform:none;font-size:0.875rem;color:var(--black);">
        <input type="checkbox" name="public" value="1"{% if tag.public %} checked{% endif %}
               style="width:1rem;height:1rem;accent-color:var(--teal);">
        Public — show as an interest group members can opt into
      </label>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Save changes</button>
    <a href="{{ path('app_admin_settings_tags') }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>

<div class="card" style="margin-top:1.5rem;">
  <div class="card__label" style="margin-bottom:0.6rem;">Danger zone</div>
  <p style="font-size:0.85rem;color:var(--muted);margin-bottom:0.75rem;">
    Deleting this tag removes it from {{ tag.users|length }} member(s). This cannot be undone.
  </p>
  <form method="post" action="{{ path('app_admin_settings_tag_delete', {id: tag.id}) }}"
        onsubmit="return confirm('Delete the tag &quot;{{ tag.name|e('js') }}&quot;? It will be removed from {{ tag.users|length }} member(s). This cannot be undone.');">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_tag_' ~ tag.id) }}">
    <button type="submit" class="btn btn--danger btn--sm">Delete tag</button>
  </form>
</div>
{% endblock %}

{% block scripts %}
<script>
  (function () {
    const colorInput = document.getElementById('color');
    const hexInput    = document.getElementById('color-hex');
    const preview     = document.getElementById('color-preview');

    function applyColor(hex) {
      preview.style.color      = hex;
      preview.style.background = 'color-mix(in srgb, ' + hex + ' 15%, white)';
    }

    colorInput.addEventListener('input', () => {
      hexInput.value = colorInput.value;
      applyColor(colorInput.value);
    });

    hexInput.addEventListener('input', () => {
      if (/^#[0-9a-fA-F]{6}$/.test(hexInput.value)) {
        colorInput.value = hexInput.value;
        applyColor(hexInput.value);
      }
    });
  })();
</script>
{% endblock %}
