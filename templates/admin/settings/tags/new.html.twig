{% extends 'admin/base.html.twig' %}
{% block title %}New tag — Settings{% endblock %}

{% block content %}
<div class="page-header">
  <h1>New tag</h1>
  <a href="{{ path('app_admin_settings_tags') }}" class="btn btn--ghost btn--sm">← Cancel</a>
</div>

{% if error %}
  <div class="flash flash--error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_settings_tag_new') }}" novalidate>
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_tag_new') }}">

  <div class="card">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" class="form-control"
             value="{{ app.request.request.get('name') }}" autocomplete="off" required>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" class="form-control" rows="3"
                placeholder="What this tag is for — shown to staff when they filter by it, and to members if it's public."
                style="resize:vertical;">{{ app.request.request.get('description') }}</textarea>
    </div>
    <div class="form-group" style="margin-bottom:0;">
      <label style="flex-direction:row;align-items:center;gap:0.5rem;display:flex;text-transform:none;font-size:0.875rem;color:var(--black);">
        <input type="checkbox" name="public" value="1"{% if app.request.request.get('public') %} checked{% endif %}
               style="width:1rem;height:1rem;accent-color:var(--teal);">
        Public — show as an interest group members can opt into
      </label>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn--teal">Create tag</button>
    <a href="{{ path('app_admin_settings_tags') }}" class="btn btn--ghost">Cancel</a>
  </div>
</form>
{% endblock %}
