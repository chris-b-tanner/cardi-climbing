<div class="result-count">{{ events|length }} {{ events|length == 1 ? 'event' : 'events' }}</div>

{% if events is empty %}
  <div class="empty">
    <strong>No events found</strong>
    Try adjusting your search.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Date</th>
          <th>Time</th>
          <th>Location</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for event in events %}
          <tr>
            <td>
              <a href="{{ path('app_admin_event_show', {id: event.id}) }}" class="admin-table__link">{{ event.title }}</a>
              {% if event.isSelfAccess %}
                <i class="bi bi-lock-fill" style="color:var(--muted);font-size:0.8em;margin-left:0.3rem;" title="Self access (door PIN)"></i>
              {% endif %}
              {% if event.restrictions is not empty %}
                <i class="bi bi-shield-check" style="color:var(--muted);font-size:0.8em;margin-left:0.3rem;" title="Restricted to: {% for c in event.restrictions %}{{ c.name }}{% if not loop.last %}, {% endif %}{% endfor %}"></i>
              {% endif %}
              {% if event.id in ticketedEventIds %}
                <i class="bi bi-box-seam" style="color:var(--muted);font-size:0.8em;margin-left:0.3rem;" title="Linked to ticket product(s)"></i>
              {% endif %}
            </td>
            <td class="admin-table__muted">
              {% if event.isRecurring %}
                {{ event.date|date('d M Y') }} &ndash; {{ event.recurUntil ? event.recurUntil|date('d M Y') : 'Ongoing' }}
              {% else %}
                {{ event.date|date('d M Y') }}
              {% endif %}
            </td>
            <td class="admin-table__muted">{{ event.timeFrom }}&ndash;{{ event.timeTo }}</td>
            <td class="admin-table__muted">{{ event.location }}</td>
            <td>
              <span class="status-pill{{ event.isPublished ? ' status-pill--published' : '' }}">
                {{ event.isPublished ? 'Published' : 'Draft' }}
              </span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
