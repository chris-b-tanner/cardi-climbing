{% extends 'admin/base.html.twig' %}
{% block title %}{{ event.title }}{% endblock %}

{% macro attendee_table(attendees, returnUrl) %}
  {% if attendees is empty %}
    <p class="tag-badge--none">No one booked yet.</p>
  {% else %}
    {% set attendees = attendees|sort((a, b) => (a.isStaffing ? 0 : 1) <=> (b.isStaffing ? 0 : 1)) %}
    <div class="table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Member</th>
            <th>Status</th>
            <th>Price</th>
            <th>Ticket</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for attendee in attendees %}
            {% set displayName = attendee.user.displayName %}
            {% set pillClass = attendee.status == 'confirmed' ? ' status-pill--published' : (attendee.status == 'cancelled' ? ' status-pill--cancelled' : (attendee.status == 'waiting' ? ' status-pill--waiting' : '')) %}
            <tr data-name="{{ displayName|lower }}" data-email="{{ attendee.user.email|lower }}">
              <td>
                <div style="display:flex;align-items:center;gap:0.5rem;">
                  {% if attendee.isStaffing %}
                    <span style="flex-shrink:0;width:1.75rem;height:1.75rem;border-radius:50%;background:#ede9fe;color:#5b21b6;display:flex;align-items:center;justify-content:center;font-size:0.85rem;" title="Staffing this event">
                      <i class="bi bi-person-fill"></i>
                    </span>
                  {% endif %}
                  <div>
                    <a href="{{ path('app_admin_user_show', {id: attendee.user.id}) }}" class="admin-table__link">
                      {{ displayName ?: attendee.user.email }}
                    </a>
                    {% if attendee.isStaffing %}
                      <br><span style="font-size:0.72rem;color:var(--muted);">{{ attendee.staffingRequirement.certification.name }} &middot; {{ attendee.staffingStatusLabel }}</span>
                    {% endif %}
                  </div>
                </div>
              </td>
              <td><span class="status-pill{{ pillClass }}">{{ attendee.status|capitalize }}</span></td>
              <td class="admin-table__muted">{{ attendee.effectivePrice ? '£' ~ attendee.effectivePrice : 'Free' }}</td>
              <td class="admin-table__muted">
                {% if attendee.salesOrderRow %}
                  {{ attendee.salesOrderRow.product.name }}{% if attendee.salesOrderRow.product.variantValue %} ({{ attendee.salesOrderRow.product.variantValue }}){% endif %}
                {% else %}
                  &mdash;
                {% endif %}
              </td>
              <td><a href="{{ path('app_admin_booking_edit', {id: attendee.id, returnTo: returnUrl}) }}" class="admin-table__link">Edit</a></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
{% endmacro %}

{% block content %}
<div class="page-header">
  <h1>
    <a href="{{ path('app_admin_events') }}" class="page-header__crumb">Events</a> &raquo;

    {{ event.title }} - {{ (event.isRecurring ? occurrenceDate : event.date)|date('d M Y') }}

    {% if event.isRecurring %}<i class="bi bi-arrow-repeat"></i>{% endif %}

    <span class="status-pill{{ event.isPublished ? ' status-pill--published' : '' }}">
          {{ event.isPublished ? 'Published' : 'Draft' }}
        </span>
  </h1>
  {% if is_granted('ROLE_ADMIN') %}
    <div class="btn-row">
      <a href="{{ path('app_admin_event_edit', {id: event.id}) }}" class="btn btn--teal btn--sm">Edit</a>
    </div>
  {% endif %}
</div>

{% if event.acceptsTicket and eventTicketProducts is empty %}
  <div class="flash flash--error">
    This event accepts "Ticket" as an access method, but no ticket product is linked to it yet —
    <a href="{{ path('app_admin_settings_products') }}">create one</a> so members can actually buy a seat.
  </div>
{% endif %}

<div class="member-columns member-columns--thirds">
<div class="member-col-left">

<div class="card">
  <div class="detail-grid">
    <div>
      <div class="card__label">Time</div>
      <div class="card__value">
        {{ event.timeFrom }}&ndash;{{ event.timeTo }}
        {% if event.isRecurring %}
          {% set weekdayNames = {1: 'Mon', 2: 'Tue', 3: 'Wed', 4: 'Thu', 5: 'Fri', 6: 'Sat', 7: 'Sun'} %}
          <br><span style="font-size:0.85rem;color:var(--muted);">
            Repeats {{ event.recurDaysArray|map(d => weekdayNames[d])|join(', ') }}
          </span>
        {% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Location</div>
      <div class="card__value">{{ event.location }}</div>
    </div>
    <div>
      <div class="card__label">Max attendees</div>
      <div class="card__value">{{ event.maxAttendees ?: 'Unlimited' }}</div>
    </div>
    {% if event.externalUrl %}
      <div style="grid-column:1 / -1;">
        <div class="card__label">URL</div>
        <div class="card__value">
          <a href="{{ event.externalUrl }}" target="_blank" rel="noopener" style="color:var(--teal-dk);">{{ event.externalUrl }}</a>
        </div>
      </div>
    {% endif %}
    {% if event.isRecurring %}
      <div style="color:var(--muted);font-size:0.85rem;">
            <i class="bi bi-arrow-repeat"></i> {% if event.recurUntil %} until {{ event.recurUntil|date('d M Y') }}{% endif %}
          </div>
    {% endif %}
  </div>
</div>

{% if event.description %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.5rem;">Description</div>
    <div class="card__value" style="white-space:pre-wrap;line-height:1.7;">{{ event.description }}</div>
  </div>
{% endif %}

{% if event.attendeeInfo %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.5rem;">Attendee information</div>
    <div class="card__value" style="white-space:pre-wrap;line-height:1.7;">{{ event.attendeeInfo }}</div>
    <p style="font-size:0.78rem;color:var(--muted);margin-top:0.6rem;">
      Sent in the booking confirmation email — not shown on the public events page.
    </p>
  </div>
{% endif %}

{% if event.restrictions is not empty %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.5rem;">Restricted to</div>
    {% for certification in event.restrictions %}
      <span class="tag-badge">{{ certification.name }}</span>
    {% endfor %}
  </div>
{% endif %}

<div class="card">
  <div class="card__label" style="margin-bottom:0.5rem;">Access</div>
  {% if event.hasAccessRestriction %}
    {% if event.acceptsTicket %}<span class="tag-badge">Ticket</span>{% endif %}
    {% if event.acceptsCredit %}<span class="tag-badge">Credit</span>{% endif %}
    {% if event.acceptsMembership %}<span class="tag-badge">Membership</span>{% endif %}
  {% else %}
    <span class="tag-badge--none">Free</span>
  {% endif %}
</div>

{% if event.isRecurring %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.75rem;">Viewing occurrence</div>
    <form method="get" action="{{ path('app_admin_event_show', {id: event.id}) }}" class="occurrence-picker">
      {% if prevDate %}
        <a href="{{ path('app_admin_event_show', {id: event.id, date: prevDate|date('Y-m-d')}) }}" class="btn btn--ghost btn--sm">&lsaquo; Previous</a>
      {% else %}
        <span class="btn btn--ghost btn--sm" style="opacity:0.4;pointer-events:none;">&lsaquo; Previous</span>
      {% endif %}
      <input type="date" name="date" value="{{ occurrenceDate|date('Y-m-d') }}"
             min="{{ event.date|date('Y-m-d') }}"
             max="{{ event.recurUntil ? event.recurUntil|date('Y-m-d') : '' }}"
             class="form-control" style="max-width:170px;" onchange="this.form.submit()">
      {% if nextDate %}
        <a href="{{ path('app_admin_event_show', {id: event.id, date: nextDate|date('Y-m-d')}) }}" class="btn btn--ghost btn--sm">Next &rsaquo;</a>
      {% else %}
        <span class="btn btn--ghost btn--sm" style="opacity:0.4;pointer-events:none;">Next &rsaquo;</span>
      {% endif %}
      <noscript><button type="submit" class="btn btn--teal btn--sm">Go</button></noscript>
    </form>
  </div>
{% endif %}

</div>
<div class="member-col-right">

  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem;">
      {% set confirmedCount = attendees|filter(a => a.status == 'confirmed')|length %}
      {% set placesLeft = event.maxAttendees ? max(event.maxAttendees - confirmedCount, 0) : null %}
      <div class="card__label" style="margin-bottom:0;">
        Attendees ({{ confirmedCount }}){% if placesLeft is not null %}, {{ placesLeft }} place{{ placesLeft == 1 ? '' : 's' }} left{% endif %}{% if event.isRecurring %} &mdash; {{ occurrenceDate|date('d M Y') }}{% endif %}
      </div>
      <div class="btn-row">
        {% if attendees is not empty %}
          <a href="{{ path('app_admin_event_attendees_print', event.isRecurring ? {id: event.id, date: occurrenceDate|date('Y-m-d')} : {id: event.id}) }}" class="btn btn--ghost btn--sm" target="_blank"><i class="bi bi-printer-fill"></i> Print attendee list</a>
          {% if event.isRecurring %}
            <a href="{{ path('app_admin_email_compose', {eventId: event.id, scope: 'date', occurrenceDate: occurrenceDate|date('Y-m-d')}) }}" class="btn btn--ghost btn--sm"><i class="bi bi-envelope-fill"></i> Email this date</a>
            <a href="{{ path('app_admin_email_compose', {eventId: event.id, scope: 'series'}) }}" class="btn btn--ghost btn--sm"><i class="bi bi-envelope-fill"></i> Email series</a>
          {% else %}
            <a href="{{ path('app_admin_email_compose', {eventId: event.id}) }}" class="btn btn--ghost btn--sm"><i class="bi bi-envelope-fill"></i> Email attendees</a>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {% set eventReturnUrl = path('app_admin_event_show', event.isRecurring ? {id: event.id, date: occurrenceDate|date('Y-m-d')} : {id: event.id}) %}
    {% set confirmedAttendees = attendees|filter(a => a.status == 'confirmed') %}
    {% set pendingAttendees   = attendees|filter(a => a.status == 'pending') %}
    {% set waitingAttendees   = attendees|filter(a => a.status == 'waiting') %}
    {% set cancelledAttendees = attendees|filter(a => a.status == 'cancelled') %}

    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;">
      <div class="pos-tabs" id="attendee-tabs">
        <button type="button" class="pos-tab" data-tab="confirmed">Confirmed ({{ confirmedAttendees|length }})</button>
        <button type="button" class="pos-tab" data-tab="pending">Pending ({{ pendingAttendees|length }})</button>
        <button type="button" class="pos-tab" data-tab="waiting">Waiting ({{ waitingAttendees|length }})</button>
        <button type="button" class="pos-tab" data-tab="cancelled">Cancelled ({{ cancelledAttendees|length }})</button>
      </div>
      <input type="search" id="attendee-search" class="form-control" style="max-width:220px;padding:0.4rem 0.85rem;font-size:0.8rem; margin-bottom: 10px;"
             placeholder="Search name or email…" autocomplete="off">
    </div>

    <div class="tab-panel" data-tab-panel="confirmed" style="display:none;">
      {{ _self.attendee_table(confirmedAttendees, eventReturnUrl) }}
    </div>
    <div class="tab-panel" data-tab-panel="pending" style="display:none;">
      {{ _self.attendee_table(pendingAttendees, eventReturnUrl) }}
    </div>
    <div class="tab-panel" data-tab-panel="waiting" style="display:none;">
      {{ _self.attendee_table(waitingAttendees, eventReturnUrl) }}
    </div>
    <div class="tab-panel" data-tab-panel="cancelled" style="display:none;">
      {{ _self.attendee_table(cancelledAttendees, eventReturnUrl) }}
    </div>
    <p id="attendee-search-empty" class="tag-badge--none" style="display:none;">No matching attendees.</p>

    {% if eventTicketProducts is not empty and is_granted('ROLE_ADMIN') %}
      {% set addAttendeeParams = {context: 'new_sale', eventId: event.id} %}
      {% if event.isRecurring %}{% set addAttendeeParams = addAttendeeParams|merge({occurrenceDate: occurrenceDate|date('Y-m-d')}) %}{% endif %}
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem;justify-content:space-between;">
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          {% for product in eventTicketProducts %}
            <a href="{{ path('app_admin_settings_product_edit', {id: product.id}) }}" class="btn btn--ghost btn--sm">Edit {{ product.name }}{% if product.variantValue %} ({{ product.variantValue }}){% endif %}</a>
          {% endfor %}
        </div>
        <a href="{{ path('app_admin_users', addAttendeeParams) }}" class="btn btn--teal btn--sm">+ Add attendee</a>
      </div>
    {% endif %}
  </div>

{% if event.staffingRequirements is not empty %}
<div class="card">
  <div class="card__label" style="margin-bottom:0.75rem;">
    Staffing{% if event.isRecurring %} &mdash; {{ occurrenceDate|date('d M Y') }}{% endif %}
  </div>

  {% for requirement in event.staffingRequirements %}
    {% set approvedForReq = staffing|filter(a => a.staffingRequirement == requirement and a.staffingStatus == 'approved') %}
    {% set pendingForReq  = staffing|filter(a => a.staffingRequirement == requirement and a.staffingStatus == 'pending') %}
    {% set declinedForReq = staffing|filter(a => a.staffingRequirement == requirement and a.staffingStatus == 'declined') %}
    {% set short = approvedForReq|length < requirement.minCount %}

    <div style="border-left:3px solid {{ short ? 'var(--red)' : 'var(--border)' }};padding:0.5rem 0.75rem;margin-bottom:0.85rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
        <span style="font-weight:600;font-size:0.9375rem;">{{ requirement.certification.name }}</span>
        <span class="status-pill{{ short ? ' status-pill--cancelled' : ' status-pill--published' }}">
          {{ approvedForReq|length }} / {{ requirement.minCount }} on duty
        </span>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.4rem;">
        {% if short %}
          <a href="{{ path('app_admin_email_compose', {certificationId: requirement.certification.id}) }}" style="font-size:0.78rem;font-weight:600;color:var(--teal-dk);">
            <i class="bi bi-envelope-fill"></i> Email {{ requirement.certification.name }}s
          </a>
        {% endif %}
        <a href="#" class="staffing-add-trigger" data-requirement-id="{{ requirement.id }}" data-certification-name="{{ requirement.certification.name }}"
           style="font-size:0.78rem;font-weight:600;color:var(--teal-dk);">
          <i class="bi bi-person-plus-fill"></i> Add {{ requirement.certification.name }}
        </a>
      </div>

      {% if approvedForReq is not empty %}
        <div style="margin-top:0.5rem;display:flex;flex-direction:column;gap:0.3rem;">
          {% for a in approvedForReq %}
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
              <a href="{{ path('app_admin_user_show', {id: a.user.id}) }}" class="admin-table__link" style="font-size:0.85rem;">
                {{ a.user.displayName }}
              </a>
              <form method="post" action="{{ path('app_admin_booking_staffing_remove', {id: a.id}) }}"
                    onsubmit="return confirm('Take this member off duty?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_staffing_' ~ a.id) }}">
                <button type="submit" style="background:none;border:none;padding:0;font:inherit;color:var(--muted);text-decoration:underline;cursor:pointer;font-size:0.78rem;">Remove</button>
              </form>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if pendingForReq is not empty %}
        <div style="margin-top:0.6rem;">
          <p style="font-size:0.78rem;color:var(--muted);margin-bottom:0.3rem;">Awaiting review:</p>
          {% for a in pendingForReq %}
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.3rem;">
              <a href="{{ path('app_admin_user_show', {id: a.user.id}) }}" class="admin-table__link" style="font-size:0.85rem;">
                {{ a.user.displayName }}
              </a>
              <div class="btn-row">
                <form method="post" action="{{ path('app_admin_booking_staffing_approve', {id: a.id}) }}">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_staffing_' ~ a.id) }}">
                  <button type="submit" class="btn btn--teal btn--sm">Approve</button>
                </form>
                <form method="post" action="{{ path('app_admin_booking_staffing_decline', {id: a.id}) }}">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_staffing_' ~ a.id) }}">
                  <button type="submit" class="btn btn--ghost btn--sm">Decline</button>
                </form>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if declinedForReq is not empty %}
        <p style="font-size:0.78rem;color:var(--muted);margin-top:0.5rem;">
          Declined: {% for a in declinedForReq %}{{ a.user.displayName }}{% if not loop.last %}, {% endif %}{% endfor %}
        </p>
      {% endif %}

      {% set eligible = attendees|filter(a => a.status != 'cancelled' and not a.isStaffing and a.user.hasCertification(requirement.certification)) %}
      {% if eligible is not empty %}
        <form method="post" action="{{ path('app_admin_event_staffing_assign', {id: event.id}) }}"
              style="display:flex;gap:0.5rem;align-items:center;margin-top:0.6rem;flex-wrap:wrap;">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_event_staffing_' ~ event.id) }}">
          <input type="hidden" name="requirementId" value="{{ requirement.id }}">
          {% if event.isRecurring %}<input type="hidden" name="occurrenceDate" value="{{ occurrenceDate|date('Y-m-d') }}">{% endif %}
          <select name="attendeeId" class="form-control" style="max-width:220px;">
            {% for a in eligible %}
              <option value="{{ a.id }}">{{ a.user.displayName }}</option>
            {% endfor %}
          </select>
          <button type="submit" class="btn btn--ghost btn--sm">Put on duty</button>
        </form>
      {% endif %}
    </div>
  {% endfor %}
</div>

<div id="staffing-picker-modal" class="pos-modal" style="display:none;">
  <div id="staffing-picker-backdrop" class="pos-modal__backdrop"></div>
  <div class="pos-modal__box">
    <div class="pos-modal__header">
      <strong id="staffing-picker-title">Add staff</strong>
      <button type="button" id="staffing-picker-close" class="btn btn--ghost btn--sm">✕</button>
    </div>
    <input type="text" id="staffing-picker-search" class="form-control" placeholder="Search members…"
           autocomplete="off" style="margin-bottom:0.75rem;">
    <div id="staffing-picker-results" style="display:flex;flex-direction:column;gap:0.3rem;max-height:260px;overflow-y:auto;"></div>
  </div>
</div>

<form id="staffing-add-form" method="post" action="{{ path('app_admin_event_staffing_add', {id: event.id}) }}" style="display:none;">
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_event_staffing_' ~ event.id) }}">
  <input type="hidden" name="requirementId" id="staffing-add-requirement-id">
  <input type="hidden" name="userId" id="staffing-add-user-id">
  {% if event.isRecurring %}<input type="hidden" name="occurrenceDate" value="{{ occurrenceDate|date('Y-m-d') }}">{% endif %}
</form>
{% endif %}

  <div class="card">
    <div class="card__label" style="margin-bottom:0.6rem;">Notes</div>
    {% include 'admin/_notes_panel.html.twig' with {notes: notes, noteableType: 'event', noteableId: event.id} %}
  </div>

</div>
</div>
{% endblock %}

{% block scripts %}
<style>
  .occurrence-picker { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
</style>
<script>
  const attendeeTabs   = document.querySelectorAll('#attendee-tabs .pos-tab');
  const attendeePanels = document.querySelectorAll('.tab-panel[data-tab-panel]');
  const attendeeSearch = document.getElementById('attendee-search');
  const attendeeEmpty  = document.getElementById('attendee-search-empty');

  let activeAttendeeTab = attendeeTabs[0] ? attendeeTabs[0].dataset.tab : null;

  function matchesAttendeeQuery(row, query) {
    if (!query) return true;
    const name  = row.dataset.name  || '';
    const email = row.dataset.email || '';
    return name.includes(query) || email.includes(query);
  }

  function renderAttendees() {
    const query = attendeeSearch ? attendeeSearch.value.trim().toLowerCase() : '';

    const matchingTabs = new Set();
    attendeePanels.forEach(panel => {
      const rows = panel.querySelectorAll('tbody tr[data-name]');
      if ([...rows].some(row => matchesAttendeeQuery(row, query))) {
        matchingTabs.add(panel.dataset.tabPanel);
      }
    });

    if (query && matchingTabs.size === 1) {
      // Exactly one status has matches — jump to it.
      activeAttendeeTab = [...matchingTabs][0];
    } else if (query && !matchingTabs.has(activeAttendeeTab)) {
      // The current tab has nothing matching — move to the first one (in tab order) that does.
      for (const tab of attendeeTabs) {
        if (matchingTabs.has(tab.dataset.tab)) {
          activeAttendeeTab = tab.dataset.tab;
          break;
        }
      }
    }

    attendeeTabs.forEach(t => t.classList.toggle('is-active', t.dataset.tab === activeAttendeeTab));
    attendeePanels.forEach(p => p.style.display = p.dataset.tabPanel === activeAttendeeTab ? '' : 'none');

    let visible = 0;
    attendeePanels.forEach(panel => {
      if (panel.dataset.tabPanel !== activeAttendeeTab) return;
      panel.querySelectorAll('tbody tr[data-name]').forEach(row => {
        const show = matchesAttendeeQuery(row, query);
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });
    });
    attendeeEmpty.style.display = (query && visible === 0) ? 'block' : 'none';
  }

  attendeeTabs.forEach(t => t.addEventListener('click', () => {
    activeAttendeeTab = t.dataset.tab;
    renderAttendees();
  }));

  if (attendeeSearch) {
    attendeeSearch.addEventListener('input', renderAttendees);
  }

  // Default to "Confirmed", unless it's empty and another status actually has attendees in it.
  for (const tab of attendeeTabs) {
    const panel = document.querySelector(`.tab-panel[data-tab-panel="${tab.dataset.tab}"]`);
    if (panel && panel.querySelector('tbody tr')) {
      activeAttendeeTab = tab.dataset.tab;
      break;
    }
  }
  renderAttendees();
</script>
{% if event.staffingRequirements is not empty %}
<script>
  const staffingPickerModal    = document.getElementById('staffing-picker-modal');
  const staffingPickerBackdrop = document.getElementById('staffing-picker-backdrop');
  const staffingPickerClose    = document.getElementById('staffing-picker-close');
  const staffingPickerTitle    = document.getElementById('staffing-picker-title');
  const staffingPickerSearch   = document.getElementById('staffing-picker-search');
  const staffingPickerResults  = document.getElementById('staffing-picker-results');
  const staffingSearchUrl      = {{ path('app_admin_event_staffing_search', {id: event.id})|json_encode|raw }};
  const staffingOccurrenceDate = {{ (event.isRecurring ? occurrenceDate|date('Y-m-d') : null)|json_encode|raw }};
  let staffingSearchDebounce;
  let staffingRequirementId;

  function closeStaffingPicker() {
    staffingPickerModal.style.display = 'none';
  }

  function runStaffingSearch() {
    const q = staffingPickerSearch.value.trim();

    const params = new URLSearchParams({requirementId: staffingRequirementId, q});
    if (staffingOccurrenceDate) params.set('occurrenceDate', staffingOccurrenceDate);

    fetch(`${staffingSearchUrl}?${params}`)
      .then(r => r.json())
      .then(results => {
        staffingPickerResults.innerHTML = '';
        if (!results.length) {
          staffingPickerResults.innerHTML = '<p style="font-size:0.82rem;color:var(--muted);">No matching certified members found.</p>';
          return;
        }
        results.forEach(result => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'member-search-item';
          btn.textContent = result.label;
          btn.addEventListener('click', () => {
            document.getElementById('staffing-add-user-id').value = result.id;
            document.getElementById('staffing-add-form').requestSubmit();
          });
          staffingPickerResults.appendChild(btn);
        });
      });
  }

  document.querySelectorAll('.staffing-add-trigger').forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      staffingRequirementId = trigger.dataset.requirementId;
      document.getElementById('staffing-add-requirement-id').value = staffingRequirementId;
      staffingPickerTitle.textContent = 'Add ' + trigger.dataset.certificationName;
      staffingPickerSearch.value = '';
      staffingPickerModal.style.display = 'flex';
      staffingPickerSearch.focus();
      runStaffingSearch(); // list the (usually short) full holder pool immediately — searching is optional
    });
  });

  staffingPickerSearch.addEventListener('input', () => {
    clearTimeout(staffingSearchDebounce);
    staffingSearchDebounce = setTimeout(runStaffingSearch, 300);
  });

  staffingPickerClose.addEventListener('click', closeStaffingPicker);
  staffingPickerBackdrop.addEventListener('click', closeStaffingPicker);
</script>
{% endif %}
{% endblock %}
