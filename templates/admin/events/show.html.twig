{% extends 'admin/base.html.twig' %}
{% block title %}{{ event.title }}{% endblock %}

{% macro attendee_table(attendees) %}
  {% if attendees is empty %}
    <p class="tag-badge--none">No one booked yet.</p>
  {% else %}
    <div class="table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Member</th>
            <th>Status</th>
            <th>Price</th>
            <th>Paid</th>
          </tr>
        </thead>
        <tbody>
          {% for attendee in attendees %}
            {% set displayName = (attendee.user.firstName ~ ' ' ~ attendee.user.lastName)|trim %}
            {% set pillClass = attendee.status == 'confirmed' ? ' status-pill--published' : (attendee.status == 'cancelled' ? ' status-pill--cancelled' : '') %}
            <tr>
              <td>
                <a href="{{ path('app_admin_user_show', {id: attendee.user.id}) }}" class="admin-table__link">
                  {{ displayName ?: attendee.user.email }}
                </a>
                {% if attendee.isStaffing %}
                  <br><span style="font-size:0.72rem;color:var(--muted);">{{ attendee.staffingRequirement.certification.name }} &middot; {{ attendee.staffingStatusLabel }}</span>
                {% endif %}
              </td>
              <td><span class="status-pill{{ pillClass }}">{{ attendee.status|capitalize }}</span></td>
              <td class="admin-table__muted">{{ attendee.effectivePrice ? '£' ~ attendee.effectivePrice : 'Free' }}</td>
              <td class="admin-table__muted">£{{ attendee.paidAmount }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
{% endmacro %}

{% block content %}
<div class="page-header">
  <h1>
    {{ event.title }} - {{ (event.isRecurring ? occurrenceDate : event.date)|date('d M Y') }}
    <span class="status-pill{{ event.isPublished ? ' status-pill--published' : '' }}">
          {{ event.isPublished ? 'Published' : 'Draft' }}
        </span>
  </h1>
  <div class="btn-row">
    <a href="{{ path('app_admin_events') }}" class="btn btn--ghost btn--sm">← Events</a>
    {% if is_granted('ROLE_ADMIN') %}
      <a href="{{ path('app_admin_event_edit', {id: event.id}) }}" class="btn btn--teal btn--sm">Edit</a>
    {% endif %}
  </div>
</div>

<div class="member-columns">
<div class="member-col-left">

<div class="card">
  <div class="detail-grid">
    <div>
      <div class="card__label">Time</div>
      <div class="card__value">
        {{ event.timeFrom }}&ndash;{{ event.timeTo }}
        {% if event.isRecurring %}
          {% set weekdayNames = {1: 'Mon', 2: 'Tue', 3: 'Wed', 4: 'Thu', 5: 'Fri', 6: 'Sat', 7: 'Sun'} %}
          <br><span style="font-size:0.85rem;color:var(--muted);">
            Repeats {{ event.recurDaysArray|map(d => weekdayNames[d])|join(', ') }}
          </span>
        {% endif %}
      </div>
    </div>
    <div>
      <div class="card__label">Location</div>
      <div class="card__value">{{ event.location }}</div>
    </div>
    <div>
      <div class="card__label">Price</div>
      <div class="card__value">{{ event.price ? '£' ~ event.price : 'Free' }}</div>
    </div>
    <div>
      <div class="card__label">Max attendees</div>
      <div class="card__value">{{ event.maxAttendees ?: 'Unlimited' }}</div>
    </div>
    {% if event.externalUrl %}
      <div style="grid-column:1 / -1;">
        <div class="card__label">URL</div>
        <div class="card__value">
          <a href="{{ event.externalUrl }}" target="_blank" rel="noopener" style="color:var(--teal-dk);">{{ event.externalUrl }}</a>
        </div>
      </div>
    {% endif %}
    {% if event.isRecurring %}
      <div style="color:var(--muted);font-size:0.85rem;">
            (recurring{% if event.recurUntil %} until {{ event.recurUntil|date('d M Y') }}{% endif %})
          </div>
    {% endif %}
  </div>
</div>

{% if event.description %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.5rem;">Description</div>
    <div class="card__value" style="white-space:pre-wrap;line-height:1.7;">{{ event.description }}</div>
  </div>
{% endif %}

{% if event.attendeeInfo %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.5rem;">Attendee information</div>
    <div class="card__value" style="white-space:pre-wrap;line-height:1.7;">{{ event.attendeeInfo }}</div>
    <p style="font-size:0.78rem;color:var(--muted);margin-top:0.6rem;">
      Sent in the booking confirmation email — not shown on the public events page.
    </p>
  </div>
{% endif %}

{% if event.restrictions is not empty %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.5rem;">Restricted to</div>
    {% for certification in event.restrictions %}
      <span class="tag-badge">{{ certification.name }}</span>
    {% endfor %}
  </div>
{% endif %}

{% if event.isRecurring %}
  <div class="card">
    <div class="card__label" style="margin-bottom:0.75rem;">Viewing occurrence</div>
    <form method="get" action="{{ path('app_admin_event_show', {id: event.id}) }}" class="occurrence-picker">
      {% if prevDate %}
        <a href="{{ path('app_admin_event_show', {id: event.id, date: prevDate|date('Y-m-d')}) }}" class="btn btn--ghost btn--sm">&lsaquo; Previous</a>
      {% else %}
        <span class="btn btn--ghost btn--sm" style="opacity:0.4;pointer-events:none;">&lsaquo; Previous</span>
      {% endif %}
      <input type="date" name="date" value="{{ occurrenceDate|date('Y-m-d') }}"
             min="{{ event.date|date('Y-m-d') }}"
             max="{{ event.recurUntil ? event.recurUntil|date('Y-m-d') : '' }}"
             class="form-control" style="max-width:170px;" onchange="this.form.submit()">
      {% if nextDate %}
        <a href="{{ path('app_admin_event_show', {id: event.id, date: nextDate|date('Y-m-d')}) }}" class="btn btn--ghost btn--sm">Next &rsaquo;</a>
      {% else %}
        <span class="btn btn--ghost btn--sm" style="opacity:0.4;pointer-events:none;">Next &rsaquo;</span>
      {% endif %}
      <noscript><button type="submit" class="btn btn--teal btn--sm">Go</button></noscript>
    </form>
  </div>
{% endif %}

</div>
<div class="member-col-right">

{% if event.staffingRequirements is not empty %}
<div class="card">
  <div class="card__label" style="margin-bottom:0.75rem;">
    Staffing{% if event.isRecurring %} &mdash; {{ occurrenceDate|date('d M Y') }}{% endif %}
  </div>

  {% for requirement in event.staffingRequirements %}
    {% set approvedForReq = staffing|filter(a => a.staffingRequirement == requirement and a.staffingStatus == 'approved') %}
    {% set pendingForReq  = staffing|filter(a => a.staffingRequirement == requirement and a.staffingStatus == 'pending') %}
    {% set declinedForReq = staffing|filter(a => a.staffingRequirement == requirement and a.staffingStatus == 'declined') %}
    {% set short = approvedForReq|length < requirement.minCount %}

    <div style="border-left:3px solid {{ short ? 'var(--red)' : 'var(--border)' }};padding:0.5rem 0.75rem;margin-bottom:0.85rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
        <span style="font-weight:600;font-size:0.9375rem;">{{ requirement.certification.name }}</span>
        <span class="status-pill{{ short ? ' status-pill--cancelled' : ' status-pill--published' }}">
          {{ approvedForReq|length }} / {{ requirement.minCount }} on duty
        </span>
      </div>
      {% if short %}
        <a href="{{ path('app_admin_email_compose', {certificationId: requirement.certification.id}) }}" style="font-size:0.78rem;font-weight:600;color:var(--teal-dk);display:inline-block;margin-top:0.4rem;">
          <i class="bi bi-envelope-fill"></i> Email {{ requirement.certification.name }}s
        </a>
      {% endif %}

      {% if approvedForReq is not empty %}
        <div style="margin-top:0.5rem;display:flex;flex-direction:column;gap:0.3rem;">
          {% for a in approvedForReq %}
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
              <a href="{{ path('app_admin_user_show', {id: a.user.id}) }}" class="admin-table__link" style="font-size:0.85rem;">
                {{ (a.user.firstName ~ ' ' ~ a.user.lastName)|trim ?: a.user.email }}
              </a>
              <form method="post" action="{{ path('app_admin_booking_staffing_remove', {id: a.id}) }}"
                    onsubmit="return confirm('Take this member off duty?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_staffing_' ~ a.id) }}">
                <button type="submit" style="background:none;border:none;padding:0;font:inherit;color:var(--muted);text-decoration:underline;cursor:pointer;font-size:0.78rem;">Remove</button>
              </form>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if pendingForReq is not empty %}
        <div style="margin-top:0.6rem;">
          <p style="font-size:0.78rem;color:var(--muted);margin-bottom:0.3rem;">Awaiting review:</p>
          {% for a in pendingForReq %}
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.3rem;">
              <a href="{{ path('app_admin_user_show', {id: a.user.id}) }}" class="admin-table__link" style="font-size:0.85rem;">
                {{ (a.user.firstName ~ ' ' ~ a.user.lastName)|trim ?: a.user.email }}
              </a>
              <div class="btn-row">
                <form method="post" action="{{ path('app_admin_booking_staffing_approve', {id: a.id}) }}">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_staffing_' ~ a.id) }}">
                  <button type="submit" class="btn btn--teal btn--sm">Approve</button>
                </form>
                <form method="post" action="{{ path('app_admin_booking_staffing_decline', {id: a.id}) }}">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_booking_staffing_' ~ a.id) }}">
                  <button type="submit" class="btn btn--ghost btn--sm">Decline</button>
                </form>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if declinedForReq is not empty %}
        <p style="font-size:0.78rem;color:var(--muted);margin-top:0.5rem;">
          Declined: {% for a in declinedForReq %}{{ (a.user.firstName ~ ' ' ~ a.user.lastName)|trim ?: a.user.email }}{% if not loop.last %}, {% endif %}{% endfor %}
        </p>
      {% endif %}

      {% set eligible = attendees|filter(a => a.status != 'cancelled' and not a.isStaffing and a.user.hasCertification(requirement.certification)) %}
      {% if eligible is not empty %}
        <form method="post" action="{{ path('app_admin_event_staffing_assign', {id: event.id}) }}"
              style="display:flex;gap:0.5rem;align-items:center;margin-top:0.6rem;flex-wrap:wrap;">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_event_staffing_' ~ event.id) }}">
          <input type="hidden" name="requirementId" value="{{ requirement.id }}">
          {% if event.isRecurring %}<input type="hidden" name="occurrenceDate" value="{{ occurrenceDate|date('Y-m-d') }}">{% endif %}
          <select name="attendeeId" class="form-control" style="max-width:220px;">
            {% for a in eligible %}
              <option value="{{ a.id }}">{{ (a.user.firstName ~ ' ' ~ a.user.lastName)|trim ?: a.user.email }}</option>
            {% endfor %}
          </select>
          <button type="submit" class="btn btn--ghost btn--sm">Put on duty</button>
        </form>
      {% endif %}
    </div>
  {% endfor %}
</div>
{% endif %}

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem;">
    <div class="card__label" style="margin-bottom:0;">
      Attendees ({{ attendees|length }}){% if event.isRecurring %} &mdash; {{ occurrenceDate|date('d M Y') }}{% endif %}
    </div>
    <div class="btn-row">
      {% if attendees is not empty %}
        <a href="{{ path('app_admin_event_attendees_print', event.isRecurring ? {id: event.id, date: occurrenceDate|date('Y-m-d')} : {id: event.id}) }}" class="btn btn--ghost btn--sm" target="_blank"><i class="bi bi-printer-fill"></i> Print attendee list</a>
        {% if event.isRecurring %}
          <a href="{{ path('app_admin_email_compose', {eventId: event.id, scope: 'date', occurrenceDate: occurrenceDate|date('Y-m-d')}) }}" class="btn btn--ghost btn--sm"><i class="bi bi-envelope-fill"></i> Email this date</a>
          <a href="{{ path('app_admin_email_compose', {eventId: event.id, scope: 'series'}) }}" class="btn btn--ghost btn--sm"><i class="bi bi-envelope-fill"></i> Email series</a>
        {% else %}
          <a href="{{ path('app_admin_email_compose', {eventId: event.id}) }}" class="btn btn--ghost btn--sm"><i class="bi bi-envelope-fill"></i> Email attendees</a>
        {% endif %}
      {% endif %}
      {% if eventTicketProducts is empty %}
        <button type="button" id="event-attendee-add-trigger" class="btn btn--teal btn--sm">+ Add attendee</button>
      {% endif %}
    </div>
  </div>

  {% if eventTicketProducts is empty %}
    {{ _self.attendee_table(attendees) }}
    {% include 'admin/_contact_picker_modal.html.twig' %}
  {% else %}
    <div class="pos-tabs" id="attendee-tabs">
      {% for product in eventTicketProducts %}
        <button type="button" class="pos-tab" data-tab="{{ product.id }}">{{ product.name }}{% if product.variantValue %} ({{ product.variantValue }}){% endif %} &mdash; £{{ product.price }}</button>
      {% endfor %}
      <button type="button" class="pos-tab" data-tab="free">Free</button>
    </div>

    {% for product in eventTicketProducts %}
      <div class="tab-panel" data-tab-panel="{{ product.id }}" style="display:none;">
        <div style="text-align:right;margin-bottom:0.75rem;">
          {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin_settings_product_edit', {id: product.id}) }}" class="btn btn--ghost btn--sm">Edit ticket</a>
          {% endif %}
          <button type="button" class="btn btn--teal btn--sm attendee-add-trigger" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}{% if product.variantValue %} ({{ product.variantValue }}){% endif %}">+ Add attendee</button>
        </div>
        {{ _self.attendee_table(attendeesByTab[product.id]) }}
      </div>
    {% endfor %}

    <div class="tab-panel" data-tab-panel="free" style="display:none;">
      <div style="text-align:right;margin-bottom:0.75rem;">
        <button type="button" class="btn btn--teal btn--sm attendee-add-trigger" data-product-id="" data-product-name="">+ Add attendee</button>
      </div>
      {{ _self.attendee_table(attendeesByTab['free']) }}
    </div>

    <form id="attendee-contact-form" method="post" action="{{ path('app_admin_event_add_attendee_contact', {id: event.id}) }}" style="display:none;">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_event_add_attendee_' ~ event.id) }}">
      <input type="hidden" name="userId" id="attendee-contact-userId">
      <input type="hidden" name="productId" id="attendee-contact-productId">
      {% if event.isRecurring %}<input type="hidden" name="occurrenceDate" value="{{ occurrenceDate|date('Y-m-d') }}">{% endif %}
    </form>

    {% include 'admin/_contact_picker_modal.html.twig' %}
  {% endif %}
</div>

</div>
</div>
{% endblock %}

{% block scripts %}
<style>
  .occurrence-picker { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
</style>
{% if eventTicketProducts is empty %}
<script>
  const eventAttendeeAddTrigger = document.getElementById('event-attendee-add-trigger');
  if (eventAttendeeAddTrigger) {
    eventAttendeeAddTrigger.addEventListener('click', () => {
      ContactPicker.open({
        title: 'Add attendee',
        onChoose: function (userId) {
          const params = new URLSearchParams({ eventId: '{{ event.id }}', userId: userId });
          {% if event.isRecurring %}params.set('occurrenceDate', '{{ occurrenceDate|date('Y-m-d') }}');{% endif %}
          window.location.href = '{{ path('app_admin_booking_new') }}?' + params.toString();
        },
      });
    });
  }
</script>
{% endif %}
{% if eventTicketProducts is not empty %}
<script>
  const attendeeTabs   = document.querySelectorAll('#attendee-tabs .pos-tab');
  const attendeePanels = document.querySelectorAll('.tab-panel[data-tab-panel]');

  function selectAttendeeTab(tab) {
    attendeeTabs.forEach(t => t.classList.toggle('is-active', t.dataset.tab === tab));
    attendeePanels.forEach(p => p.style.display = p.dataset.tabPanel === tab ? '' : 'none');
  }

  attendeeTabs.forEach(t => t.addEventListener('click', () => selectAttendeeTab(t.dataset.tab)));

  // Default to the first tab that actually has attendees in it.
  let defaultAttendeeTab = attendeeTabs[0] ? attendeeTabs[0].dataset.tab : null;
  for (const tab of attendeeTabs) {
    const panel = document.querySelector(`.tab-panel[data-tab-panel="${tab.dataset.tab}"]`);
    if (panel && panel.querySelector('tbody tr')) {
      defaultAttendeeTab = tab.dataset.tab;
      break;
    }
  }
  if (defaultAttendeeTab) selectAttendeeTab(defaultAttendeeTab);

  document.querySelectorAll('.attendee-add-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      ContactPicker.open({
        title: btn.dataset.productName ? 'Add attendee — ' + btn.dataset.productName : 'Add attendee — Free',
        onChoose: function (userId) {
          document.getElementById('attendee-contact-userId').value = userId;
          document.getElementById('attendee-contact-productId').value = btn.dataset.productId || '';
          document.getElementById('attendee-contact-form').requestSubmit();
        },
      });
    });
  });
</script>
{% endif %}
{% endblock %}
