{% extends 'admin/base.html.twig' %}
{% block title %}Events{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Events</h1>
  <a href="{{ path('app_admin_event_new') }}" class="btn btn--teal btn--sm">+ New event</a>
</div>

{% if events is empty %}
  <div class="empty">
    <strong>No events yet</strong>
    Create your first bookable event.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Date</th>
          <th>Time</th>
          <th>Location</th>
          <th>Recurring</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for event in events %}
          <tr>
            <td>
              <a href="{{ path('app_admin_event_show', {id: event.id}) }}" class="admin-table__link">{{ event.title }}</a>
            </td>
            <td class="admin-table__muted">{{ event.date|date('d M Y') }}</td>
            <td class="admin-table__muted">{{ event.timeFrom }}&ndash;{{ event.timeTo }}</td>
            <td class="admin-table__muted">{{ event.location }}</td>
            <td class="admin-table__muted">{{ event.isRecurring ? 'Yes' : '—' }}</td>
            <td>
              <span class="status-pill{{ event.isPublished ? ' status-pill--published' : '' }}">
                {{ event.isPublished ? 'Published' : 'Draft' }}
              </span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
