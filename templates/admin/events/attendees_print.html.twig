<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Attendee list — {{ event.title }} — Y Wal</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: #1a1a1a;
      padding: 2rem;
    }
    .print-bar {
      display: flex; justify-content: flex-end; gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .print-bar button, .print-bar a {
      font-family: inherit; font-size: 0.875rem;
      padding: 0.5rem 1rem;
      border: 1px solid #d1d5db; border-radius: 6px;
      background: #fff; color: #1a1a1a;
      text-decoration: none; cursor: pointer;
    }
    .print-bar button { background: #2a9d8f; color: #fff; border-color: #2a9d8f; }
    h1 { font-size: 1.35rem; margin-bottom: 0.2rem; }
    .subtitle { color: #6b7280; font-size: 0.9375rem; margin-bottom: 1.5rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
    th, td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid #e5e7eb; }
    th {
      font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: 0.05em; color: #6b7280; background: #f9fafb;
    }
    .count { margin-top: 1rem; font-size: 0.8125rem; color: #6b7280; }
    .empty { color: #6b7280; font-size: 0.9375rem; }

    @media print {
      body { padding: 0; }
      .print-bar { display: none; }
    }
  </style>
</head>
<body>

  <div class="print-bar">
    <a href="{{ path('app_admin_event_show', event.isRecurring ? {id: event.id, date: occurrenceDate|date('Y-m-d')} : {id: event.id}) }}">&larr; Back to event</a>
    <button type="button" onclick="window.print()">Print</button>
  </div>

  <h1>{{ event.title }}</h1>
  <p class="subtitle">
    {{ (occurrenceDate ?? event.date)|date('l j F Y') }} &middot; {{ event.timeFrom }}&ndash;{{ event.timeTo }} &middot; {{ event.location }}
  </p>

  {% if attendees is empty %}
    <p class="empty">No attendees booked onto this occurrence.</p>
  {% else %}
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Membership number</th>
        </tr>
      </thead>
      <tbody>
        {% for attendee in attendees %}
          {% set user = attendee.user %}
          {% set name = (user.firstName ~ ' ' ~ user.lastName)|trim %}
          <tr>
            <td>{{ name ?: '—' }}</td>
            <td>{{ user.email ?: '—' }}</td>
            <td>#{{ user.id }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="count">{{ attendees|length }} {{ attendees|length == 1 ? 'attendee' : 'attendees' }}</p>
  {% endif %}

</body>
</html>
