{% extends 'admin/base.html.twig' %}
{% set memberName = order.user.displayName %}
{% set pillClass = order.status == 'complete' ? 'status-pill--published' : (order.status == 'cancelled' ? 'status-pill--cancelled' : 'status-pill--pending') %}
{% set pendingCardPayment = null %}
{% for payment in order.payments %}
  {% if payment.method == 'terminal' and payment.succeededAt is null and payment.failedAt is null %}
    {% set pendingCardPayment = payment %}
  {% endif %}
{% endfor %}
{% block title %}Sale #{{ order.id }}{% endblock %}

{% block content %}
{% set csrfToken = csrf_token('admin_sale_' ~ order.id) %}

<div class="page-header">
  <h1>Sale #{{ order.id }} — <a href="{{ path('app_admin_user_show', {id: order.user.id}) }}" class="admin-table__link">{{ memberName }}</a> <span class="status-pill {{ pillClass }}">{{ order.statusLabel }}</span></h1>
  <a href="{{ path('app_admin_sales') }}" class="btn btn--ghost btn--sm">← Sales</a>
</div>

<div class="member-columns{{ order.status != 'draft' ? ' member-columns--single' : '' }}">
  {% if order.status == 'draft' %}
  <div>
    <div class="page-header" style="margin-bottom:0.75rem;">
      <h2 style="font-size:1rem;">Products</h2>
    </div>
    {% if products is empty %}
      <div class="empty" style="padding:1.5rem 1rem;">No active products to sell.</div>
    {% else %}
      {% set typeTabs = [
        {key: 'membership', label: 'Memberships'},
        {key: 'event_ticket', label: 'Events'},
        {key: 'credit', label: 'Drop-ins'},
        {key: 'stock', label: 'Stock'},
        {key: 'service', label: 'Non-stock / services'},
      ] %}
      <input type="search" id="product-search" class="form-control" style="margin-bottom:0.75rem;"
             placeholder="Search products or SKU…" autocomplete="off">
      <div class="pos-tabs">
        {% for tab in typeTabs %}
          <button type="button" class="pos-tab" data-type="{{ tab.key }}">{{ tab.label }}</button>
        {% endfor %}
      </div>
      <div class="product-tile-grid">
        {% for product in products %}
          {% set eventTicketProduct = product.eventTicketProduct %}
          {% set isRecurringEvent = eventTicketProduct and eventTicketProduct.event.isRecurring %}
          <form method="post" action="{{ path('app_admin_sale_add_row', {id: order.id}) }}"
                data-type="{{ product.productType }}" data-name="{{ product.name }}"
                data-sku="{{ product.productType == 'stock' and product.stockProduct ? product.stockProduct.sku : '' }}"
                {% if isRecurringEvent %}data-recurring="1" data-event-id="{{ eventTicketProduct.event.id }}"{% endif %}>
            <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
            <input type="hidden" name="productId" value="{{ product.id }}">
            <button type="submit" class="product-tile">
              <span class="product-tile__name">
                {{ product.name }}{% if product.variantValue %}<br><small>{{ product.variantValue }}</small>{% endif %}
                {% if isRecurringEvent %}<br><small>Multiple dates</small>{% elseif eventTicketProduct %}<br><small>{{ eventTicketProduct.event.date|date('d M Y') }}</small>{% endif %}
              </span>
              <span class="product-tile__price">£{{ product.price }}</span>
            </button>
          </form>
        {% endfor %}
      </div>
      <div id="product-tile-empty" class="empty" style="display:none;padding:1.5rem 1rem;">No products in this category.</div>

      <div id="occurrence-modal" class="pos-modal" style="display:none;">
        <div id="occurrence-modal-backdrop" class="pos-modal__backdrop"></div>
        <div class="pos-modal__box">
          <div class="pos-modal__header">
            <strong id="occurrence-modal-title">Choose a date</strong>
            <button type="button" id="occurrence-modal-close" class="btn btn--ghost btn--sm">✕</button>
          </div>
          <div class="pos-modal__nav">
            <button type="button" id="occurrence-prev" class="btn btn--ghost btn--sm">&lsaquo; Prev</button>
            <span id="occurrence-month-label"></span>
            <button type="button" id="occurrence-next" class="btn btn--ghost btn--sm">Next &rsaquo;</button>
          </div>
          <div id="occurrence-calendar" class="pos-calendar-grid"></div>
          <p id="occurrence-empty" class="admin-table__muted" style="display:none;">No occurrences this month.</p>
        </div>
      </div>
    {% endif %}
  </div>
  {% endif %}

  <div>
    <div class="page-header" style="margin-bottom:0.75rem;">
      <h2 style="font-size:1rem;">Order</h2>
    </div>

    <div class="table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Qty</th>
            <th style="text-align:right;">Price</th>
            <th style="text-align:right;">Total</th>
            {% if order.status == 'draft' %}<th></th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for row in order.rows %}
            <tr>
              <td>
                {% set rowEventTicketProduct = row.product.eventTicketProduct %}
                {% if rowEventTicketProduct %}
                  <i class="bi bi-calendar3"></i>
                  <a href="{{ path('app_admin_event_show', rowEventTicketProduct.event.isRecurring ? {id: rowEventTicketProduct.event.id, date: row.occurrenceDate|date('Y-m-d')} : {id: rowEventTicketProduct.event.id}) }}" class="admin-table__link">{{ row.product.name }}</a>
                {% else %}
                  {{ row.product.name }}
                {% endif %}
                {% if row.product.variantValue %}<br><small class="admin-table__muted">{{ row.product.variantValue }}</small>{% endif %}
                {% if row.occurrenceDate %}<br><small class="admin-table__muted">{{ row.occurrenceDate|date('D d M Y') }}</small>{% endif %}
                {% if row.product.requiresBeneficiary %}
                  <br><small class="admin-table__muted">
                    For: {% if row.beneficiaryMember %}
                      {{ row.beneficiaryMember.displayName }}
                    {% else %}
                      {{ memberName }}
                    {% endif %}
                    {% if order.status == 'draft' %}
                      · <a href="#" class="beneficiary-change-link" data-row-id="{{ row.id }}">Change</a>
                    {% endif %}
                  </small>
                {% endif %}
              </td>
              <td>
                {% if order.status == 'draft' and not row.product.requiresBeneficiary %}
                  <div class="btn-row" style="flex-wrap:nowrap;align-items:center;">
                    <form method="post" action="{{ path('app_admin_sale_row_decrease', {id: order.id, rowId: row.id}) }}">
                      <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
                      <button type="submit" class="btn btn--ghost btn--sm" aria-label="Decrease quantity">−</button>
                    </form>
                    <span>{{ row.qty }}</span>
                    <form method="post" action="{{ path('app_admin_sale_row_increase', {id: order.id, rowId: row.id}) }}">
                      <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
                      <button type="submit" class="btn btn--ghost btn--sm" aria-label="Increase quantity">+</button>
                    </form>
                  </div>
                {% else %}
                  {{ row.qty }}
                {% endif %}
              </td>
              <td class="admin-table__muted" style="text-align:right;">
                {% if order.status == 'draft' %}
                  <button type="button" class="price-edit-trigger"
                          data-row-id="{{ row.id }}"
                          data-product-name="{{ row.product.name }}{% if row.product.variantValue %} ({{ row.product.variantValue }}){% endif %}"
                          data-standard-price="{{ row.listPriceAtSale }}"
                          data-current-price="{{ row.chargedPrice }}"
                          data-current-note="{{ row.note|e('html_attr') }}"
                          style="background:none;border:none;padding:0;font:inherit;color:inherit;cursor:pointer;text-decoration:underline;text-underline-offset:2px;">
                    £{{ row.chargedPrice }}
                  </button>
                {% else %}
                  £{{ row.chargedPrice }}
                {% endif %}
                {% if row.note %}<br><small class="admin-table__muted" style="font-style:italic;">{{ row.note }}</small>{% endif %}
              </td>
              <td class="admin-table__muted" style="text-align:right;">£{{ row.lineTotal }}</td>
              {% if order.status == 'draft' %}
                <td>
                  <form method="post" action="{{ path('app_admin_sale_row_remove', {id: order.id, rowId: row.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
                    <button type="submit" class="btn btn--ghost btn--sm">x</button>
                  </form>
                </td>
              {% endif %}
            </tr>
          {% else %}
            <tr><td colspan="6" class="admin-table__muted">No items yet — add a product from the left.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div style="text-align:right;font-weight:600;font-size:1.05rem;margin:0.9rem 0;">
      Total: £{{ order.total }}
    </div>

    {% if order.status == 'draft' %}
      {% if pendingCardPayment %}
        <div class="empty" style="padding:1.25rem 1rem;">
          Waiting for card payment confirmation (£{{ pendingCardPayment.amount }})… the card machine isn't connected yet, so this needs the Stripe integration to finish before it can confirm automatically.
        </div>
      {% elseif order.rows is empty %}
        {# Nothing to complete yet #}
      {% elseif order.total == '0.00' %}
        <form method="post" action="{{ path('app_admin_sale_complete_free', {id: order.id}) }}">
          <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
          <button type="submit" class="btn btn--teal">Complete order</button>
        </form>
      {% else %}
        <div id="complete-prompt">
          <button type="button" id="complete-order-btn" class="btn btn--teal">Complete order</button>
          <div id="payment-method-choice" class="card" style="display:none;margin-top:0.75rem;">
            <p style="margin-bottom:0.75rem;font-size:0.875rem;color:var(--muted);">Choose a payment method:</p>
            <div class="btn-row">
              <form method="post" action="{{ path('app_admin_sale_complete_cash', {id: order.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
                <button type="submit" class="btn btn--teal">Cash</button>
              </form>
              <form method="post" action="{{ path('app_admin_sale_pay_card', {id: order.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
                <button type="submit" class="btn btn--ghost">Card</button>
              </form>
            </div>
          </div>
        </div>
      {% endif %}
    {% endif %}

    {% if order.payments is not empty %}
      <div class="card" style="margin-top:1rem;">
        <div class="card__label">Payments</div>
        {% set methodLabels = {'cash': 'Cash', 'terminal': 'Card', 'online': 'Online'} %}
        {% for payment in order.payments %}
          <div style="font-size:0.875rem;padding:0.3rem 0;{% if not loop.last %}border-bottom:1px solid var(--border);{% endif %}">
            £{{ payment.amount }} · {{ methodLabels[payment.method] ?? payment.method }} · {{ payment.statusLabel }}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="card" style="margin-top:1rem;">
      <div class="card__label" style="margin-bottom:0.6rem;">Notes</div>
      {% include 'admin/_notes_panel.html.twig' with {notes: notes, noteableType: 'order', noteableId: order.id} %}
    </div>

    <div class="card" style="margin-top:1rem;font-size:0.8rem;color:var(--muted);">
      Created {{ order.createdAt|date('d M Y, H:i') }}
      {% if order.createdBy %}
        by <a href="{{ path('app_admin_user_show', {id: order.createdBy.id}) }}" class="admin-table__link">{{ order.createdBy.displayName }}</a>
      {% else %}
        automatically (online payment)
      {% endif %}
    </div>

    {% if order.status == 'draft' %}
      <div class="card" style="margin-top:1rem;">
        <div class="card__label" style="margin-bottom:0.6rem;">Danger zone</div>
        <form method="post" action="{{ path('app_admin_sale_delete', {id: order.id}) }}"
              onsubmit="return confirm('Permanently delete this order? This cannot be undone.');">
          <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
          <button type="submit" class="btn btn--danger btn--sm">Delete order</button>
        </form>
      </div>
    {% endif %}
  </div>
</div>

{% if order.status == 'draft' %}
  <div id="beneficiary-modal" class="pos-modal" style="display:none;">
    <div id="beneficiary-modal-backdrop" class="pos-modal__backdrop"></div>
    <div class="pos-modal__box">
      <div class="pos-modal__header">
        <strong>Change beneficiary</strong>
        <button type="button" id="beneficiary-modal-close" class="btn btn--ghost btn--sm">✕</button>
      </div>

      <div id="beneficiary-search-view">
        <input type="text" id="beneficiary-search" class="form-control" placeholder="Search members…"
               autocomplete="off" style="margin-bottom:0.75rem;">
        <div id="beneficiary-results" style="display:flex;flex-direction:column;gap:0.3rem;max-height:260px;overflow-y:auto;"></div>
        <button type="button" id="beneficiary-create-toggle" class="btn btn--ghost btn--sm" style="margin-top:0.75rem;">+ Create new person</button>
      </div>

      <div id="beneficiary-create-view" style="display:none;">
        <div class="form-group">
          <label for="beneficiary-firstName">First name</label>
          <input type="text" id="beneficiary-firstName" class="form-control" autocomplete="off" required>
        </div>
        <div class="form-group">
          <label for="beneficiary-lastName">Last name</label>
          <input type="text" id="beneficiary-lastName" class="form-control" autocomplete="off">
        </div>
        <div class="form-group">
          <label for="beneficiary-email">Email</label>
          <input type="email" id="beneficiary-email" class="form-control" autocomplete="off">
        </div>
        <div class="form-group">
          <label for="beneficiary-dateOfBirth">Date of birth</label>
          <input type="date" id="beneficiary-dateOfBirth" class="form-control" autocomplete="off">
        </div>
        <label style="display:flex;align-items:center;gap:0.5rem;font-weight:normal;margin-bottom:1rem;">
          <input type="checkbox" id="beneficiary-makeDependent" style="width:auto;">
          Make dependent of {{ memberName }}
        </label>
        <div class="btn-row">
          <button type="button" id="beneficiary-create-submit" class="btn btn--teal btn--sm">Create and use</button>
          <button type="button" id="beneficiary-create-cancel" class="btn btn--ghost btn--sm">← Back to search</button>
        </div>
      </div>
    </div>
  </div>

  <form id="beneficiary-select-form" method="post" action="{{ path('app_admin_sale_set_beneficiary', {id: order.id}) }}" style="display:none;">
    <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
    <input type="hidden" name="rowId" id="beneficiary-select-row-id">
    <input type="hidden" name="userId" id="beneficiary-select-user-id">
  </form>

  <form id="beneficiary-new-form" method="post" action="{{ path('app_admin_sale_create_beneficiary', {id: order.id}) }}" style="display:none;">
    <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
    <input type="hidden" name="rowId" id="beneficiary-new-row-id">
    <input type="hidden" name="firstName" id="beneficiary-new-firstName">
    <input type="hidden" name="lastName" id="beneficiary-new-lastName">
    <input type="hidden" name="email" id="beneficiary-new-email">
    <input type="hidden" name="dateOfBirth" id="beneficiary-new-dateOfBirth">
    <input type="hidden" name="makeDependent" id="beneficiary-new-makeDependent" value="">
  </form>

  <div id="price-modal" class="pos-modal" style="display:none;">
    <div id="price-modal-backdrop" class="pos-modal__backdrop"></div>
    <div class="pos-modal__box">
      <div class="pos-modal__header">
        <strong id="price-modal-title">Change price</strong>
        <button type="button" id="price-modal-close" class="btn btn--ghost btn--sm">✕</button>
      </div>

      <p id="price-modal-standard" class="admin-table__muted" style="margin-bottom:0.9rem;"></p>

      <div class="btn-row" style="margin-bottom:1rem;">
        <button type="button" class="btn btn--ghost btn--sm price-discount-btn" data-pct="10">10% off</button>
        <button type="button" class="btn btn--ghost btn--sm price-discount-btn" data-pct="25">25% off</button>
        <button type="button" class="btn btn--ghost btn--sm price-discount-btn" data-pct="50">50% off</button>
        <button type="button" class="btn btn--ghost btn--sm price-discount-btn" data-pct="100">100% off (free)</button>
      </div>

      <div class="form-group">
        <label for="price-modal-price">Price (£)</label>
        <input type="number" id="price-modal-price" class="form-control" min="0" step="0.01">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="price-modal-note">Note (required)</label>
        <textarea id="price-modal-note" class="form-control" rows="2" placeholder="Why is the price being changed?"></textarea>
      </div>

      <div id="price-modal-error" class="flash flash--error" style="display:none;margin-top:0.9rem;"></div>

      <div class="form-actions" style="margin-top:1rem;">
        <button type="button" id="price-modal-save" class="btn btn--teal btn--sm">Save</button>
      </div>
    </div>
  </div>

  <form id="price-update-form" method="post" action="{{ path('app_admin_sale_row_price', {id: order.id}) }}" style="display:none;">
    <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
    <input type="hidden" name="rowId" id="price-update-row-id">
    <input type="hidden" name="price" id="price-update-price">
    <input type="hidden" name="note" id="price-update-note">
  </form>
{% endif %}
{% endblock %}

{% block scripts %}
<style>
  .product-tile-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
    gap: 0.6rem;
  }
  .product-tile {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.35rem; width: 100%; min-height: 84px;
    background: var(--white); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 0.75rem 0.5rem; cursor: pointer; font-family: inherit;
    text-align: center; transition: border-color 0.12s, background 0.12s;
  }
  .product-tile:hover { border-color: var(--teal); background: #f0fdfa; }
  .product-tile:disabled { opacity: 0.55; cursor: default; pointer-events: none; }
  .product-tile__name { font-size: 0.85rem; font-weight: 500; color: var(--black); }
  .product-tile__name small { font-weight: 400; color: var(--muted); }
  .product-tile__price { font-size: 0.8rem; color: var(--teal-dk); font-weight: 600; }

  .pos-tab.is-disabled { opacity: 0.4; }

  .pos-tab-hint {
    font-size: 0.8rem; color: var(--teal-dk);
    background: #f0fdfa; border: 1px solid #99f6e4;
    border-radius: var(--radius); padding: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  .pos-modal__nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.875rem; font-weight: 500; }
  .pos-calendar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 0.4rem; }
  .pos-calendar-day {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.15rem; padding: 0.5rem 0.25rem; border-radius: 6px;
    border: 1px solid var(--border); background: var(--white);
    cursor: pointer; font-family: inherit;
  }
  .pos-calendar-day:hover { border-color: var(--teal); background: #f0fdfa; }
  .pos-calendar-day__num { font-size: 0.95rem; font-weight: 600; color: var(--black); }
  .pos-calendar-day__dow { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
</style>
{% if products is not empty and order.status == 'draft' %}
<script>
  const posTabs      = document.querySelectorAll('.pos-tab');
  const productForms = document.querySelectorAll('.product-tile-grid form[data-type]');
  const tileEmpty     = document.getElementById('product-tile-empty');
  const productSearch = document.getElementById('product-search');

  let activeType = posTabs[0] ? posTabs[0].dataset.type : null;

  function matchesQuery(form, query) {
    if (!query) return true;
    const name = (form.dataset.name || '').toLowerCase();
    const sku  = (form.dataset.sku || '').toLowerCase();
    return name.includes(query) || sku.includes(query);
  }

  function render() {
    const query = productSearch ? productSearch.value.trim().toLowerCase() : '';

    const matchingTypes = new Set();
    productForms.forEach(form => {
      if (matchesQuery(form, query)) matchingTypes.add(form.dataset.type);
    });

    if (query && matchingTypes.size === 1) {
      // Exactly one category has matches — jump to it.
      activeType = [...matchingTypes][0];
    } else if (query && !matchingTypes.has(activeType)) {
      // The current tab has nothing matching — move to the first one (in tab order) that does.
      for (const tab of posTabs) {
        if (matchingTypes.has(tab.dataset.type)) {
          activeType = tab.dataset.type;
          break;
        }
      }
    }

    posTabs.forEach(tab => {
      tab.classList.toggle('is-active', tab.dataset.type === activeType);
      tab.classList.toggle('is-disabled', query !== '' && !matchingTypes.has(tab.dataset.type));
    });

    let visible = 0;
    productForms.forEach(form => {
      const show = form.dataset.type === activeType && matchesQuery(form, query);
      form.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    tileEmpty.style.display = visible === 0 ? 'block' : 'none';
  }

  posTabs.forEach(tab => tab.addEventListener('click', () => {
    activeType = tab.dataset.type;
    render();
  }));

  if (productSearch) {
    productSearch.addEventListener('input', render);
  }

  // Default to the first tab that actually has products.
  for (const tab of posTabs) {
    if ([...productForms].some(form => form.dataset.type === tab.dataset.type)) {
      activeType = tab.dataset.type;
      break;
    }
  }
  render();

  // ── Recurring event tiles: pick an occurrence from a calendar modal before adding the row ──
  const occurrenceModal    = document.getElementById('occurrence-modal');
  const occurrenceBackdrop = document.getElementById('occurrence-modal-backdrop');
  const occurrenceClose    = document.getElementById('occurrence-modal-close');
  const occurrenceCalendar = document.getElementById('occurrence-calendar');
  const occurrenceMonthLbl = document.getElementById('occurrence-month-label');
  const occurrenceEmpty    = document.getElementById('occurrence-empty');
  const occurrencePrev     = document.getElementById('occurrence-prev');
  const occurrenceNext     = document.getElementById('occurrence-next');
  const occurrenceTitle    = document.getElementById('occurrence-modal-title');
  const occurrencesUrl     = '{{ path('app_admin_sale_occurrences') }}';

  let occurrenceForm = null;
  let occurrenceYear, occurrenceMonth, occurrenceEventId;

  function openOccurrenceModal(form) {
    occurrenceForm    = form;
    occurrenceEventId = form.dataset.eventId;
    occurrenceTitle.textContent = 'Choose a date — ' + (form.dataset.name || '');

    const now = new Date();
    occurrenceYear  = now.getFullYear();
    occurrenceMonth = now.getMonth() + 1;

    occurrenceModal.style.display = 'flex';
    loadOccurrences();
  }

  function closeOccurrenceModal() {
    occurrenceModal.style.display = 'none';
    occurrenceForm = null;
  }

  function loadOccurrences() {
    const url = `${occurrencesUrl}?eventId=${occurrenceEventId}&year=${occurrenceYear}&month=${occurrenceMonth}`;
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(r => r.json())
      .then(data => {
        occurrenceYear  = data.year;
        occurrenceMonth = data.month;
        occurrenceMonthLbl.textContent = data.monthLabel;
        renderOccurrenceCalendar(data.occurrences);
      });
  }

  function renderOccurrenceCalendar(occurrences) {
    occurrenceCalendar.innerHTML = '';
    occurrenceEmpty.style.display = occurrences.length ? 'none' : 'block';

    occurrences.forEach(dateStr => {
      const day = document.createElement('button');
      day.type = 'button';
      day.className = 'pos-calendar-day';
      const d = new Date(dateStr + 'T00:00:00');
      day.innerHTML = `<span class="pos-calendar-day__num">${d.getDate()}</span><span class="pos-calendar-day__dow">${d.toLocaleDateString(undefined, {weekday: 'short'})}</span>`;
      day.addEventListener('click', () => chooseOccurrence(dateStr));
      occurrenceCalendar.appendChild(day);
    });
  }

  function chooseOccurrence(dateStr) {
    if (!occurrenceForm) return;

    let input = occurrenceForm.querySelector('input[name="occurrenceDate"]');
    if (!input) {
      input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'occurrenceDate';
      occurrenceForm.appendChild(input);
    }
    input.value = dateStr;
    // requestSubmit() (unlike submit()) fires a real 'submit' event, so the global
    // double-submit-prevention handler in base.html.twig also applies here.
    occurrenceForm.requestSubmit();
  }

  occurrenceClose.addEventListener('click', closeOccurrenceModal);
  occurrenceBackdrop.addEventListener('click', closeOccurrenceModal);
  occurrencePrev.addEventListener('click', () => {
    occurrenceMonth--;
    if (occurrenceMonth < 1) { occurrenceMonth = 12; occurrenceYear--; }
    loadOccurrences();
  });
  occurrenceNext.addEventListener('click', () => {
    occurrenceMonth++;
    if (occurrenceMonth > 12) { occurrenceMonth = 1; occurrenceYear++; }
    loadOccurrences();
  });

  productForms.forEach(form => {
    if (form.dataset.recurring === '1') {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        openOccurrenceModal(form);
      });
    }
  });
</script>
{% endif %}
{% if not pendingCardPayment and order.status == 'draft' and order.rows is not empty and order.total != '0.00' %}
<script>
  document.getElementById('complete-order-btn').addEventListener('click', () => {
    document.getElementById('complete-order-btn').style.display = 'none';
    document.getElementById('payment-method-choice').style.display = 'block';
  });
</script>
{% endif %}
{% if order.status == 'draft' %}
<script>
  const beneficiaryModal      = document.getElementById('beneficiary-modal');
  const beneficiaryBackdrop   = document.getElementById('beneficiary-modal-backdrop');
  const beneficiaryClose      = document.getElementById('beneficiary-modal-close');
  const beneficiarySearchView = document.getElementById('beneficiary-search-view');
  const beneficiaryCreateView = document.getElementById('beneficiary-create-view');
  const beneficiarySearch     = document.getElementById('beneficiary-search');
  const beneficiaryResults    = document.getElementById('beneficiary-results');
  const beneficiaryCreateToggle = document.getElementById('beneficiary-create-toggle');
  const beneficiaryCreateCancel = document.getElementById('beneficiary-create-cancel');
  const beneficiaryCreateSubmit = document.getElementById('beneficiary-create-submit');
  const beneficiarySearchUrl  = '{{ path('app_admin_sale_beneficiary_search', {id: order.id}) }}';

  let beneficiaryRowId = null;
  let beneficiarySearchDebounce;

  function openBeneficiaryModal(rowId) {
    beneficiaryRowId = rowId;
    beneficiarySearch.value = '';
    showBeneficiarySearchView();
    beneficiaryModal.style.display = 'flex';
    loadBeneficiaryResults('');
  }

  function closeBeneficiaryModal() {
    beneficiaryModal.style.display = 'none';
    beneficiaryRowId = null;
  }

  function showBeneficiarySearchView() {
    beneficiarySearchView.style.display = '';
    beneficiaryCreateView.style.display = 'none';
  }

  function showBeneficiaryCreateView() {
    beneficiarySearchView.style.display = 'none';
    beneficiaryCreateView.style.display = '';
  }

  function loadBeneficiaryResults(query) {
    fetch(`${beneficiarySearchUrl}?q=${encodeURIComponent(query)}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(r => r.json())
      .then(members => {
        if (!members.length) {
          beneficiaryResults.innerHTML = `<div class="member-search-empty">${query ? 'No members found' : 'No dependents on record — search for someone, or create a new person'}</div>`;
          return;
        }
        beneficiaryResults.innerHTML = members.map(m => `<button type="button" class="member-search-item" data-id="${m.id}">${m.label}</button>`).join('');
      });
  }

  beneficiarySearch.addEventListener('input', () => {
    clearTimeout(beneficiarySearchDebounce);
    beneficiarySearchDebounce = setTimeout(() => loadBeneficiaryResults(beneficiarySearch.value.trim()), 250);
  });

  beneficiaryResults.addEventListener('click', (e) => {
    const btn = e.target.closest('.member-search-item');
    if (!btn || !beneficiaryRowId) return;

    document.getElementById('beneficiary-select-row-id').value = beneficiaryRowId;
    document.getElementById('beneficiary-select-user-id').value = btn.dataset.id;
    document.getElementById('beneficiary-select-form').requestSubmit();
  });

  beneficiaryCreateToggle.addEventListener('click', showBeneficiaryCreateView);
  beneficiaryCreateCancel.addEventListener('click', showBeneficiarySearchView);

  beneficiaryCreateSubmit.addEventListener('click', () => {
    if (!beneficiaryRowId) return;

    const firstName = document.getElementById('beneficiary-firstName').value.trim();
    if (!firstName) {
      document.getElementById('beneficiary-firstName').focus();
      return;
    }

    document.getElementById('beneficiary-new-row-id').value = beneficiaryRowId;
    document.getElementById('beneficiary-new-firstName').value = firstName;
    document.getElementById('beneficiary-new-lastName').value = document.getElementById('beneficiary-lastName').value.trim();
    document.getElementById('beneficiary-new-email').value = document.getElementById('beneficiary-email').value.trim();
    document.getElementById('beneficiary-new-dateOfBirth').value = document.getElementById('beneficiary-dateOfBirth').value;
    document.getElementById('beneficiary-new-makeDependent').value = document.getElementById('beneficiary-makeDependent').checked ? '1' : '';
    document.getElementById('beneficiary-new-form').requestSubmit();
  });

  beneficiaryClose.addEventListener('click', closeBeneficiaryModal);
  beneficiaryBackdrop.addEventListener('click', closeBeneficiaryModal);

  document.querySelectorAll('.beneficiary-change-link').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      openBeneficiaryModal(link.dataset.rowId);
    });
  });

  // ── Change price modal ────────────────────────────────────
  const priceModal         = document.getElementById('price-modal');
  const priceModalBackdrop = document.getElementById('price-modal-backdrop');
  const priceModalClose    = document.getElementById('price-modal-close');
  const priceModalTitle    = document.getElementById('price-modal-title');
  const priceModalStandard = document.getElementById('price-modal-standard');
  const priceModalPrice    = document.getElementById('price-modal-price');
  const priceModalNote     = document.getElementById('price-modal-note');
  const priceModalError    = document.getElementById('price-modal-error');
  const priceModalSave     = document.getElementById('price-modal-save');

  let priceRowId       = null;
  let priceStandardValue = 0;

  function openPriceModal(trigger) {
    priceRowId          = trigger.dataset.rowId;
    priceStandardValue  = parseFloat(trigger.dataset.standardPrice) || 0;

    priceModalTitle.textContent = 'Change price — ' + trigger.dataset.productName;
    priceModalStandard.textContent = 'Standard price: £' + priceStandardValue.toFixed(2);
    priceModalPrice.value = trigger.dataset.currentPrice;
    priceModalNote.value  = trigger.dataset.currentNote || '';
    priceModalError.style.display = 'none';

    priceModal.style.display = 'flex';
  }

  function closePriceModal() {
    priceModal.style.display = 'none';
    priceRowId = null;
  }

  document.querySelectorAll('.price-edit-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => openPriceModal(trigger));
  });

  document.querySelectorAll('.price-discount-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pct = parseFloat(btn.dataset.pct);
      priceModalPrice.value = (priceStandardValue * (1 - pct / 100)).toFixed(2);
    });
  });

  priceModalSave.addEventListener('click', () => {
    const price = parseFloat(priceModalPrice.value);
    if (priceModalPrice.value === '' || isNaN(price) || price < 0) {
      priceModalError.textContent = 'Enter a valid price.';
      priceModalError.style.display = 'block';
      return;
    }

    if (!priceModalNote.value.trim()) {
      priceModalError.textContent = 'A note is required when changing the price.';
      priceModalError.style.display = 'block';
      return;
    }

    document.getElementById('price-update-row-id').value = priceRowId;
    document.getElementById('price-update-price').value = priceModalPrice.value;
    document.getElementById('price-update-note').value = priceModalNote.value.trim();
    document.getElementById('price-update-form').requestSubmit();
  });

  priceModalClose.addEventListener('click', closePriceModal);
  priceModalBackdrop.addEventListener('click', closePriceModal);
</script>
{% endif %}
{% endblock %}
