{% extends 'admin/base.html.twig' %}
{% block title %}Sales{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Sales</h1>
  <a href="{{ path('app_admin_users', {context: 'new_sale'}) }}" class="btn btn--teal btn--sm">+ New sale</a>
</div>

{% if orders is empty %}
  <div class="empty">
    <strong>No sales yet</strong>
    Start a new sale to sell stock, credits, memberships or event tickets.
  </div>
{% else %}
  <div class="table-scroll">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Member</th>
          <th>Status</th>
          <th style="text-align:right;">Total</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for order in orders %}
          {% set displayName = (order.user.firstName ~ ' ' ~ order.user.lastName)|trim %}
          {% set pillClass = order.status == 'complete' ? 'status-pill--published' : (order.status == 'cancelled' ? 'status-pill--cancelled' : 'status-pill--pending') %}
          <tr>
            <td class="admin-table__muted">#{{ order.id }}</td>
            <td>
              <a href="{{ path('app_admin_user_show', {id: order.user.id}) }}" class="admin-table__link">
                {{ displayName ?: (order.user.email ?: 'Member #' ~ order.user.id) }}
              </a>
            </td>
            <td><span class="status-pill {{ pillClass }}">{{ order.statusLabel }}</span></td>
            <td class="admin-table__muted" style="text-align:right;">£{{ order.total }}</td>
            <td class="admin-table__muted">{{ order.createdAt|date('d M Y H:i') }}</td>
            <td>
              <a href="{{ path('app_admin_sale_show', {id: order.id}) }}" class="admin-table__link">
                {{ order.status == 'draft' ? 'Continue' : 'View' }}
              </a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
