{% extends 'base.html.twig' %}

{% block title %}Shop — Y Wal{% endblock %}

{% block head %}
{{ include('shop/_styles.html.twig') }}
{% endblock %}

{% block content %}
{% set categories = [
  {key: 'membership', type: 'membership', label: 'Memberships'},
  {key: 'event_ticket', type: 'event_ticket', label: 'Event tickets'},
  {key: 'credit', type: 'credit', label: 'Drop-in credits'},
  {key: 'stock', type: 'stock', label: 'Items'},
  {key: 'other', type: 'service', label: 'Other'},
] %}
{# key is the ?category= value in the URL; type is the Product::TYPE_* it lists. Only categories with something in them are offered; an unknown or empty ?category= falls back to showing everything. #}
{% set categories = categories|filter(c => products|filter(p => p.productType == c.type)|length > 0) %}
{% set requestedCategory = app.request.query.get('category', '') %}
{% set activeCategory = categories|filter(c => c.key == requestedCategory)|length > 0 ? requestedCategory : '' %}

<div class="shop-page">
  <div class="wrap">
    <div class="shop-header">
      <div>
        <h1>Shop</h1>
        <p class="subtitle">Memberships, drop-in credits, event tickets, services and items from the wall.</p>
      </div>
      {% if app.user %}
        <a href="{{ path('app_cart') }}" class="shop-cart-link">View cart ({{ cartCount }}) &rarr;</a>
      {% else %}
        <a href="{{ path('app_login', {returnTo: app.request.requestUri}) }}" class="shop-cart-link">Sign in to buy &rarr;</a>
      {% endif %}
    </div>

    {% for msg in app.flashes('success') %}<div class="alert--success">{{ msg }}</div>{% endfor %}
    {% for msg in app.flashes('error') %}<div class="alert--error">{{ msg }}</div>{% endfor %}

    {% if products is empty %}
      <p class="shop-empty">Nothing's available to buy online right now.</p>
    {% else %}
      <div class="shop-layout">
        <nav class="shop-cats" aria-label="Shop categories">
          <div class="shop-cats__title">Categories</div>
          <ul class="shop-cats__list">
            <li>
              <a href="{{ path('app_shop') }}" class="shop-cats__link{{ activeCategory == '' ? ' is-active' }}"{% if activeCategory == '' %} aria-current="page"{% endif %}>
                All <span class="shop-cats__count">{{ products|length }}</span>
              </a>
            </li>
            {% for category in categories %}
              <li>
                <a href="{{ path('app_shop', {category: category.key}) }}" class="shop-cats__link{{ activeCategory == category.key ? ' is-active' }}"{% if activeCategory == category.key %} aria-current="page"{% endif %}>
                  {{ category.label }} <span class="shop-cats__count">{{ products|filter(p => p.productType == category.type)|length }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>

        <div class="shop-main">
          {% for section in categories|filter(c => activeCategory == '' or c.key == activeCategory) %}
            {% set sectionProducts = products|filter(p => p.productType == section.type) %}
            {% if section.type == 'event_ticket' %}
              {% set sectionProducts = sectionProducts|sort((a, b) => a.eventTicketProduct.event.date <=> b.eventTicketProduct.event.date) %}
            {% endif %}
            <section class="shop-section">
              <h2 class="shop-section-title">{{ section.label }}</h2>
              <div class="shop-grid">
                {% for product in sectionProducts %}
                  {{ include('shop/_product_tile.html.twig') }}
                {% endfor %}
              </div>
            </section>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
