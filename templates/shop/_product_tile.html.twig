{# One product card with its add-to-cart form. Expects `product`; shared by the shop and the single-item landing page. #}
  {% set imageUrl = product_image_url(product) %}
  {% set ticket = product.eventTicketProduct %}
  {% set event = ticket ? ticket.event : null %}
  <article class="shop-item">
    <div class="shop-item__media">
      {% if imageUrl %}
        <img src="{{ imageUrl }}" alt="" loading="lazy">
      {% else %}
        <span class="shop-item__placeholder" aria-hidden="true">{{ product.name|first|upper }}</span>
      {% endif %}
    </div>
    <div class="shop-item__body">
      <div class="shop-item__name">
        {{ product.name }}
        {% if product.variantValue %}<span class="shop-item__variant">({{ product.variantValue }})</span>{% endif %}
      </div>
      <div class="shop-item__price">£{{ product.price }}</div>
      {% if event %}
        <p class="shop-item__event">
          <a href="{{ path('app_event_landing', {id: event.id}) }}">{{ event.title }}</a><br>
          {% if event.isRecurring %}Several dates{% else %}{{ event.date|date('D j M Y') }}{% if event.timeFrom %}, {{ event.timeFrom }}{% endif %}{% endif %}
          {% if ticket.membershipType %}<br><span class="shop-item__badge">{{ ticket.membershipType.name }} members</span>{% endif %}
        </p>
      {% endif %}
      {% if product.shortDescription %}
        <p class="shop-item__desc">{{ product.shortDescription }}</p>
      {% endif %}

      <div class="shop-item__actions">
        {% if not app.user %}
          <a href="{{ path('app_login', {returnTo: app.request.requestUri}) }}" class="btn btn--teal">Sign in to buy</a>
        {% elseif event and event.isRecurring %}
          {# A recurring event's ticket needs a date, and the event page has the date picker. #}
          <a href="{{ path('app_event_landing', {id: event.id}) }}" class="btn btn--teal">Choose a date</a>
        {% else %}
          {% set people = [app.user]|merge(app.user.dependents.toArray) %}
          {% if event %}
            {% set people = people|filter(person => event.allowsUser(person) and (not ticket.membershipType or person.hasActiveMembershipType(ticket.membershipType))) %}
          {% endif %}

          {% if people is empty %}
            <p class="shop-item__field-hint">
              {% if ticket.membershipType %}Only for {{ ticket.membershipType.name }} members.{% else %}You or your dependents don't hold the certification this event needs.{% endif %}
            </p>
          {% else %}
            <form method="post" action="{{ path('app_shop_add') }}" class="shop-item__form">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('shop_add') }}">
              <input type="hidden" name="productId" value="{{ product.id }}">

              {% if product.productType not in ['stock', 'service'] %}
                {% if people|length > 1 %}
                  <div class="shop-item__field">
                    <label for="beneficiary-{{ product.id }}">For</label>
                    <select id="beneficiary-{{ product.id }}" name="beneficiaryId">
                      {% for person in people %}
                        <option value="{{ person == app.user ? '' : person.id }}">{{ person == app.user ? 'Myself' : person.displayName }}</option>
                      {% endfor %}
                    </select>
                  </div>
                {% else %}
                  {% set person = people|first %}
                  <input type="hidden" name="beneficiaryId" value="{{ person == app.user ? '' : person.id }}">
                  <p class="shop-item__field-inline">For: <strong>{{ person == app.user ? 'Me' : person.displayName }}</strong></p>
                {% endif %}
              {% endif %}

              {# A stock or service item, or a ticket for an unrestricted event, can be bought several at a time. #}
              {% if product.productType in ['stock', 'service'] or (event and event.restrictions is empty) %}
                <div class="shop-item__field">
                  <label for="qty-{{ product.id }}">Qty</label>
                  <input type="number" id="qty-{{ product.id }}" name="qty" value="1" min="1">
                </div>
              {% endif %}

              <button type="submit" class="btn btn--teal">Add to cart</button>
            </form>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </article>
