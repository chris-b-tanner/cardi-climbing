<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ subject }}</title>
<style>
  body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
  body{margin:0;padding:0;background-color:#ffffff;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
  table{border-collapse:collapse}
  a{color:#1e4f41}
</style>
</head>
<body style="margin:0;padding:0;background-color:#ffffff;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffffff;">
  <tr>
    <td style="padding:24px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#2b2b2b;line-height:1.7;text-align:left;">

      {% for line in body|split('\n') %}
        {% if line|trim %}
          <p style="margin:0 0 16px;">{{ line|raw }}</p>
        {% else %}
          <p style="margin:0 0 8px;"></p>
        {% endif %}
      {% endfor %}

      {% if recipientEmail is defined and recipientEmail %}
        <p style="margin:24px 0 0;font-size:12px;color:#9a9895;">
          <a href="{{ unsubscribe_url(recipientEmail) }}" style="color:#9a9895;text-decoration:underline;">Unsubscribe</a> from these emails
        </p>
      {% endif %}

      {% if user is defined %}
        <p style="margin:8px 0 0;font-size:11px;color:#c4c2bc;">ywal-u-{{ user.id }}</p>
      {% endif %}

    </td>
  </tr>
</table>

</body>
</html>
