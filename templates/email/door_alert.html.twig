{% extends 'email/layout.html.twig' %}

{% block emailTitle %}Door alert — {{ reasonLabel }}{% endblock %}

{% block emailBody %}
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#c0392b;margin:0 0 8px;">
    Door alert
  </p>
  <h1 style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;font-weight:700;text-transform:uppercase;letter-spacing:-0.01em;color:#141414;margin:0 0 28px;">
    {{ reasonLabel }} <span style="color:#9a9895;font-size:16px;text-transform:none;">(door {{ log.doorId }})</span>
  </h1>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    {{ log.message }}
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#5a5857;">
    <tr>
      <td style="padding:6px 0;color:#9a9895;">Device time</td>
      <td style="padding:6px 0;text-align:right;">{{ log.timestamp|date('j M Y, H:i:s', 'UTC') }} UTC</td>
    </tr>
    <tr>
      <td style="padding:6px 0;color:#9a9895;">Server time</td>
      <td style="padding:6px 0;text-align:right;">{{ log.receivedAt|date('j M Y, H:i:s', 'UTC') }} UTC</td>
    </tr>
  </table>

  <hr style="border:none;border-top:1px solid #e4e2dc;margin:28px 0;">

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#9a9895;line-height:1.6;margin:0;">
    Automated alert from the self-access door controller — no action needed from this email
    itself, but the door may need checking in person.
  </p>
{% endblock %}
