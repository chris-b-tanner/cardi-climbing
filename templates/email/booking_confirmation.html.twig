{% extends 'email/layout.html.twig' %}

{% block emailTitle %}Booking confirmed — Y Wal{% endblock %}

{% block emailBody %}
  <h1 style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;font-weight:700;text-transform:uppercase;letter-spacing:-0.01em;color:#141414;margin:0 0 8px;">
    You're booked!
  </h1>
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#b0bd80;margin:0 0 28px;">
    Y Wal
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 16px;">
    Hi{% if user.firstName %} {{ user.firstName }}{% endif %},
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    Your place on <strong style="color:#141414;">{{ event.title }}</strong> is confirmed. Here are the details:
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 28px;border:1px solid #e4e2dc;">
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;width:100px;border-bottom:1px solid #e4e2dc;">Date</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ occurrenceDate|date('l j F Y') }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;border-bottom:1px solid #e4e2dc;">Time</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ event.timeFrom }}&ndash;{{ event.timeTo }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;{% if not event.description %}border-bottom:none;{% else %}border-bottom:1px solid #e4e2dc;{% endif %}">Location</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;{% if not event.description %}border-bottom:none;{% else %}border-bottom:1px solid #e4e2dc;{% endif %}">{{ event.location }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;">Price</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;">Free</td>
    </tr>
  </table>

  {% if event.description %}
    <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 28px;">
      {{ event.description }}
    </p>
  {% endif %}

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#5a5857;line-height:1.7;margin:0 0 32px;">
    Can't make it any more? You can cancel your place any time from the
    <a href="https://www.cardiganclimbing.org/account#bookings" style="color:#1e4f41;">bookings tab in your account</a>.
  </p>

  <hr style="border:none;border-top:1px solid #e4e2dc;margin:28px 0;">

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;line-height:1.6;margin:0;">
    You&rsquo;re receiving this because you booked onto an event at
    <a href="https://www.cardiganclimbing.org" style="color:#1e4f41;text-decoration:none;">www.cardiganclimbing.org</a>.
  </p>
{% endblock %}
