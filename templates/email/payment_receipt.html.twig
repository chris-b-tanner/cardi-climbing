{% extends 'email/layout.html.twig' %}

{% block emailTitle %}Payment receipt — Y Wal{% endblock %}

{% block emailBody %}
  <h1 style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;font-weight:700;text-transform:uppercase;letter-spacing:-0.01em;color:#141414;margin:0 0 8px;">
    Thank you!
  </h1>
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#b0bd80;margin:0 0 28px;">
    Y Wal
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    Hi{% if user.firstName %} {{ user.firstName }}{% endif %},
  </p>

  {% set description = payment.order ? 'Sale #' ~ payment.order.id : (payment.attendee ? payment.attendee.event.title : 'Donation') %}
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    {% if payment.isDonation %}
      We've received your donation — thank you for supporting Y Wal! Here's your receipt:
    {% else %}
      We've received your payment for <strong style="color:#141414;">{{ description }}</strong>. Here's your receipt:
    {% endif %}
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 28px;border:1px solid #e4e2dc;">
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;width:100px;border-bottom:1px solid #e4e2dc;">Date</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ payment.succeededAt|date('l j F Y') }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;border-bottom:1px solid #e4e2dc;">Description</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ description }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;border-bottom:1px solid #e4e2dc;">Payment method</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ payment.method == 'terminal' ? 'Card (in person)' : 'Card (online)' }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;">Amount</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;">£{{ payment.amount }}</td>
    </tr>
  </table>

  {% if payment.order and payment.order.rows is not empty %}
    {% set cell = "font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;padding:10px 16px;border-bottom:1px solid #e4e2dc;vertical-align:top;" %}
    <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#141414;margin:0 0 10px;">
      Order summary
    </p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 28px;border:1px solid #e4e2dc;">
      <tr>
        <td style="{{ cell }}font-size:12px;color:#9a9895;text-transform:uppercase;letter-spacing:0.05em;">Item</td>
        <td style="{{ cell }}font-size:12px;color:#9a9895;text-transform:uppercase;letter-spacing:0.05em;text-align:center;width:40px;">Qty</td>
        <td style="{{ cell }}font-size:12px;color:#9a9895;text-transform:uppercase;letter-spacing:0.05em;text-align:right;width:80px;">Price</td>
      </tr>
      {% for row in payment.order.rows %}
        <tr>
          <td style="{{ cell }}font-size:14px;color:#141414;font-weight:600;">
            {{ row.product.name }}
            {% if row.product.variantValue %}<br><span style="font-size:13px;color:#5a5857;font-weight:400;">{{ row.product.variantValue }}</span>{% endif %}
            {% if row.occurrenceDate %}<br><span style="font-size:13px;color:#5a5857;font-weight:400;">{{ row.occurrenceDate|date('l j F Y') }}</span>{% endif %}
            {% if row.beneficiaryMember and row.beneficiaryMember != user %}<br><span style="font-size:13px;color:#5a5857;font-weight:400;">For {{ row.beneficiaryMember.displayName }}</span>{% endif %}
          </td>
          <td style="{{ cell }}font-size:14px;color:#141414;text-align:center;">{{ row.qty }}</td>
          <td style="{{ cell }}font-size:14px;color:#141414;text-align:right;">£{{ row.lineTotal }}</td>
        </tr>
      {% endfor %}
      <tr>
        <td colspan="2" style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:700;">Total</td>
        <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:700;text-align:right;">£{{ payment.order.total }}</td>
      </tr>
    </table>
  {% endif %}

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#5a5857;line-height:1.7;margin:0;">
    Please keep this email as your receipt for this payment.
  </p>
{% endblock %}
