{% extends 'email/layout.html.twig' %}

{% block emailTitle %}Payment receipt — Y Wal{% endblock %}

{% block emailBody %}
  <h1 style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;font-weight:700;text-transform:uppercase;letter-spacing:-0.01em;color:#141414;margin:0 0 8px;">
    Thank you!
  </h1>
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#b0bd80;margin:0 0 28px;">
    Y Wal
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    Hi{% if user.firstName %} {{ user.firstName }}{% endif %},
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    {% if payment.isDonation %}
      We've received your donation — thank you for supporting Y Wal! Here's your receipt:
    {% else %}
      We've received your payment for <strong style="color:#141414;">{{ payment.attendee.event.title }}</strong>. Here's your receipt:
    {% endif %}
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 28px;border:1px solid #e4e2dc;">
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;width:100px;border-bottom:1px solid #e4e2dc;">Date</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ payment.succeededAt|date('l j F Y') }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;border-bottom:1px solid #e4e2dc;">Description</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ payment.isDonation ? 'Donation' : payment.attendee.event.title }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;border-bottom:1px solid #e4e2dc;">Payment method</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;border-bottom:1px solid #e4e2dc;">{{ payment.method == 'terminal' ? 'Card (in person)' : 'Card (online)' }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;color:#9a9895;">Amount</td>
      <td style="padding:10px 16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#141414;font-weight:600;">£{{ payment.amount }}</td>
    </tr>
  </table>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;color:#5a5857;line-height:1.7;margin:0;">
    Please keep this email as your receipt for this payment.
  </p>
{% endblock %}
