{% extends 'email/layout.html.twig' %}

{% block emailTitle %}Welcome to Y Wal!{% endblock %}

{% block emailBody %}
  <h1 style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;font-weight:700;text-transform:uppercase;letter-spacing:-0.01em;color:#141414;margin:0 0 8px;">
    Welcome to Y Wal!
  </h1>
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#b0bd80;margin:0 0 28px;">
    Y Wal &mdash; Members area
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 16px;">
    Hi{% if user.firstName %} {{ user.firstName }}{% endif %},
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 16px;">
    Thanks for creating an account &mdash; you're all set. You can log in any time to book onto
    events, and manage your bookings and certifications.
  </p>

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 32px;">
    Before you visit the centre, it's worth checking your account profile is complete (address,
    emergency contact, and so on) &mdash; it'll save you time at reception.
  </p>

  <!-- CTA button -->
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 32px;">
    <tr>
      <td style="background-color:#1e4f41;">
        <a href="{{ accountUrl }}"
           style="display:inline-block;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:#ffffff;text-decoration:none;padding:14px 32px;border:2px solid #1e4f41;">
          Go to my account
        </a>
      </td>
    </tr>
  </table>

  <hr style="border:none;border-top:1px solid #e4e2dc;margin:28px 0;">

  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#9a9895;line-height:1.6;margin:0;">
    You&rsquo;re receiving this because you created an account at
    <a href="https://www.cardiganclimbing.org" style="color:#1e4f41;text-decoration:none;">www.cardiganclimbing.org</a>.
  </p>
{% endblock %}
