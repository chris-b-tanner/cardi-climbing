<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{% block emailTitle %}Y Wal{% endblock %}</title>
<!--[if mso]>
<noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<![endif]-->
<style>
  body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
  img{-ms-interpolation-mode:bicubic}
  body{margin:0;padding:0;background-color:#f6f6f3;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif}
  table{border-collapse:collapse}
  a{color:#1e4f41}
  @media only screen and (max-width:600px){
    .email-wrapper{width:100%!important}
    .email-card{padding:36px 28px!important}
    .email-footer{padding:24px 28px 28px!important}
  }
</style>
</head>
<body style="margin:0;padding:0;background-color:#f6f6f3;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f6f3;padding:40px 0;">
  <tr>
    <td align="center">

      <!-- Email wrapper -->
      <table class="email-wrapper" role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">

        <!-- Header -->
        <tr>
          <td style="background-color:#ffffff;padding:26px 40px;border-radius:16px 16px 0 0;border-bottom:3px solid #b0bd80;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td>
                  <span style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#141414;">
                    Y <span style="color:#b0bd80;">WAL</span>
                  </span>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Body card -->
        <tr>
          <td class="email-card" style="background-color:#ffffff;padding:48px 40px 40px;">
            {% block emailBody %}{% endblock %}
          </td>
        </tr>

        <!-- Footer image — fades from white into brand green -->
        <tr>
          <td style="background-color:#ffffff;line-height:0;font-size:0;">
            <img src="https://www.cardiganclimbing.org/images/email-footer.png" width="600" alt=""
                 style="display:block;width:100%;max-width:600px;height:auto;border:0;">
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td class="email-footer" style="background-color:#b0bd80;padding:28px 40px 32px;border-radius:0 0 16px 16px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td align="center" style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#ffffff;line-height:1.6;">
                  <p style="margin:0 0 4px;font-weight:700;letter-spacing:0.02em;">Y Wal</p>
                  <p style="margin:0 0 10px;color:rgba(255,255,255,0.85);">Cardigan (Aberteifi), Ceredigion, Wales</p>
                  <p style="margin:0 0 {% if recipientEmail is defined and recipientEmail %}10px{% else %}0{% endif %};">
                    <a href="mailto:cardiganclimbing@gmail.com" style="color:#ffffff;text-decoration:underline;">cardiganclimbing@gmail.com</a>
                    &nbsp;&bull;&nbsp;
                    <a href="https://www.cardiganclimbing.org" style="color:#ffffff;text-decoration:underline;">www.cardiganclimbing.org</a>
                  </p>
                  {% if recipientEmail is defined and recipientEmail %}
                  <p style="margin:0;">
                    <a href="{{ unsubscribe_url(recipientEmail) }}" style="color:rgba(255,255,255,0.85);text-decoration:underline;">Unsubscribe</a> from these emails
                  </p>
                  {% endif %}
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
      <!-- /Email wrapper -->

    </td>
  </tr>
</table>

</body>
</html>
