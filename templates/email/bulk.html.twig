{% extends 'email/layout.html.twig' %}

{% block emailTitle %}{{ subject }}{% endblock %}

{% block emailStyles %}a{color:#0000ee;text-decoration:underline}
  .email-card td,.email-card th{font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7}{% endblock %}

{% block emailBody %}
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    Hi{% if user is defined and user.firstName %} {{ user.firstName }}{% endif %},
  </p>

  {% for block in body|email_blocks("font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7") %}
    {% if block.type == 'html' %}
      {{ block.html|raw }}
    {% elseif block.type == 'p' %}
      <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 16px;">{{ block.html|raw }}</p>
    {% else %}
      <p style="margin:0 0 8px;"></p>
    {% endif %}
  {% endfor %}

  {% if user is defined %}
    <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;color:#c4c2bc;margin:24px 0 0;">ywal-u-{{ user.id }}</p>
  {% endif %}
{% endblock %}
