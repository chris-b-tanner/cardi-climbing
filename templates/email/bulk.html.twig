{% extends 'email/layout.html.twig' %}

{% block emailTitle %}{{ subject }}{% endblock %}

{% block emailBody %}
  <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 24px;">
    Hi{% if user is defined and user.firstName %} {{ user.firstName }}{% endif %},
  </p>

  {% for line in body|split('\n') %}
    {% if line|trim %}
      <p style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;color:#5a5857;line-height:1.7;margin:0 0 16px;">{{ line }}</p>
    {% else %}
      <p style="margin:0 0 8px;"></p>
    {% endif %}
  {% endfor %}
{% endblock %}
