{% extends 'base.html.twig' %}

{% block title %}Donate — Y Wal{% endblock %}

{% block head %}
<style>
  .donate-page { padding: 7rem 1rem 5rem; }
  .donate-wrap { max-width: 560px; margin: 0 auto; }
  .donate-wrap h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
  .donate-back-link { font-size: 0.875rem; color: #6b7280; text-decoration: none; display: inline-block; margin-bottom: 1.5rem; }
  .donate-back-link:hover { color: #1a1a1a; }

  .account-card {
    background: #fff; border: 1px solid #e5e7eb;
    border-radius: 10px; padding: 1.5rem; margin-bottom: 1.25rem;
  }
  .account-card__title {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #6b7280; margin-bottom: 1rem;
  }

  .field { margin-bottom: 1rem; }
  .field label {
    display: block; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    color: #6b7280; margin-bottom: 0.35rem;
  }

  .alert--success {
    background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }
  .alert--error {
    background: #fee2e2; color: #dc2626; border: 1px solid #fecaca;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }

  .item-card__meta { font-size: 0.82rem; color: #6b7280; line-height: 1.6; }

  .donate-amount-field { display: flex; align-items: center; gap: 0.4rem; }
  .donate-amount-field span { font-size: 1.1rem; color: #6b7280; }
  .donate-amount-field input {
    width: 8rem; padding: 0.6rem 0.75rem; font-size: 1.1rem;
    border: 1px solid #e5e7eb; border-radius: 6px; font-family: inherit; color: #1a1a1a;
  }
  .donate-choice-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .donate-step + .donate-step { margin-top: 1.25rem; }
</style>
{% endblock %}

{% block content %}
<div class="donate-page">
  <div class="donate-wrap">
    <a href="{{ path('app_account') }}" class="donate-back-link">← Back to my account</a>
    <h1>Make a donation</h1>

    <div class="account-card">
      <div id="donate-step-amount" class="donate-step">
        <div class="field">
          <label for="donateAmount">Amount</label>
          <div class="donate-amount-field">
            <span>£</span>
            <input type="number" id="donateAmount" min="1" max="5000" step="0.01">
          </div>
        </div>
        <div id="donate-amount-error" class="alert--error" style="display:none;"></div>
        <button type="button" class="btn btn--teal" id="donate-continue-btn">Continue</button>
      </div>

      <div id="donate-step-choose" class="donate-step" hidden>
        <p class="item-card__meta">Donating £<span class="donate-amount-display"></span></p>
        <div class="donate-choice-row">
          <button type="button" class="btn btn--teal" id="donate-pay-card-btn">Pay by card</button>
          <button type="button" class="btn btn--outline" id="donate-pay-terminal-btn">Send to card reader</button>
        </div>
      </div>

      <div id="donate-step-card" class="donate-step" hidden>
        <p class="item-card__meta">Donating £<span class="donate-amount-display"></span></p>
        <div id="payment-element" style="margin: 1rem 0;"></div>
        <button type="button" class="btn btn--teal" id="donate-submit-card-btn">Donate now</button>
        <div id="donate-card-error" class="alert--error" style="display:none;margin-top:0.75rem;"></div>
      </div>

      <div id="donate-step-processing" class="donate-step" hidden>
        <p class="item-card__meta">Donating £<span class="donate-amount-display"></span></p>
        <p class="item-card__meta">Processing your payment&hellip;</p>
      </div>

      <div id="donate-step-terminal" class="donate-step" hidden>
        <p class="item-card__meta">Donating £<span class="donate-amount-display"></span></p>
        <p class="item-card__meta">Waiting for the card to be tapped on the reader&hellip;</p>
        <div id="donate-terminal-error" class="alert--error" style="display:none;margin-top:0.75rem;"></div>
      </div>

      <div id="donate-step-success" class="donate-step" hidden>
        <div class="alert--success">Thank you for your donation!</div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://js.stripe.com/v3/"></script>
<script>
(function () {
  const csrfToken = {{ csrf_token('donate')|json_encode|raw }};
  const stripe = Stripe({{ stripePublishableKey|json_encode|raw }});
  const statusUrlTemplate = {{ path('app_donate_status', {id: 999999999})|json_encode|raw }};

  const amountInput    = document.getElementById('donateAmount');
  const amountError    = document.getElementById('donate-amount-error');
  const amountDisplays = document.querySelectorAll('.donate-amount-display');

  const steps = {
    amount:     document.getElementById('donate-step-amount'),
    choose:     document.getElementById('donate-step-choose'),
    card:       document.getElementById('donate-step-card'),
    processing: document.getElementById('donate-step-processing'),
    terminal:   document.getElementById('donate-step-terminal'),
    success:    document.getElementById('donate-step-success'),
  };

  const submitCardBtn = document.getElementById('donate-submit-card-btn');

  function showStep(name) {
    Object.values(steps).forEach(el => { el.hidden = true; });
    steps[name].hidden = false;

    if (name === 'card') {
      submitCardBtn.disabled = false;
      submitCardBtn.textContent = 'Donate now';
    }
  }

  let currentAmount = null;
  let elements = null;
  let pollTimer = null;

  document.getElementById('donate-continue-btn').addEventListener('click', () => {
    const value = parseFloat(amountInput.value);
    amountError.style.display = 'none';

    if (!value || value < 1 || value > 5000) {
      amountError.textContent = 'Please enter an amount between £1 and £5000.';
      amountError.style.display = 'block';
      return;
    }

    currentAmount = value.toFixed(2);
    amountDisplays.forEach(el => { el.textContent = currentAmount; });
    showStep('choose');
  });

  document.getElementById('donate-pay-card-btn').addEventListener('click', async () => {
    showStep('card');

    const body = new URLSearchParams({ amount: currentAmount, _csrf_token: csrfToken });
    const response = await fetch('{{ path('app_donate_intent') }}', { method: 'POST', body });
    const data = await response.json();

    if (!response.ok) {
      showStep('choose');
      alert(data.error || 'Something went wrong starting the payment.');
      return;
    }

    elements = stripe.elements({ clientSecret: data.clientSecret });
    elements.create('payment').mount('#payment-element');

    submitCardBtn.onclick = async () => {
      const cardError = document.getElementById('donate-card-error');
      cardError.style.display = 'none';
      submitCardBtn.disabled = true;
      submitCardBtn.textContent = 'Processing…';

      const result = await stripe.confirmPayment({
        elements,
        confirmParams: { return_url: window.location.origin + '{{ path('app_donate') }}' },
        redirect: 'if_required',
      });

      if (result.error) {
        submitCardBtn.disabled = false;
        submitCardBtn.textContent = 'Donate now';
        cardError.textContent = result.error.message;
        cardError.style.display = 'block';
        return;
      }

      showStep('processing');
      pollPaymentStatus(data.paymentId, { maxAttempts: 20, errorStep: 'card', errorBoxId: 'donate-card-error' });
    };
  });

  document.getElementById('donate-pay-terminal-btn').addEventListener('click', async () => {
    showStep('terminal');

    const body = new URLSearchParams({ amount: currentAmount, _csrf_token: csrfToken });
    const response = await fetch('{{ path('app_donate_terminal') }}', { method: 'POST', body });
    const data = await response.json();

    if (!response.ok) {
      showStep('choose');
      alert(data.error || 'Something went wrong sending this to the card reader.');
      return;
    }

    pollPaymentStatus(data.paymentId, { maxAttempts: 60, errorStep: 'terminal', errorBoxId: 'donate-terminal-error' });
  });

  function pollPaymentStatus(paymentId, { maxAttempts, errorStep, errorBoxId }) {
    let attempts = 0;
    clearInterval(pollTimer);
    const errorBox = document.getElementById(errorBoxId);
    const statusUrl = statusUrlTemplate.replace('999999999', paymentId);

    pollTimer = setInterval(async () => {
      attempts++;

      let data;
      try {
        const response = await fetch(statusUrl);
        data = await response.json();
      } catch (e) {
        return; // transient network error — keep polling
      }

      if (data.status === 'succeeded') {
        clearInterval(pollTimer);
        showStep('success');
        return;
      }

      if (data.status === 'failed') {
        clearInterval(pollTimer);
        errorBox.textContent = 'The payment did not go through. Please try again.';
        errorBox.style.display = 'block';
        showStep(errorStep);
        return;
      }

      if (attempts >= maxAttempts) {
        clearInterval(pollTimer);
        errorBox.textContent = 'This is taking longer than expected — please check back shortly.';
        errorBox.style.display = 'block';
        showStep(errorStep);
      }
    }, 1500);
  }
})();
</script>
{% endblock %}
