{% extends 'base.html.twig' %}

{% block title %}Complete {{ record.certification.name }} — Y Wal{% endblock %}

{% block nav %}{% include '_minimal_nav.html.twig' %}{% endblock %}
{% block footer %}{% endblock %}

{% block head %}
<style>
  .account-page { padding: 2.5rem 1rem 5rem; }
  .account-wrap { max-width: 560px; margin: 0 auto; }
  .account-wrap h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
  .account-wrap .subtitle { color: var(--muted, #6b7280); font-size: 0.9rem; margin-bottom: 2rem; }

  .account-card {
    background: #fff; border: 1px solid #e5e7eb;
    border-radius: 10px; padding: 1.5rem; margin-bottom: 1.25rem;
  }
  .account-card__title {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #6b7280; margin-bottom: 1rem;
  }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }

  .field { margin-bottom: 1rem; }
  .account-card > .field:last-child { margin-bottom: 0; }
  .field label {
    display: block; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    color: #6b7280; margin-bottom: 0.35rem;
  }
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="tel"],
  .field input[type="date"] {
    width: 100%; padding: 0.6rem 0.75rem;
    border: 1px solid #e5e7eb; border-radius: 6px;
    font-size: 0.9375rem; font-family: inherit; color: #1a1a1a;
  }
  .field input:focus { outline: 2px solid #2a9d8f; outline-offset: 1px; border-color: transparent; }

  .optin-label {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; color: #1a1a1a; cursor: pointer;
  }
  .optin-label input { width: 1rem; height: 1rem; accent-color: #2a9d8f; }

  .alert--success {
    background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }
  .alert--error {
    background: #fee2e2; color: #dc2626; border: 1px solid #fecaca;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }

  .declaration {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: 0.9rem; line-height: 1.5; margin-bottom: 0.9rem; cursor: pointer;
  }
  .declaration input {
    width: 1.15rem; height: 1.15rem; flex-shrink: 0; margin-top: 0.15rem;
    accent-color: #2a9d8f;
  }

  .signature-field label {
    display: block; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    color: #6b7280; margin-bottom: 0.5rem;
  }
  .signature-pad-wrap {
    border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; touch-action: none;
  }
  #signature-pad { width: 100%; height: 200px; display: block; cursor: crosshair; }
  .signature-hint { font-size: 0.78rem; color: #6b7280; margin-top: 0.4rem; }

  .account-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .account-actions .btn { padding: 0.6rem 1.4rem; }

  /* ── Wizard steps ─────────────────────────────────── */
  .wizard-step { display: flex; align-items: flex-start; gap: 0.9rem; margin-bottom: 1rem; }
  .wizard-step__badge {
    flex-shrink: 0; width: 1.75rem; height: 1.75rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 700;
    background: #f3f4f6; color: #6b7280;
  }
  .wizard-step--done .wizard-step__badge { background: #dcfce7; color: #15803d; }
  .wizard-step--current .wizard-step__badge { background: #2a9d8f; color: #fff; }
  .wizard-step--pending { opacity: 0.5; }
  .wizard-step__title { font-weight: 700; font-size: 1.05rem; color: #1a1a1a; margin-top: 0.15rem; }
  .wizard-step__body { flex: 1; min-width: 0; }

  .profile-summary { font-size: 0.9rem; line-height: 1.7; color: #1a1a1a; }
  .profile-summary__label { color: #6b7280; }
  .profile-summary-edit-btn {
    background: none; border: none; padding: 0; margin-top: 0.75rem;
    font-family: inherit; font-size: 0.85rem; font-weight: 600; color: #2a9d8f;
    text-decoration: underline; text-underline-offset: 2px; cursor: pointer;
  }
</style>
{% endblock %}

{% block content %}
<div class="account-page">
  <div class="account-wrap">
    <h1>{{ record.certification.name }}</h1>
    <p class="subtitle">
      {% if record.user != app.user %}
        For {{ (record.user.firstName ~ ' ' ~ record.user.lastName)|trim ?: 'your dependent' }}.
      {% endif %}
      {% if record.certification.description %}{{ record.certification.description }}{% else %}Confirm your details and complete the declarations below.{% endif %}
    </p>

    {% for msg in app.flashes('success') %}
      <div class="alert--success">{{ msg }}</div>
    {% endfor %}
    {% if error %}
      <div class="alert--error">{{ error }}</div>
    {% endif %}

    {% set step1Done = missingProfileFields is empty %}
    {% set canEditProfile = record.user == app.user %}

    {# ── Step 1: personal information ──────────────────────────────── #}
    <div class="wizard-step {{ step1Done ? 'wizard-step--done' : 'wizard-step--current' }}">
      <div class="wizard-step__badge">{{ step1Done ? '✓' : '1' }}</div>
      <div class="wizard-step__body">
        <div class="wizard-step__title">Confirm your personal information</div>

        {% if not step1Done %}
          {% if canEditProfile %}
            <p style="font-size:0.9rem;color:#6b7280;margin:0.35rem 0 1rem;">
              We need a few more details on file before this certification can be completed.
            </p>
            <form method="post" action="{{ path('app_account') }}" novalidate>
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_edit') }}">
              <input type="hidden" name="returnTo" value="{{ path('app_account_certification_complete', {recordId: record.id}) }}">
              {% include 'account/_profile_fields.html.twig' with {user: record.user} %}
              <div class="account-actions">
                <button type="submit" class="btn btn--teal">Save and continue</button>
              </div>
            </form>
          {% else %}
            <div class="account-card">
              <p style="margin:0;">
                Ask an admin to add the following to {{ (record.user.firstName ~ ' ' ~ record.user.lastName)|trim ?: "this member" }}'s profile before you can complete the declarations below:
                {{ missingProfileFields|join(', ') }}.
              </p>
            </div>
          {% endif %}
        {% else %}
          {% set holder = record.user %}
          <div class="account-card">
            <div class="profile-summary" id="profile-summary">
              <div><span class="profile-summary__label">Name:</span> {{ (holder.firstName ~ ' ' ~ holder.lastName)|trim ?: '—' }}</div>
              <div><span class="profile-summary__label">Date of birth:</span> {{ holder.dateOfBirth ? holder.dateOfBirth|date('d M Y') : '—' }}</div>
              <div><span class="profile-summary__label">Phone:</span> {{ holder.phone ?: '—' }}</div>
              <div><span class="profile-summary__label">Emergency contact:</span> {{ holder.emergencyContactName ?: '—' }}{% if holder.emergencyContactPhone %} &middot; {{ holder.emergencyContactPhone }}{% endif %}</div>
              <div><span class="profile-summary__label">Address:</span> {{ [holder.addressLine1, holder.addressLine2, holder.town, holder.postcode]|filter(v => v)|join(', ') ?: '—' }}</div>
            </div>
            {% if canEditProfile %}
              <button type="button" class="profile-summary-edit-btn" id="profile-edit-toggle">Edit details</button>
              <div id="profile-edit-form" hidden style="margin-top:1rem;">
                <form method="post" action="{{ path('app_account') }}" novalidate>
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_edit') }}">
                  <input type="hidden" name="returnTo" value="{{ path('app_account_certification_complete', {recordId: record.id}) }}">
                  {% include 'account/_profile_fields.html.twig' with {user: holder} %}
                  <div class="account-actions">
                    <button type="submit" class="btn btn--teal">Save changes</button>
                    <button type="button" class="btn btn--outline" id="profile-edit-cancel">Cancel</button>
                  </div>
                </form>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    {# ── Step 2: declarations ──────────────────────────────────────── #}
    <div class="wizard-step {{ step1Done ? 'wizard-step--current' : 'wizard-step--pending' }}">
      <div class="wizard-step__badge">2</div>
      <div class="wizard-step__body">
        <div class="wizard-step__title">Complete the declaration</div>

        {% if step1Done %}
          <form method="post" action="{{ path('app_account_certification_complete', {recordId: record.id}) }}" id="complete-form" novalidate style="margin-top:0.75rem;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('complete_certification_' ~ record.id) }}">
            <input type="hidden" name="signature" id="signature-input">

            {% if declarations|length > 0 %}
              <div class="account-card">
                <div class="account-card__title">Declarations</div>
                {% for declaration in declarations %}
                  <label class="declaration">
                    <input type="checkbox" name="declarations[]" value="{{ declaration.id }}" required>
                    <span>{{ declaration.text }}</span>
                  </label>
                {% endfor %}
              </div>
            {% endif %}

            <div class="account-card">
              <div class="account-card__title">Signature</div>
              <label class="declaration">
                <input type="checkbox" name="signature_consent" value="1" required>
                <span>{{ constant('App\\Entity\\UserCertification::SIGNATURE_DECLARATION_TEXT') }}</span>
              </label>
              <div class="signature-field">
                <label for="signature-pad">Sign in the box below</label>
                <div class="signature-pad-wrap">
                  <canvas id="signature-pad" width="600" height="200"></canvas>
                </div>
                <p class="signature-hint">
                  <button type="button" id="signature-clear" class="item-card__cancel-btn" style="background:none;border:none;padding:0;font:inherit;color:#6b7280;text-decoration:underline;cursor:pointer;">Clear</button>
                </p>
              </div>
            </div>

            <div class="account-actions">
              <button type="submit" class="btn btn--teal">Complete {{ record.certification.name }}</button>
              <a href="{{ path('app_account', {_fragment: 'certifications'}) }}" class="btn btn--outline">Cancel</a>
            </div>
          </form>
        {% else %}
          <p style="font-size:0.9rem;color:#6b7280;margin:0.35rem 0 0;">Available once step 1 is complete.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  (function () {
    var editToggle = document.getElementById('profile-edit-toggle');
    var editForm   = document.getElementById('profile-edit-form');
    var editCancel = document.getElementById('profile-edit-cancel');
    var summary    = document.getElementById('profile-summary');

    if (editToggle) {
      editToggle.addEventListener('click', function () {
        editForm.hidden = false;
        editToggle.hidden = true;
        summary.hidden = true;
      });
    }
    if (editCancel) {
      editCancel.addEventListener('click', function () {
        editForm.hidden = true;
        editToggle.hidden = false;
        summary.hidden = false;
      });
    }
  })();

  (function () {
    var canvas = document.getElementById('signature-pad');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var clearBtn = document.getElementById('signature-clear');
    var signatureInput = document.getElementById('signature-input');
    var form = document.getElementById('complete-form');
    var drawing = false;
    var hasSignature = false;

    function resize() {
      var ratio = window.devicePixelRatio || 1;
      var rect = canvas.getBoundingClientRect();
      var data = hasSignature ? canvas.toDataURL() : null;
      canvas.width = rect.width * ratio;
      canvas.height = rect.height * ratio;
      ctx.scale(ratio, ratio);
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      ctx.strokeStyle = '#1a1a1a';
      if (data) {
        var img = new Image();
        img.onload = function () { ctx.drawImage(img, 0, 0, rect.width, rect.height); };
        img.src = data;
      }
    }

    function pos(e) {
      var rect = canvas.getBoundingClientRect();
      var point = e.touches ? e.touches[0] : e;
      return { x: point.clientX - rect.left, y: point.clientY - rect.top };
    }

    function start(e) {
      e.preventDefault();
      drawing = true;
      hasSignature = true;
      var p = pos(e);
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
    }

    function move(e) {
      if (!drawing) return;
      e.preventDefault();
      var p = pos(e);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
    }

    function end() {
      drawing = false;
    }

    canvas.addEventListener('mousedown', start);
    canvas.addEventListener('mousemove', move);
    window.addEventListener('mouseup', end);
    canvas.addEventListener('touchstart', start, { passive: false });
    canvas.addEventListener('touchmove', move, { passive: false });
    canvas.addEventListener('touchend', end);

    clearBtn.addEventListener('click', function () {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasSignature = false;
    });

    window.addEventListener('resize', resize);
    resize();

    form.addEventListener('submit', function (e) {
      if (!hasSignature) {
        e.preventDefault();
        alert('Please sign before completing this.');
        return;
      }
      signatureInput.value = canvas.toDataURL('image/png');
    });
  })();
</script>
{% endblock %}
