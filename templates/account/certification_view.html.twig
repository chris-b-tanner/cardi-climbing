{% extends 'base.html.twig' %}

{% block title %}{{ record.certification.name }} — Y Wal{% endblock %}

{% block head %}
<style>
  .account-page { padding: 7rem 1rem 5rem; }
  .account-wrap { max-width: 560px; margin: 0 auto; }
  .account-wrap h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.4rem; }

  .account-card {
    background: #fff; border: 1px solid #e5e7eb;
    border-radius: 10px; padding: 1.5rem; margin-bottom: 1.25rem;
  }
  .account-card__title {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #6b7280; margin-bottom: 1rem;
  }

  .status-pill {
    display: inline-block; font-size: 0.66rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.18rem 0.5rem; border-radius: 4px;
    background: #f3f4f6; color: #6b7280; flex-shrink: 0; white-space: nowrap;
  }
  .status-pill--confirmed { background: #dcfce7; color: #15803d; }
  .status-pill--pending   { background: #fef9c3; color: #854d0e; }

  .meta-row {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.6rem 0; border-bottom: 1px solid #f3f4f6; font-size: 0.875rem;
  }
  .meta-row:last-child { border-bottom: none; }
  .meta-row .meta-label { color: #6b7280; }
  .meta-row .meta-value { color: #1a1a1a; font-weight: 600; text-align: right; }

  .declaration-list { margin: 0; padding-left: 1.2rem; font-size: 0.875rem; color: #374151; line-height: 1.7; }
  .declaration-list li { margin-bottom: 0.5rem; }

  .signature-box {
    border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.75rem;
    background: #fff; display: inline-block;
  }
  .signature-box img { display: block; max-width: 280px; max-height: 120px; }

  .account-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }
</style>
{% endblock %}

{% block content %}
<div class="account-page">
  <div class="account-wrap">
    <a href="{{ path('app_account', {_fragment: 'certifications'}) }}" style="font-size:0.85rem;color:#6b7280;display:inline-block;margin-bottom:1rem;">&larr; Back to certifications</a>

    <h1>{{ record.certification.name }}</h1>
    <p style="margin-bottom:1.5rem;">
      <span class="status-pill {{ record.isComplete ? 'status-pill--confirmed' : 'status-pill--pending' }}">
        {{ record.isComplete ? 'Completed' : 'In progress' }}
      </span>
    </p>

    {% if record.certification.description %}
      <div class="account-card">
        <div class="account-card__title">About this certification</div>
        <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">{{ record.certification.description }}</p>
      </div>
    {% endif %}

    <div class="account-card">
      <div class="account-card__title">Timeline</div>
      <div class="meta-row">
        <span class="meta-label">Started</span>
        <span class="meta-value">{{ record.startedAt|date('d M Y') }}</span>
      </div>
      {% if record.isComplete %}
        <div class="meta-row">
          <span class="meta-label">Completed</span>
          <span class="meta-value">{{ record.completedAt|date('d M Y') }}</span>
        </div>
      {% endif %}
    </div>

    {% if record.isComplete %}
      {% if record.agreedDeclarations|length > 0 %}
        <div class="account-card">
          <div class="account-card__title">Declarations agreed</div>
          <ul class="declaration-list">
            {% for declaration in record.agreedDeclarations %}
              <li>{{ declaration.text }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if record.signature %}
        <div class="account-card">
          <div class="account-card__title">Signature</div>
          <div class="signature-box">
            <img src="{{ record.signature }}" alt="Your signature">
          </div>
        </div>
      {% endif %}
    {% else %}
      <div class="account-card">
        <div class="account-card__title">Next step</div>
        <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0 0 1rem;">
          This certification is still in progress. Read through the declarations and sign to complete it.
        </p>
        <div class="account-actions">
          <a href="{{ path('app_account_certification_complete', {recordId: record.id}) }}" class="btn btn--teal">Complete now</a>
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
