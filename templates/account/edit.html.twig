{% extends 'base.html.twig' %}

{% block title %}My Account — Y Wal{% endblock %}

{% block head %}
<style>
  .account-page { padding: 7rem 1rem 5rem; }
  .account-wrap { max-width: 560px; margin: 0 auto; }
  .account-wrap h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
  .account-wrap .subtitle { color: var(--muted, #6b7280); font-size: 0.9rem; margin-bottom: 2rem; }

  .account-card {
    background: #fff; border: 1px solid #e5e7eb;
    border-radius: 10px; padding: 1.5rem; margin-bottom: 1.25rem;
  }
  .account-card__title {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #6b7280; margin-bottom: 1rem;
  }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }

  .field { margin-bottom: 1rem; }
  .account-card > .field:last-child { margin-bottom: 0; }
  .field label {
    display: block; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    color: #6b7280; margin-bottom: 0.35rem;
  }
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="tel"] {
    width: 100%; padding: 0.6rem 0.75rem;
    border: 1px solid #e5e7eb; border-radius: 6px;
    font-size: 0.9375rem; font-family: inherit; color: #1a1a1a;
  }
  .field input:focus { outline: 2px solid #2a9d8f; outline-offset: 1px; border-color: transparent; }

  .optin-label {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; color: #1a1a1a; cursor: pointer;
  }
  .optin-label input { width: 1rem; height: 1rem; accent-color: #2a9d8f; }

  .account-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .account-actions .btn { padding: 0.6rem 1.4rem; }

  .alert--success {
    background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }
  .alert--error {
    background: #fee2e2; color: #dc2626; border: 1px solid #fecaca;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }

  .reset-link { font-size: 0.875rem; color: #6b7280; }
  .reset-link a { color: #2a9d8f; }

  /* ── Tabs ─────────────────────────────────────────── */
  .account-tabs {
    display: flex; gap: 0.25rem; margin-bottom: 1.5rem;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    border-bottom: 1px solid #e5e7eb;
  }
  .account-tab {
    flex-shrink: 0; appearance: none;
    padding: 0.7rem 0.9rem;
    font-family: inherit; font-size: 0.85rem; font-weight: 600; color: #6b7280;
    background: none; border: none; border-bottom: 2px solid transparent;
    cursor: pointer; white-space: nowrap;
  }
  .account-tab:hover { color: #1a1a1a; }
  .account-tab.is-active { color: #1a1a1a; border-bottom-color: #2a9d8f; }
  .account-panel[hidden] { display: none; }
  .account-empty {
    background: #fff; border: 1px dashed #e5e7eb; border-radius: 10px;
    padding: 1.75rem 1.25rem; text-align: center; color: #6b7280; font-size: 0.875rem;
  }

  /* ── Status pill ──────────────────────────────────── */
  .status-pill {
    display: inline-block; font-size: 0.66rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.18rem 0.5rem; border-radius: 4px;
    background: #f3f4f6; color: #6b7280; flex-shrink: 0;
    white-space: nowrap;
  }
  .status-pill--confirmed { background: #dcfce7; color: #15803d; }
  .status-pill--cancelled { background: #fee2e2; color: #dc2626; }
  .status-pill--pending   { background: #fef9c3; color: #854d0e; }

  /* ── Booking / certification cards ───────────────────── */
  .item-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 10px;
    padding: 1.1rem 1.25rem; margin-bottom: 0.85rem;
  }
  .item-card__top {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 0.75rem; margin-bottom: 0.4rem;
  }
  .item-card__title { font-weight: 600; font-size: 0.95rem; color: #1a1a1a; }
  .item-card__meta { font-size: 0.82rem; color: #6b7280; line-height: 1.6; }
  .item-card__actions { margin-top: 0.75rem; }
  .item-card__cancel-btn {
    background: none; border: none; padding: 0;
    font-family: inherit; font-size: 0.8rem; font-weight: 600; color: #6b7280;
    text-decoration: underline; text-underline-offset: 2px; cursor: pointer;
  }
  .item-card__cancel-btn:hover { color: #dc2626; }
  .item-card__view-link {
    font-size: 0.8rem; font-weight: 600; color: #2a9d8f; text-decoration: none;
  }
  .item-card__view-link:hover { text-decoration: underline; }

  /* ── Donate ───────────────────────────────────────── */
  .donate-amount-field { display: flex; align-items: center; gap: 0.4rem; }
  .donate-amount-field span { font-size: 1.1rem; color: #6b7280; }
  .donate-amount-field input {
    width: 8rem; padding: 0.6rem 0.75rem; font-size: 1.1rem;
    border: 1px solid #e5e7eb; border-radius: 6px; font-family: inherit; color: #1a1a1a;
  }
  .donate-choice-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .donate-step + .donate-step { margin-top: 1.25rem; }
</style>
{% endblock %}

{% block content %}
<div class="account-page">
  <div class="account-wrap">
    <h1>My Account</h1>

    {% for msg in app.flashes('success') %}
      <div class="alert--success">{{ msg }}</div>
    {% endfor %}

    {% if error %}
      <div class="alert--error">{{ error }}</div>
    {% endif %}

    <div class="account-tabs" role="tablist">
      <button type="button" class="account-tab is-active" data-tab="info" role="tab" aria-selected="true">Personal info</button>
      <button type="button" class="account-tab" data-tab="bookings" role="tab" aria-selected="false">Bookings</button>
      <button type="button" class="account-tab" data-tab="certifications" role="tab" aria-selected="false">Certifications</button>
      <button type="button" class="account-tab" data-tab="donate" role="tab" aria-selected="false">Donate</button>
    </div>

    <section class="account-panel" data-panel="info">
      <form method="post" action="{{ path('app_account') }}" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_edit') }}">

        <div class="account-card">
          <div class="account-card__title">Personal details</div>
          <div class="field-row">
            <div class="field">
              <label for="firstName">First name</label>
              <input type="text" id="firstName" name="firstName"
                     value="{{ user.firstName }}" autocomplete="given-name">
            </div>
            <div class="field">
              <label for="lastName">Last name</label>
              <input type="text" id="lastName" name="lastName"
                     value="{{ user.lastName }}" autocomplete="family-name">
            </div>
          </div>
          <div class="field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email"
                   value="{{ user.email }}" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone"
                   value="{{ user.phone }}" autocomplete="tel">
          </div>
          <div class="field" style="margin-bottom:0;">
            <label class="optin-label">
              <input type="checkbox" name="optIn" value="1"{% if user.optIn %} checked{% endif %}>
              Keep me updated about Y Wal news
            </label>
          </div>
        </div>

        <div class="account-card">
          <div class="account-card__title">Address</div>
          <div class="field">
            <label for="addressLine1">Address line 1</label>
            <input type="text" id="addressLine1" name="addressLine1"
                   value="{{ user.addressLine1 }}" autocomplete="address-line1">
          </div>
          <div class="field">
            <label for="addressLine2">Address line 2</label>
            <input type="text" id="addressLine2" name="addressLine2"
                   value="{{ user.addressLine2 }}" autocomplete="address-line2">
          </div>
          <div class="field-row">
            <div class="field">
              <label for="town">Town / City</label>
              <input type="text" id="town" name="town"
                     value="{{ user.town }}" autocomplete="address-level2">
            </div>
            <div class="field" style="margin-bottom:0;">
              <label for="postcode">Postcode</label>
              <input type="text" id="postcode" name="postcode"
                     value="{{ user.postcode }}" autocomplete="postal-code">
            </div>
          </div>
        </div>

        <div class="account-actions">
          <button type="submit" class="btn btn--teal">Save changes</button>
          <span class="reset-link">
            Need to change your password?
            <a href="{{ path('app_forgot_password_request') }}">Reset it here</a>
          </span>
        </div>
      </form>
    </section>

    <section class="account-panel" data-panel="bookings" hidden>
      {% if attendees is empty %}
        <div class="account-empty">You haven't booked onto any events yet.</div>
      {% else %}
        {% for attendee in attendees %}
          {% set event = attendee.event %}
          {% set effectiveDate = attendee.occurrenceDate ?? event.date %}
          <div class="item-card">
            <div class="item-card__top">
              <div class="item-card__title">{{ event.title }}</div>
              <span class="status-pill status-pill--{{ attendee.status }}">{{ attendee.status|capitalize }}</span>
            </div>
            <div class="item-card__meta">
              {{ effectiveDate|date('D j M Y') }} &middot; {{ event.timeFrom }}&ndash;{{ event.timeTo }}<br>
              {{ event.location }}
            </div>
            {% if attendee.status != 'cancelled' and effectiveDate >= today %}
              <form method="post" action="{{ path('app_event_cancel', {id: event.id}) }}" class="item-card__actions">
                <input type="hidden" name="occurrenceDate" value="{{ effectiveDate|date('Y-m-d') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('cancel_event_' ~ event.id) }}">
                <button type="submit" class="item-card__cancel-btn">Cancel booking</button>
              </form>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </section>

    <section class="account-panel" data-panel="certifications" hidden>
      {% if user.certifications is empty %}
        <div class="account-empty">
          <p>You don't have any certifications on record yet.</p>
          <p>Certifications allow you to book onto certain events, such as self-access bouldering out of hours.</p>
        </div>
      {% else %}
        {% for record in user.certifications %}
          {% set pillClass = record.status == 'completed' ? 'status-pill--confirmed' : (record.status == 'cancelled' ? 'status-pill--cancelled' : 'status-pill--pending') %}
          <div class="item-card">
            <div class="item-card__top">
              <div class="item-card__title">{{ record.certification.name }}</div>
              <span class="status-pill {{ pillClass }}">{{ record.statusLabel }}</span>
            </div>
            <div class="item-card__meta">
              Started {{ record.startedAt|date('d M Y') }}
              {% if record.submitted %}&middot; Submitted {{ record.completedAt|date('d M Y') }}{% endif %}
            </div>
            <div class="item-card__actions">
              {% if record.status == 'in_progress' %}
                <a href="{{ path('app_account_certification_complete', {recordId: record.id}) }}" class="btn btn--teal btn--sm">Complete now</a>
              {% else %}
                <a href="{{ path('app_account_certification_view', {recordId: record.id}) }}" class="item-card__view-link">View details</a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </section>

    <section class="account-panel" data-panel="donate" hidden>
      <div class="account-card">
        <div class="account-card__title">Make a donation</div>

        <div id="donate-step-amount" class="donate-step">
          <div class="field">
            <label for="donateAmount">Amount</label>
            <div class="donate-amount-field">
              <span>£</span>
              <input type="number" id="donateAmount" min="1" max="5000" step="0.01" placeholder="10.00">
            </div>
          </div>
          <div id="donate-amount-error" class="alert--error" style="display:none;"></div>
          <button type="button" class="btn btn--teal" id="donate-continue-btn">Continue</button>
        </div>

        <div id="donate-step-choose" class="donate-step" hidden>
          <p class="item-card__meta">Donating £<span class="donate-amount-display"></span></p>
          <div class="donate-choice-row">
            <button type="button" class="btn btn--teal" id="donate-pay-card-btn">Pay by card</button>
            <button type="button" class="btn btn--ghost" id="donate-pay-terminal-btn">Send to card reader</button>
          </div>
        </div>

        <div id="donate-step-card" class="donate-step" hidden>
          <p class="item-card__meta">Donating £<span class="donate-amount-display"></span></p>
          <div id="payment-element" style="margin: 1rem 0;"></div>
          <button type="button" class="btn btn--teal" id="donate-submit-card-btn">Donate now</button>
          <div id="donate-card-error" class="alert--error" style="display:none;margin-top:0.75rem;"></div>
        </div>

        <div id="donate-step-terminal" class="donate-step" hidden>
          <p class="item-card__meta">Donating £<span class="donate-amount-display"></span></p>
          <p class="item-card__meta">Waiting for the card to be tapped on the reader&hellip;</p>
          <div id="donate-terminal-error" class="alert--error" style="display:none;margin-top:0.75rem;"></div>
        </div>

        <div id="donate-step-success" class="donate-step" hidden>
          <div class="alert--success">Thank you for your donation!</div>
        </div>
      </div>
    </section>
  </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
  const accountTabs   = document.querySelectorAll('.account-tab');
  const accountPanels = document.querySelectorAll('.account-panel');

  function activateTab(name) {
    const tab = [...accountTabs].find(t => t.dataset.tab === name);
    if (!tab) return;

    accountTabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
    tab.classList.add('is-active');
    tab.setAttribute('aria-selected', 'true');

    accountPanels.forEach(panel => {
      panel.hidden = panel.dataset.panel !== name;
    });
  }

  accountTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      activateTab(tab.dataset.tab);
      history.replaceState(null, '', `#${tab.dataset.tab}`);
    });
  });

  const initialTab = window.location.hash.replace('#', '');
  if (initialTab) activateTab(initialTab);
</script>
<script src="https://js.stripe.com/v3/"></script>
<script>
(function () {
  const csrfToken = {{ csrf_token('donate')|json_encode|raw }};
  const stripe = Stripe({{ stripePublishableKey|json_encode|raw }});

  const amountInput   = document.getElementById('donateAmount');
  const amountError   = document.getElementById('donate-amount-error');
  const amountDisplays = document.querySelectorAll('.donate-amount-display');

  const steps = {
    amount:   document.getElementById('donate-step-amount'),
    choose:   document.getElementById('donate-step-choose'),
    card:     document.getElementById('donate-step-card'),
    terminal: document.getElementById('donate-step-terminal'),
    success:  document.getElementById('donate-step-success'),
  };

  function showStep(name) {
    Object.values(steps).forEach(el => { el.hidden = true; });
    steps[name].hidden = false;
  }

  let currentAmount = null;
  let elements = null;
  let pollTimer = null;

  document.getElementById('donate-continue-btn').addEventListener('click', () => {
    const value = parseFloat(amountInput.value);
    amountError.style.display = 'none';

    if (!value || value < 1 || value > 5000) {
      amountError.textContent = 'Please enter an amount between £1 and £5000.';
      amountError.style.display = 'block';
      return;
    }

    currentAmount = value.toFixed(2);
    amountDisplays.forEach(el => { el.textContent = currentAmount; });
    showStep('choose');
  });

  document.getElementById('donate-pay-card-btn').addEventListener('click', async () => {
    showStep('card');

    const body = new URLSearchParams({ amount: currentAmount, _csrf_token: csrfToken });
    const response = await fetch('{{ path('app_donate_intent') }}', { method: 'POST', body });
    const data = await response.json();

    if (!response.ok) {
      showStep('choose');
      alert(data.error || 'Something went wrong starting the payment.');
      return;
    }

    elements = stripe.elements({ clientSecret: data.clientSecret });
    elements.create('payment').mount('#payment-element');

    document.getElementById('donate-submit-card-btn').onclick = async () => {
      const cardError = document.getElementById('donate-card-error');
      cardError.style.display = 'none';

      const result = await stripe.confirmPayment({
        elements,
        confirmParams: { return_url: window.location.origin + '{{ path('app_account') }}#donate' },
        redirect: 'if_required',
      });

      if (result.error) {
        cardError.textContent = result.error.message;
        cardError.style.display = 'block';
        return;
      }

      pollPaymentStatus(data.paymentId);
    };
  });

  document.getElementById('donate-pay-terminal-btn').addEventListener('click', async () => {
    showStep('terminal');

    const body = new URLSearchParams({ amount: currentAmount, _csrf_token: csrfToken });
    const response = await fetch('{{ path('app_donate_terminal') }}', { method: 'POST', body });
    const data = await response.json();

    if (!response.ok) {
      showStep('choose');
      alert(data.error || 'Something went wrong sending this to the card reader.');
      return;
    }

    pollPaymentStatus(data.paymentId, 60);
  });

  function pollPaymentStatus(paymentId, maxAttempts = 20) {
    let attempts = 0;
    clearInterval(pollTimer);

    pollTimer = setInterval(async () => {
      attempts++;
      const response = await fetch(`/account/donate/${paymentId}/status`);
      const data = await response.json();

      if (data.status === 'succeeded') {
        clearInterval(pollTimer);
        showStep('success');
      } else if (data.status === 'failed') {
        clearInterval(pollTimer);
        const errorBox = steps.terminal.hidden ? document.getElementById('donate-card-error') : document.getElementById('donate-terminal-error');
        errorBox.textContent = 'The payment did not go through. Please try again.';
        errorBox.style.display = 'block';
        showStep(steps.terminal.hidden ? 'card' : 'terminal');
      } else if (attempts >= maxAttempts) {
        clearInterval(pollTimer);
        const errorBox = steps.terminal.hidden ? document.getElementById('donate-card-error') : document.getElementById('donate-terminal-error');
        errorBox.textContent = 'This is taking longer than expected — please check back shortly.';
        errorBox.style.display = 'block';
      }
    }, 2000);
  }
})();
</script>
{% endblock %}
