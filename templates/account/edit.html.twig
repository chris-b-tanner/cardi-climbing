{% extends 'base.html.twig' %}

{% block title %}My Account — Y Wal{% endblock %}

{% block head %}
<style>
  .account-page { padding: 7rem 1rem 5rem; }
  .account-wrap { max-width: 560px; margin: 0 auto; }
  .account-wrap h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
  .account-wrap .subtitle { color: var(--muted, #6b7280); font-size: 0.9rem; margin-bottom: 2rem; }

  .account-card {
    background: #fff; border: 1px solid #e5e7eb;
    border-radius: 10px; padding: 1.5rem; margin-bottom: 1.25rem;
  }
  .account-card__title {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #6b7280; margin-bottom: 1rem;
  }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }

  .field { margin-bottom: 1rem; }
  .account-card > .field:last-child { margin-bottom: 0; }
  .field label {
    display: block; font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    color: #6b7280; margin-bottom: 0.35rem;
  }
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="tel"],
  .field input[type="date"] {
    width: 100%; padding: 0.6rem 0.75rem;
    border: 1px solid #e5e7eb; border-radius: 6px;
    font-size: 0.9375rem; font-family: inherit; color: #1a1a1a;
  }
  .field input:focus { outline: 2px solid #2a9d8f; outline-offset: 1px; border-color: transparent; }

  label.optin-label {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; color: #1a1a1a; cursor: pointer;
  }
  .optin-label input { width: 1rem; height: 1rem; accent-color: #2a9d8f; }

  .account-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .account-actions .btn { padding: 0.6rem 1.4rem; }

  .alert--success {
    background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }
  .alert--error {
    background: #fee2e2; color: #dc2626; border: 1px solid #fecaca;
    border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.875rem;
  }

  .reset-link { font-size: 0.875rem; color: #6b7280; }
  .reset-link a { color: #2a9d8f; }

  .avatar-card { display: flex; align-items: center; gap: 1.25rem; }
  .avatar-card__photo { position: relative; flex-shrink: 0; width: 72px; height: 72px; }
  .avatar-card__img, .avatar-card__initial {
    width: 72px; height: 72px; border-radius: 50%; object-fit: cover;
    background: #eef2f1; display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; font-weight: 700; color: #2a9d8f;
  }
  .avatar-card__edit-btn {
    position: absolute; bottom: -2px; right: -2px;
    width: 28px; height: 28px; border-radius: 50%;
    background: #2a9d8f; color: #fff; border: 2px solid #fff;
    display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  .avatar-card__edit-btn:hover { background: #1f7a6f; }
  .avatar-card__remove-link {
    border: none; background: none; padding: 0; margin-top: 0.4rem;
    font: inherit; font-size: 0.8rem; color: #dc2626; text-decoration: underline; cursor: pointer;
  }

  /* ── Tabs ─────────────────────────────────────────── */
  .account-tabs {
    display: flex; gap: 0.25rem; margin-bottom: 1.5rem;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    border-bottom: 1px solid #e5e7eb;
  }
  .account-tab {
    flex-shrink: 0; appearance: none;
    padding: 0.7rem 0.9rem;
    font-family: inherit; font-size: 0.85rem; font-weight: 600; color: #6b7280;
    background: none; border: none; border-bottom: 2px solid transparent;
    cursor: pointer; white-space: nowrap;
  }
  .account-tab:hover { color: #1a1a1a; }
  .account-tab.is-active { color: #1a1a1a; border-bottom-color: #2a9d8f; }
  .account-panel[hidden] { display: none; }
  .account-empty {
    background: #fff; border: 1px dashed #e5e7eb; border-radius: 10px;
    padding: 1.75rem 1.25rem; text-align: center; color: #6b7280; font-size: 0.875rem;
  }

  /* ── Status pill ──────────────────────────────────── */
  .status-pill {
    display: inline-block; font-size: 0.66rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.18rem 0.5rem; border-radius: 4px;
    background: #f3f4f6; color: #6b7280; flex-shrink: 0;
    white-space: nowrap;
  }
  .status-pill--confirmed { background: #dcfce7; color: #15803d; }
  .status-pill--cancelled { background: #fee2e2; color: #dc2626; }
  .status-pill--pending   { background: #fef9c3; color: #854d0e; }

  /* ── Booking / certification cards ───────────────────── */
  .item-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 10px;
    padding: 1.1rem 1.25rem; margin-bottom: 0.85rem;
  }
  .item-card__top {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 0.75rem; margin-bottom: 0.4rem;
  }
  .item-card__title { font-weight: 600; font-size: 0.95rem; color: #1a1a1a; }
  .item-card__meta { font-size: 0.82rem; color: #6b7280; line-height: 1.6; }
  .item-card__actions { margin-top: 0.75rem; }
  .item-card__cancel-btn {
    background: none; border: none; padding: 0;
    font-family: inherit; font-size: 0.8rem; font-weight: 600; color: #6b7280;
    text-decoration: underline; text-underline-offset: 2px; cursor: pointer;
  }
  .item-card__cancel-btn:hover { color: #dc2626; }
  .item-card__view-link {
    font-size: 0.8rem; font-weight: 600; color: #2a9d8f; text-decoration: none;
  }
  .item-card__view-link:hover { text-decoration: underline; }

  .account-donate-link { text-align: center; margin-top: 2rem; }
  .account-donate-link a { color: #2a9d8f; font-weight: 600; font-size: 0.9375rem; text-decoration: none; }
  .account-donate-link a:hover { text-decoration: underline; }
</style>
{% endblock %}

{% block content %}
<div class="account-page">
  <div class="account-wrap">
    <h1>My Account</h1>

    {% for msg in app.flashes('success') %}
      <div class="alert--success">{{ msg }}</div>
    {% endfor %}

    {% if error %}
      <div class="alert--error">{{ error }}</div>
    {% endif %}

    <div class="account-tabs" role="tablist">
      <button type="button" class="account-tab is-active" data-tab="info" role="tab" aria-selected="true">Personal info</button>
      <button type="button" class="account-tab" data-tab="bookings" role="tab" aria-selected="false">Bookings</button>
      <button type="button" class="account-tab" data-tab="certifications" role="tab" aria-selected="false">Certifications</button>
    </div>

    <section class="account-panel" data-panel="info">
      <div class="account-card avatar-card">
        <div class="avatar-card__photo">
          {% if avatarUrl %}
            <img src="{{ avatarUrl }}" alt="" class="avatar-card__img">
          {% else %}
            <span class="avatar-card__initial">{{ (user.firstName ?: user.email)|slice(0, 1)|upper }}</span>
          {% endif %}
          <button type="button" class="avatar-card__edit-btn" id="avatar-edit-btn" title="Change photo" aria-label="Change photo">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
          </button>
        </div>
        <div>
          <div style="font-weight:600;color:#1a1a1a;">{{ user.displayName ?: user.email }}</div>
          <p style="font-size:0.8rem;color:#6b7280;margin-top:0.2rem;">JPEG, PNG, WebP, or GIF — up to 5MB.</p>
          <form method="post" action="{{ path('app_account_avatar_upload') }}" enctype="multipart/form-data" id="avatar-upload-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_avatar') }}">
            <input type="hidden" name="returnTo" value="{{ path('app_account', {_fragment: 'info'}) }}">
            <input type="file" name="avatar" id="avatar-file-input" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none;">
          </form>
          {% if avatarUrl %}
            <form method="post" action="{{ path('app_account_avatar_remove') }}" style="display:inline;">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_avatar') }}">
              <input type="hidden" name="returnTo" value="{{ path('app_account', {_fragment: 'info'}) }}">
              <button type="submit" class="avatar-card__remove-link">Remove photo</button>
            </form>
          {% endif %}
        </div>
      </div>

      <form method="post" action="{{ path('app_account') }}" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_edit') }}">
        <input type="hidden" name="returnTo" value="{{ path('app_account', {_fragment: 'info'}) }}">

        {% include 'account/_profile_fields.html.twig' with {user: user} %}

        {% if publicTags is not empty %}
        <div class="account-card">
          <div class="account-card__title">Communication preferences</div>
          <p style="font-size:0.85rem;color:#6b7280;margin-bottom:1rem;">
            Choose which updates you'd like to receive. Requires "Keep me updated about Y Wal news" (above) to be ticked.
          </p>
          {% for tag in publicTags %}
            <div class="field" style="{% if loop.last %}margin-bottom:0;{% endif %}">
              <label class="optin-label" style="align-items:flex-start;">
                <input type="checkbox" name="tags[]" value="{{ tag.id }}"{% if user.hasTag(tag) %} checked{% endif %} style="margin-top:0.15rem;">
                <span>
                  <span style="display:block;">{{ tag.name }}</span>
                  {% if tag.description %}
                    <span style="display:block;font-size:0.8rem;color:#6b7280;font-weight:normal;margin-top:0.1rem;">{{ tag.description }}</span>
                  {% endif %}
                </span>
              </label>
            </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if user.dependents is not empty %}
        <div class="account-card">
          <div class="account-card__title">Dependents</div>
          <div class="field" style="margin-bottom:0;">
            {% for dependent in user.dependents %}
              <div style="font-size:0.9375rem;color:#1a1a1a;{% if not loop.last %}margin-bottom:0.4rem;{% endif %}">
                {{ dependent.displayName }}
              </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <div class="account-actions">
          <button type="submit" class="btn btn--teal">Save changes</button>
          <span class="reset-link">
            Need to change your password?
            <a href="{{ path('app_forgot_password_request') }}">Reset it here</a>
          </span>
        </div>
      </form>
    </section>

    <section class="account-panel" data-panel="bookings" hidden>
      {% if attendees is empty %}
        <div class="account-empty">You haven't booked onto any events yet.</div>
      {% else %}
        {% for attendee in attendees %}
          {% set event = attendee.event %}
          {% set effectiveDate = attendee.occurrenceDate ?? event.date %}
          <div class="item-card">
            <div class="item-card__top">
              <div class="item-card__title">{{ event.title }}</div>
              <span class="status-pill status-pill--{{ attendee.status }}">{{ attendee.status|capitalize }}</span>
            </div>
            <div class="item-card__meta">
              {{ effectiveDate|date('D j M Y') }} &middot; {{ event.timeFrom }}&ndash;{{ event.timeTo }}<br>
              {{ event.location }}
              {% if attendee.isStaffing %}
                <br>Staffing ({{ attendee.staffingRequirement.certification.name }}): {{ attendee.staffingStatusLabel }}
              {% endif %}
              {% if event.isSelfAccess and attendee.pin and attendee.status != 'cancelled' %}
                <br>Door PIN: <strong style="font-family:monospace;letter-spacing:0.1em;">{{ attendee.pin }}</strong>
              {% endif %}
            </div>
            {% if attendee.status != 'cancelled' and effectiveDate >= today %}
              <form method="post" action="{{ path('app_event_cancel', {id: event.id}) }}" class="item-card__actions">
                <input type="hidden" name="occurrenceDate" value="{{ effectiveDate|date('Y-m-d') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('cancel_event_' ~ event.id) }}">
                <button type="submit" class="item-card__cancel-btn">Cancel booking</button>
              </form>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </section>

    {% macro cert_card(record) %}
      {% set pillClass = record.status == 'completed' ? 'status-pill--confirmed' : (record.status == 'cancelled' ? 'status-pill--cancelled' : 'status-pill--pending') %}
      <div class="item-card">
        <div class="item-card__top">
          <div class="item-card__title">{{ record.certification.name }}</div>
          <span class="status-pill {{ pillClass }}">{{ record.statusLabel }}</span>
        </div>
        <div class="item-card__meta">
          Started {{ record.startedAt|date('d M Y') }}
          {% if record.submitted %}&middot; Submitted {{ record.completedAt|date('d M Y') }}{% endif %}
        </div>
        <div class="item-card__actions">
          {% if record.status == 'in_progress' %}
            <a href="{{ path('app_account_certification_complete', {recordId: record.id}) }}" class="btn btn--teal btn--sm">Complete now</a>
          {% else %}
            <a href="{{ path('app_account_certification_view', {recordId: record.id}) }}" class="item-card__view-link">View details</a>
          {% endif %}
        </div>
      </div>
    {% endmacro %}

    {% set dependentsWithCerts = user.dependents|filter(d => d.certifications is not empty) %}

    <section class="account-panel" data-panel="certifications" hidden>
      {% if user.certifications is empty and dependentsWithCerts is empty %}
        <div class="account-empty">
          <p>You don't have any certifications on record yet.</p>
          <p>Certifications allow you to book onto certain events, such as self-access bouldering out of hours.</p>
        </div>
      {% else %}
        {% for record in user.certifications %}
          {{ _self.cert_card(record) }}
        {% endfor %}

        {% for dependent in dependentsWithCerts %}
          <div class="account-panel__subheading" style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:#6b7280;margin:1.75rem 0 0.75rem;">
            {{ (dependent.firstName ~ ' ' ~ dependent.lastName)|trim ?: dependent.email ?: 'Dependent' }}
          </div>
          {% for record in dependent.certifications %}
            {{ _self.cert_card(record) }}
          {% endfor %}
        {% endfor %}
      {% endif %}
    </section>

{#    <div class="account-donate-link">#}
{#      <a href="{{ path('app_donate') }}">Make a donation →</a>#}
{#    </div>#}
  </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
  const avatarEditBtn   = document.getElementById('avatar-edit-btn');
  const avatarFileInput = document.getElementById('avatar-file-input');
  const avatarForm      = document.getElementById('avatar-upload-form');

  if (avatarEditBtn) {
    avatarEditBtn.addEventListener('click', () => avatarFileInput.click());
    avatarFileInput.addEventListener('change', () => {
      if (avatarFileInput.files.length > 0) avatarForm.submit();
    });
  }

  const accountTabs   = document.querySelectorAll('.account-tab');
  const accountPanels = document.querySelectorAll('.account-panel');

  function activateTab(name) {
    const tab = [...accountTabs].find(t => t.dataset.tab === name);
    if (!tab) return;

    accountTabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
    tab.classList.add('is-active');
    tab.setAttribute('aria-selected', 'true');

    accountPanels.forEach(panel => {
      panel.hidden = panel.dataset.panel !== name;
    });
  }

  accountTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      activateTab(tab.dataset.tab);
      history.replaceState(null, '', `#${tab.dataset.tab}`);
    });
  });

  const initialTab = window.location.hash.replace('#', '');
  if (initialTab) activateTab(initialTab);
</script>
{% endblock %}
