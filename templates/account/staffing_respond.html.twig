{% extends 'base.html.twig' %}

{% block title %}Staffing request — Y Wal{% endblock %}

{% block head %}
<style>
  .account-page { padding: 7rem 1rem 5rem; }
  .account-wrap { max-width: 560px; margin: 0 auto; }
  .account-wrap h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.4rem; }

  .account-card {
    background: #fff; border: 1px solid #e5e7eb;
    border-radius: 10px; padding: 1.5rem; margin-bottom: 1.25rem;
  }
  .account-card__title {
    font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: #6b7280; margin-bottom: 1rem;
  }

  .status-pill {
    display: inline-block; font-size: 0.66rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.18rem 0.5rem; border-radius: 4px;
    background: #f3f4f6; color: #6b7280; flex-shrink: 0; white-space: nowrap;
  }
  .status-pill--confirmed { background: #dcfce7; color: #15803d; }
  .status-pill--pending   { background: #fef9c3; color: #854d0e; }
  .status-pill--cancelled { background: #fee2e2; color: #dc2626; }

  .meta-row {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.6rem 0; border-bottom: 1px solid #f3f4f6; font-size: 0.875rem;
  }
  .meta-row:last-child { border-bottom: none; }
  .meta-row .meta-label { color: #6b7280; }
  .meta-row .meta-value { color: #1a1a1a; font-weight: 600; text-align: right; }

  .staffing-response-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .staffing-btn {
    flex: 1 1 auto; min-width: 140px; text-align: center; padding: 0.75rem 1rem;
    border-radius: 8px; font-weight: 600; font-size: 0.9rem; cursor: pointer; border: 2px solid transparent;
  }
  .staffing-btn--confirm { background: #1e4f41; color: #fff; }
  .staffing-btn--confirm:hover { background: #163a30; }
  .staffing-btn--decline { background: #fff; color: #6b7280; border-color: #e5e7eb; }
  .staffing-btn--decline:hover { border-color: #d1d5db; color: #374151; }
</style>
{% endblock %}

{% block content %}
<div class="account-page">
  <div class="account-wrap">
    <a href="{{ path('app_account') }}" style="font-size:0.85rem;color:#6b7280;display:inline-block;margin-bottom:1rem;">&larr; My account</a>

    {% set pillClass = attendee.isStaffingApproved ? 'status-pill--confirmed' : (attendee.staffingStatus == 'declined' ? 'status-pill--cancelled' : 'status-pill--pending') %}
    <h1>Staffing request</h1>
    <p style="margin-bottom:1.5rem;">
      <span class="status-pill {{ pillClass }}">{{ attendee.staffingStatusLabel }}</span>
    </p>

    <div class="account-card">
      <div class="account-card__title">Session details</div>
      <div class="meta-row">
        <span class="meta-label">Event</span>
        <span class="meta-value">{{ attendee.event.title }}</span>
      </div>
      {% if attendee.occurrenceDate %}
        <div class="meta-row">
          <span class="meta-label">Date</span>
          <span class="meta-value">{{ attendee.occurrenceDate|date('l j F Y') }}</span>
        </div>
      {% endif %}
      <div class="meta-row">
        <span class="meta-label">Time</span>
        <span class="meta-value">{{ attendee.event.timeFrom }}&ndash;{{ attendee.event.timeTo }}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Location</span>
        <span class="meta-value">{{ attendee.event.location }}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Role</span>
        <span class="meta-value">{{ attendee.staffingRequirement.certification.name }}</span>
      </div>
    </div>

    {% if attendee.isStaffingPending %}
      <div class="account-card">
        <div class="account-card__title">Your response</div>
        <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0 0 1rem;">
          We'd like you to staff this session. Please confirm you're available, or decline if you're not.
        </p>
        <div class="staffing-response-actions">
          <form method="post" style="flex:1 1 auto;margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_staffing_' ~ attendee.id) }}">
            <input type="hidden" name="action" value="confirm">
            <button type="submit" class="staffing-btn staffing-btn--confirm" style="width:100%;">Confirm</button>
          </form>
          <form method="post" style="flex:1 1 auto;margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_staffing_' ~ attendee.id) }}">
            <input type="hidden" name="action" value="decline">
            <button type="submit" class="staffing-btn staffing-btn--decline" style="width:100%;">Decline</button>
          </form>
        </div>
      </div>
    {% elseif attendee.isStaffingApproved %}
      <div class="account-card">
        <div class="account-card__title">Thanks</div>
        <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">
          You're confirmed to staff this session. See you there!
        </p>
      </div>
    {% else %}
      <div class="account-card">
        <div class="account-card__title">Declined</div>
        <p style="font-size:0.9rem;color:#374151;line-height:1.6;margin:0;">
          You've let us know you can't make this one. Thanks for responding.
        </p>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
