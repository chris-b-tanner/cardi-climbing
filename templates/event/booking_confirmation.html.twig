{% extends 'base.html.twig' %}

{% block title %}Booking confirmed — Y Wal{% endblock %}

{% block content %}
{% set event = attendee.event %}
{% set effectiveDate = attendee.occurrenceDate ?? event.date %}

<section class="section page-hero">
  <div class="wrap">
    <span class="eyebrow">Booking confirmed</span>
    <h1 class="page-hero__h1">You're booked!</h1>
  </div>
</section>

<section class="section section--off">
  <div class="wrap booking-confirm__wrap">
    <div class="booking-confirm-card">
      <h2 class="booking-confirm-card__title">{{ event.title }}</h2>
      <div class="booking-confirm-card__meta">
        {{ effectiveDate|date('l j F Y') }} &middot; {{ event.timeFrom }}&ndash;{{ event.timeTo }}<br>
        {{ event.location }}
      </div>
    </div>

    <p>We've sent a confirmation email to <strong>{{ attendee.user.email }}</strong> with all the details.</p>

    <div class="booking-confirm-actions">
      <a href="{{ path('app_account') }}#bookings" class="btn btn--teal">View my bookings</a>
      <a href="{{ path('app_events') }}" class="btn btn--outline">Browse more events</a>
    </div>
  </div>
</section>
{% endblock %}
