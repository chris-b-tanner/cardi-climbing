{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} — Y Wal{% endblock %}

{% block content %}
<section class="section page-hero">
  <div class="wrap">
    <a href="{{ path('app_events') }}" class="event-show__back">&larr; {{ 'events_back_to_calendar'|trans }}</a>
    <h1 class="page-hero__h1">
      {{ event.title }}
      {% if not event.isPublished %}<span class="agenda-event__status">Draft</span>{% endif %}
    </h1>
  </div>
</section>

<section class="section section--off">
  <div class="wrap event-show__wrap">

    <div class="event-show__meta">
      <span class="event-show__meta-item">
        <svg class="event-show__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        {{ date|date('d M Y') }}
      </span>
      <span class="event-show__meta-item">
        <svg class="event-show__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 14"></polyline></svg>
        {{ event.timeFrom }}&ndash;{{ event.timeTo }}
      </span>
      <span class="event-show__meta-item">
        <svg class="event-show__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
        {{ event.location }}
      </span>
      <span class="event-show__meta-item">
        <svg class="event-show__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L3 3v6.59a2 2 0 0 0 .59 1.41l9.59 9.59a2 2 0 0 0 2.82 0l4.59-4.59a2 2 0 0 0 0-2.82z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
        {{ event.price ? '£' ~ event.price : 'Free' }}
      </span>
      {% if spotsLeft is not null %}
        <span class="event-show__meta-item">
          <svg class="event-show__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          {% if spotsLeft > 0 %}
            {{ spotsLeft }} {{ spotsLeft == 1 ? 'events_place_left'|trans : 'events_places_left'|trans }}
          {% else %}
            {{ 'events_full'|trans }}
          {% endif %}
        </span>
      {% endif %}
      {% if event.restrictions is not empty %}
        <span class="event-show__meta-item agenda-event__restricted">
          <svg class="event-show__meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          {{ 'events_restricted_to'|trans }}
          {%- for restriction in event.restrictions %} {{ restriction.name }}{% if not loop.last %},{% endif %}{% endfor %}
        </span>
      {% endif %}
    </div>

    {% if event.isRecurring %}
      {% set dayNames = {1: 'Monday', 2: 'Tuesday', 3: 'Wednesday', 4: 'Thursday', 5: 'Friday', 6: 'Saturday', 7: 'Sunday'} %}
      <p class="event-show__recurring">
        {{ 'events_recurs_on'|trans }}
        {%- for d in event.recurDaysArray %} {{ dayNames[d] }}{% if not loop.last %},{% endif %}{% endfor -%}
        {% if event.recurUntil %} {{ 'events_recurs_until'|trans }} {{ event.recurUntil|date('d M Y') }}{% endif %}.
      </p>
    {% endif %}

    {% if event.description %}
      <div class="event-show__desc">{{ event.description|nl2br }}</div>
    {% endif %}

    {% if event.externalUrl %}
      <div class="agenda-event__details">
        <a href="{{ event.externalUrl }}" target="_blank" rel="noopener" class="agenda-event__signin">{{ 'events_view_details'|trans }}</a>
      </div>
    {% endif %}

    {% if isPast %}
      <p class="event-show__past">{{ 'events_event_passed'|trans }}</p>
    {% else %}
      {% if isBooked %}
        <div class="agenda-event__actions event-show__actions">
          <span class="agenda-event__status agenda-event__status--booked">{{ 'events_booked'|trans }}</span>
          <a href="{{ path('app_account') }}#bookings" class="agenda-event__signin">{{ 'events_manage_booking'|trans }}</a>
        </div>
      {% elseif isFull %}
        <div class="agenda-event__actions event-show__actions">
          <span class="agenda-event__status">{{ 'events_full'|trans }}</span>
        </div>
      {% elseif app.user is null %}
        {% if event.restrictions is not empty %}
          <div class="agenda-event__actions event-show__actions">
            <span class="agenda-event__status">{{ 'events_not_eligible'|trans }}</span>
            <a href="{{ path('app_login') }}" class="agenda-event__signin">{{ 'events_sign_in_to_book'|trans }}</a>
          </div>
        {% elseif accountConflict %}
          <div class="alert alert--error">
            {{ 'events_account_conflict'|trans }}
            <a href="{{ path('app_forgot_password_request') }}">{{ 'events_request_new_password'|trans }}</a>
            {{ 'events_account_conflict_or'|trans }}
            <a href="{{ path('app_login') }}">{{ 'events_account_conflict_signin'|trans }}</a>.
          </div>
        {% else %}
          <div class="event-show__guest-booking">
            <h3 class="event-show__guest-booking-title">{{ 'events_guest_booking_title'|trans }}</h3>

            <form method="post" action="{{ path('app_event_book_guest', {id: event.id}) }}" class="event-show__guest-form">
              <input type="hidden" name="occurrenceDate" value="{{ date|date('Y-m-d') }}">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('book_guest_event_' ~ event.id) }}">

              <div class="event-show__name-row">
                <div class="form-group">
                  <label for="guestFirstName">{{ 'events_first_name'|trans }}</label>
                  <input type="text" id="guestFirstName" name="firstName" class="form-control" autocomplete="given-name" required>
                </div>
                <div class="form-group">
                  <label for="guestLastName">{{ 'events_last_name'|trans }}</label>
                  <input type="text" id="guestLastName" name="lastName" class="form-control" autocomplete="family-name" required>
                </div>
              </div>

              <div class="form-group">
                <label for="guestEmail">{{ 'events_email'|trans }}</label>
                <input type="email" id="guestEmail" name="email" class="form-control" autocomplete="email" required>
              </div>

              <div class="form-group">
                <label for="guestPassword">{{ 'events_password'|trans }}</label>
                <input type="password" id="guestPassword" name="password" class="form-control" autocomplete="new-password" minlength="8" required>
                <p class="event-show__guest-hint">{{ 'events_password_hint'|trans }}</p>
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label class="event-show__optin-label">
                  <input type="checkbox" name="optIn" value="1">
                  {{ 'events_subscribe_news'|trans }}
                </label>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn btn--teal">{{ 'events_book'|trans }}</button>
              </div>
            </form>
          </div>
        {% endif %}
      {% elseif isRestricted %}
        <div class="agenda-event__actions event-show__actions">
          <span class="agenda-event__status">{{ 'events_not_eligible'|trans }}</span>
        </div>
      {% elseif canBook %}
        <div class="agenda-event__actions event-show__actions">
          <form method="post" action="{{ path('app_event_book', {id: event.id}) }}" class="agenda-event__form">
            <input type="hidden" name="occurrenceDate" value="{{ date|date('Y-m-d') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('book_event_' ~ event.id) }}">
            {% if eligibleStaffingRequirements is not empty %}
              <div class="form-group">
                <label for="staffingRequirementId">{{ 'events_volunteer_label'|trans }}</label>
                <select id="staffingRequirementId" name="staffingRequirementId" class="form-control">
                  <option value="">{{ 'events_volunteer_none'|trans }}</option>
                  {% for requirement in eligibleStaffingRequirements %}
                    <option value="{{ requirement.id }}">{{ requirement.certification.name }}</option>
                  {% endfor %}
                </select>
              </div>
            {% endif %}
            <button type="submit" class="btn btn--teal">{{ 'events_book'|trans }}</button>
          </form>
        </div>
      {% endif %}
    {% endif %}

  </div>
</section>
{% endblock %}
