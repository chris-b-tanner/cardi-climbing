{% extends 'base.html.twig' %}

{% block title %}{{ 'events_meta_title'|trans }}{% endblock %}

{% block content %}
<section class="section page-hero">
  <div class="wrap">
    <h1 class="page-hero__h1">{{ 'events_h1'|trans }}</h1>
  </div>
</section>

<section class="section section--off">
  <div class="wrap">
    <form method="get" action="{{ path('app_events') }}" class="calendar-search" role="search">
      <input type="search" name="q" value="{{ searchQuery }}" class="calendar-search__input"
             placeholder="{{ 'events_search_placeholder'|trans }}" aria-label="{{ 'events_search_placeholder'|trans }}">
      <button type="submit" class="btn btn--outline btn--sm">{{ 'events_search'|trans }}</button>
      {% if searchQuery %}
        <a href="{{ path('app_events', {date: weekStart|date('Y-m-d')}) }}" class="calendar-search__clear">{{ 'events_search_clear'|trans }}</a>
      {% endif %}
    </form>

    <nav class="calendar-nav" aria-label="Week">
      <a href="{{ path('app_events', searchQuery ? {date: prevWeek, q: searchQuery} : {date: prevWeek}) }}" class="calendar-nav__link" aria-label="{{ 'events_prev_week'|trans }}">&lsaquo;</a>
      <h2 class="calendar-nav__title">
        <span class="calendar-nav__title-full">{{ weekStart|date('j M') }}&ndash;{{ weekEnd|date('j M Y') }}</span>
        <span class="calendar-nav__title-short">{{ weekStart|date('j M') }}&ndash;{{ weekEnd|date('j M') }}</span>
      </h2>
      <a href="{{ path('app_events', searchQuery ? {date: nextWeek, q: searchQuery} : {date: nextWeek}) }}" class="calendar-nav__link" aria-label="{{ 'events_next_week'|trans }}">&rsaquo;</a>
      <input type="date" id="week-date-picker" class="calendar-nav__datepicker"
             value="{{ weekStart|date('Y-m-d') }}" aria-label="{{ 'events_jump_to_date'|trans }}">
    </nav>

    <div class="week-day-tabs" id="week-day-tabs" role="tablist" aria-label="{{ 'events_h1'|trans }}">
      {% for day in days %}
        <button type="button" class="week-day-tab" data-day="{{ day.date|date('Y-m-d') }}" role="tab">
          <span class="week-day-tab__weekday">{{ day.date|date('D') }}</span>
          <span class="week-day-tab__daynum">{{ day.date|date('j') }}</span>
        </button>
      {% endfor %}
    </div>

    <div class="week-view" id="week-view">
      {% for day in days %}
        {% set dateKey = day.date|date('Y-m-d') %}
        {% set isToday = dateKey == today|date('Y-m-d') %}
        <div class="week-day{{ isToday ? ' week-day--today' : '' }}" data-day="{{ dateKey }}">
          <div class="week-day__header">
            <span class="week-day__weekday">{{ day.date|date('D') }}</span>
            <span class="week-day__daynum">{{ day.date|date('j') }}</span>
            <span class="week-day__month">{{ day.date|date('M') }}</span>
          </div>
          <div class="week-day__events">
            {% if day.events is empty %}
              <p class="week-day__empty">{{ searchQuery ? 'events_search_empty'|trans : 'events_empty'|trans }}</p>
            {% else %}
              {% for occ in day.events %}
                {% set event = occ.event %}
                <div class="agenda-event">
                  <div class="agenda-event__time">{{ event.timeFrom }}&ndash;{{ event.timeTo }}</div>
                  <div class="agenda-event__body">
                    <h3 class="agenda-event__title{{ occ.isDraft ? ' agenda-event__title--draft' : '' }}">
                      {{ event.title }}
                    </h3>
                    <div class="agenda-event__meta">
                      {% if occ.spotsLeft is not null %}
                        <span>
                          {% if occ.spotsLeft > 0 %}
                            {{ occ.spotsLeft }} {{ occ.spotsLeft == 1 ? 'events_place_left'|trans : 'events_places_left'|trans }}
                          {% else %}
                            {{ 'events_full'|trans }}
                          {% endif %}
                        </span>
                      {% endif %}
                      {% if occ.isBooked %}
                        <span class="agenda-event__status agenda-event__status--booked">{{ 'events_booked'|trans }}</span>
                      {% endif %}
                      {% if event.restrictions is not empty %}
                        <span class="agenda-event__restricted">
                          {%- for restriction in event.restrictions %}{{ restriction.name }}{% if not loop.last %}, {% endif %}{% endfor %}
                        </span>
                      {% endif %}
                    </div>
                    <a href="{{ path('app_event_show', {id: event.id, date: occ.date|date('Y-m-d')}) }}"
                       class="btn btn--outline btn--sm agenda-event__cta"
                       data-preview-url="{{ path('app_event_preview', {id: event.id, date: occ.date|date('Y-m-d')}) }}">
                      {{ 'events_view'|trans }}
                    </a>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<div id="event-preview-modal" class="event-preview-modal" style="display:none;" aria-hidden="true">
  <div id="event-preview-backdrop" class="event-preview-modal__backdrop"></div>
  <div class="event-preview-modal__box" role="dialog" aria-modal="true">
    <button type="button" id="event-preview-close" class="event-preview-modal__close" aria-label="{{ 'events_close'|trans }}">&times;</button>
    <div id="event-preview-body" class="event-preview-modal__body"></div>
  </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
  document.getElementById('week-date-picker').addEventListener('change', function () {
    if (!this.value) return;
    const searchQuery = {{ searchQuery|json_encode|raw }};
    const params = new URLSearchParams({ date: this.value });
    if (searchQuery) params.set('q', searchQuery);
    window.location.href = '{{ path('app_events') }}?' + params.toString();
  });

  // Mobile: the week is still rendered in full, but only one day column is shown at a time,
  // switched via the tabs above it — avoids a second request just to look at another day.
  const dayTabs  = document.querySelectorAll('.week-day-tab');
  const weekDays = document.querySelectorAll('.week-day');

  function showDay(dateKey) {
    weekDays.forEach(el => el.classList.toggle('is-active-mobile', el.dataset.day === dateKey));
    dayTabs.forEach(tab => tab.classList.toggle('is-active', tab.dataset.day === dateKey));
  }

  dayTabs.forEach(tab => tab.addEventListener('click', () => showDay(tab.dataset.day)));

  const todayKey   = {{ today|date('Y-m-d')|json_encode|raw }};
  const dayKeys    = [...dayTabs].map(tab => tab.dataset.day);
  const initialDay = dayKeys.includes(todayKey) ? todayKey : dayKeys[0];
  if (initialDay) showDay(initialDay);

  // ── Event preview modal — progressive enhancement over the plain link to the full event page ──
  const previewModal   = document.getElementById('event-preview-modal');
  const previewBackdrop = document.getElementById('event-preview-backdrop');
  const previewClose    = document.getElementById('event-preview-close');
  const previewBody     = document.getElementById('event-preview-body');

  let currentPreviewUrl = null;

  function openPreview(url) {
    currentPreviewUrl = url;
    previewBody.innerHTML = '';
    previewModal.style.display = 'flex';
    previewModal.setAttribute('aria-hidden', 'false');

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(r => r.text())
      .then(html => { previewBody.innerHTML = html; });
  }

  function closePreview() {
    previewModal.style.display = 'none';
    previewModal.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll('.agenda-event__cta[data-preview-url]').forEach(link => {
    link.addEventListener('click', (e) => {
      // Let a modifier-click or non-primary button open the full page normally (new tab, etc.).
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      e.preventDefault();
      openPreview(link.dataset.previewUrl);
    });
  });

  previewClose.addEventListener('click', closePreview);
  previewBackdrop.addEventListener('click', closePreview);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePreview();
  });

  // ── "Add to cart" forms inside the modal — delegated since its content is swapped in via fetch ──
  previewBody.addEventListener('submit', (e) => {
    const form = e.target;
    if (!form.classList.contains('event-preview__ticket-form')) return;

    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalLabel = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Adding…';

    fetch(form.action, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: new FormData(form),
    })
      .then(r => r.json().then(data => ({ ok: r.ok, data })))
      .then(({ ok, data }) => {
        if (!ok) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
          alert(data.error || 'Could not add that to your cart.');
          return;
        }

        // Refresh the whole modal rather than just this form — that's what picks up the
        // "you have N in your cart" notice, which depends on the cart count as of right now.
        if (currentPreviewUrl) openPreview(currentPreviewUrl);
      });
  });
</script>
{% endblock %}
