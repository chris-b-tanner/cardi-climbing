{% extends 'base.html.twig' %}

{% block title %}Choose a new password — Cardigan Climbing{% endblock %}

{% block nav %}
<header class="auth-header">
  <div class="wrap">
    <a href="/" class="nav__logo">{{ 'nav_logo'|trans|raw }}</a>
  </div>
</header>
{% endblock %}

{% block content %}
<main class="login-page">
  <div class="login-card">
    <h1>New password</h1>
    <p style="color:var(--muted);font-size:0.875rem;margin:0.4rem 0 1.75rem;">
      Choose a strong password of at least 8 characters.
    </p>

    {% if error is defined and error %}
      <div class="alert alert--error">{{ error }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_reset_password', {token: token}) }}" novalidate>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset-password') }}">

      <div class="form-group">
        <label for="inputPassword">New password</label>
        <input type="password" id="inputPassword" name="password" class="form-control"
               autocomplete="new-password" autofocus required minlength="8">
      </div>

      <div class="form-group">
        <label for="inputPasswordConfirm">Confirm new password</label>
        <input type="password" id="inputPasswordConfirm" name="password_confirm" class="form-control"
               autocomplete="new-password" required minlength="8">
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn--teal">Set new password</button>
      </div>
    </form>
  </div>
</main>
{% endblock %}

{% block scripts %}{% endblock %}
